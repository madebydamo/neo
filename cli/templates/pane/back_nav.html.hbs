{{#if is_core}}
  <button class="btn btn-ghost btn-xs mb-2" hx-get="/core-grid" hx-target="#config-content" hx-swap="innerHTML">← Back to core grid</button>
{{else}}
  <button class="btn btn-ghost btn-xs mb-2" hx-get="/services-grid" hx-target="#config-content" hx-swap="innerHTML">← Back to services grid</button>
{{/if}}
