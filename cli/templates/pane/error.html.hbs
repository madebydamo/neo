{{#if error}}
  <div class="alert alert-error mb-4 text-sm flex flex-col gap-2">
    <div class="whitespace-pre-wrap">{{error}}</div>
    <div class="flex flex-wrap gap-2">
      {{> partials/eval_error_actions size="btn-sm" reload_size="btn-xs" repair_label="Repair Nix store" update_label="Update flake inputs" repair_confirm="Run sudo nix-store --verify --repair? Requires passwordless sudo for nix-store." update_confirm="Run flake update + template refresh? Use this when flake.lock points at unavailable path:/ or git+file: inputs."}}
    </div>
  </div>
{{/if}}
