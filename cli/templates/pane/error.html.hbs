{{#if error}}
  <div class="alert alert-error mb-4 text-sm flex flex-col gap-2">
    <div class="whitespace-pre-wrap">{{error}}</div>
    <div class="flex flex-wrap gap-2">
      {{#if can_store_repair}}
        <button type="button"
                class="btn btn-sm btn-warning"
                hx-post="/nix/repair" data-neo-lock="system"
                hx-target="#changes-body"
                hx-swap="innerHTML"
                hx-confirm="Run sudo nix-store --verify --repair? Requires passwordless sudo for nix-store."
                hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Nix store repair')">
          Repair Nix store
        </button>
      {{/if}}
      {{#if can_flake_update}}
        <button type="button"
                class="btn btn-sm btn-info"
                hx-post="/flake/update" data-neo-lock="system"
                hx-target="#changes-body"
                hx-swap="innerHTML"
                hx-confirm="Run flake update + template refresh? Use this when flake.lock points at unavailable path:/ or git+file: inputs."
                hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Update')">
          Update flake inputs
        </button>
      {{/if}}
      <button class="btn btn-xs btn-ghost" onclick="location.reload()">Reload</button>
    </div>
  </div>
{{/if}}
