{{!-- Option sections (built in Rust, nix/sections.rs): "General" is always open;
     ui.group sections collapse and show summary chips while closed. --}}
{{#if sections}}
  <div class="space-y-3 sm:space-y-4">
    {{#each sections}}
      {{#if collapsible}}
        <section class="rounded-box border border-base-300 bg-base-100 overflow-hidden transition-colors"
                 :class="isSectionOpen('{{id}}') ? 'shadow-sm' : 'hover:border-base-content/20'"
                 data-section="{{id}}"
                 x-data="{ names: [{{#each options}}'{{name}}'{{#unless @last}},{{/unless}}{{/each}}] }">
          <button type="button"
                  class="w-full flex items-start gap-3 p-3 sm:p-4 text-left cursor-pointer"
                  @click="toggleSection('{{id}}')"
                  :aria-expanded="isSectionOpen('{{id}}')"
                  aria-controls="section-body-{{id}}">
            <span class="mt-0.5 w-9 h-9 flex-shrink-0 rounded-xl bg-base-200 text-base-content/70 flex items-center justify-center">
              {{> options/group_icon icon=icon tint=icon_tint}}
            </span>
            <span class="flex-1 min-w-0">
              <span class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-sm sm:text-base">{{label}}</span>
                <span x-cloak x-show="names.some(n => !isAtOriginal(n))" class="badge badge-warning badge-xs">unsaved</span>
                <span x-cloak x-show="!names.some(n => !isAtOriginal(n)) && customizedCount(names) > 0"
                      class="badge badge-ghost badge-xs"
                      x-text="customizedCount(names) + ' customized'"></span>
              </span>
              {{#if description}}
                <span class="block text-xs text-base-content/60 mt-0.5 leading-snug">{{description}}</span>
              {{/if}}
              {{#if summary}}
                <span class="flex flex-wrap gap-1 mt-2" x-show="!isSectionOpen('{{id}}')">
                  {{#each summary}}
                    <span class="badge badge-sm h-auto min-h-5 py-0.5 text-left whitespace-normal break-words"
                          x-show="isFieldVisible('{{this}}')"
                          :class="summaryChip('{{this}}').cls"
                          x-text="summaryChip('{{this}}').text"></span>
                  {{/each}}
                </span>
              {{/if}}
            </span>
            <svg class="w-5 h-5 mt-2 flex-shrink-0 text-base-content/50 transition-transform duration-200"
                 :class="isSectionOpen('{{id}}') ? 'rotate-180' : ''"
                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
            </svg>
          </button>
          <div id="section-body-{{id}}" x-cloak x-show="isSectionOpen('{{id}}')"
               class="border-t border-base-300 px-3 sm:px-4 divide-y divide-base-300/70">
            {{#each options}}
              {{> options/field}}
            {{/each}}
          </div>
        </section>
      {{else}}
        <section class="rounded-box border border-base-300 bg-base-100 px-3 sm:px-4 divide-y divide-base-300/70" data-section="{{id}}">
          {{#each options}}
            {{> options/field}}
          {{/each}}
        </section>
      {{/if}}
    {{/each}}
  </div>
{{else}}
  <p class="text-base-content/60">No options found or service does not exist.</p>
{{/if}}
