{{#if options}}
  <div class="space-y-4">
    {{#each options}}
      {{> options/field}}
    {{/each}}
  </div>

  {{!-- End-of-form actions (sticky bar covers top while scrolling). --}}
  <div class="mt-4">
    {{> pane/save_actions}}
  </div>
{{else}}
  <p class="text-base-content/60">No options found or service does not exist.</p>
{{/if}}
