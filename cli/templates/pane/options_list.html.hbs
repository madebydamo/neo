{{#if options}}
  <div class="mb-4">
    {{> pane/save_actions}}
  </div>

  <div class="space-y-4">
    {{#each options}}
      {{> options/field}}
    {{/each}}
  </div>

  <div class="mt-4">
    {{> pane/save_actions}}
  </div>
{{else}}
  <p class="text-base-content/60">No options found or service does not exist.</p>
{{/if}}
