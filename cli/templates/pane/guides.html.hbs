{{!-- Guides that use this service (filled by the option route). --}}
{{#if guides}}
  <section class="mt-3" aria-label="Guides">
    <div class="flex items-center gap-2 mb-1.5">
      <span class="text-xs font-semibold uppercase tracking-wider text-base-content/55">Guides</span>
      <a href="/configuration/guides" hx-get="/configuration/guides" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
         class="text-xs link link-hover text-base-content/55">All guides</a>
    </div>
    <div class="flex gap-2 neo-scroll-x -mx-1 px-1 pb-1">
      {{#each guides}}
        <a href="/configuration/guides/{{id}}" hx-get="/configuration/guides/{{id}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
           class="shrink-0 max-w-[16rem] rounded-box border border-base-300 bg-base-100 px-3 py-2 no-underline hover:border-primary/50 transition-colors">
          <span class="block text-sm font-medium leading-snug truncate">{{title}}</span>
          {{#if minutes}}<span class="block text-[11px] text-base-content/55">{{minutes}} min · <span class="capitalize">{{difficulty}}</span></span>{{/if}}
        </a>
      {{/each}}
    </div>
  </section>
{{/if}}
