{{!-- Guides that use this service (filled by the option route); collapsed
     like "Good to know" in the header. --}}
{{#if guides}}
  <details class="mt-1.5" aria-label="Guides">
    <summary class="cursor-pointer select-none text-xs text-base-content/60 link link-hover w-fit">Guides ({{len guides}})</summary>
    <div class="mt-1.5 flex flex-wrap gap-2">
      {{#each guides}}
        <a href="/configuration/guides/{{id}}" hx-get="/configuration/guides/{{id}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
           class="min-w-0 max-w-full sm:max-w-[16rem] rounded-box border border-base-300 bg-base-100 px-3 py-2 no-underline hover:border-primary/50 transition-colors">
          <span class="block text-sm font-medium leading-snug truncate">{{title}}</span>
          {{#if minutes}}<span class="block text-[11px] text-base-content/55">{{minutes}} min · <span class="capitalize">{{difficulty}}</span></span>{{/if}}
        </a>
      {{/each}}
      <a href="/configuration/guides" hx-get="/configuration/guides" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
         class="self-center text-xs link link-hover text-base-content/55">All guides</a>
    </div>
  </details>
{{/if}}
