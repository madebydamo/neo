{{!-- Sticky Save/Discard strip: full card width (matches action bar); glass plate fuses blur when stuck. --}}
<div id="options-sticky-save"
     class="sticky z-20 w-full px-4 bg-base-100/60 backdrop-blur-xs border-b border-base-300/50 py-2 mb-0 flex flex-wrap items-center justify-between gap-2 transition-[background-color,box-shadow,border-color] duration-200"
     style="top: calc(var(--neo-sticky-bar-top, 1.5rem) + 4rem);">
  <div class="flex items-center gap-2 min-w-0">
    <span class="text-sm font-bold">options</span>
    <span x-cloak
          x-show="Object.keys(originals||{}).some(k => !isAtOriginal(k))"
          class="badge badge-warning badge-xs shrink-0">unsaved</span>
  </div>
  {{> pane/save_actions}}
</div>
