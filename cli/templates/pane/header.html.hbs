{{!-- Pane header: icon, name, live status, links and an overflow menu.
     Works with or without service meta (core sections have none). --}}
<div class="flex items-start gap-3 sm:gap-4">
  {{#if meta.icon}}
    <div class="w-11 h-11 sm:w-14 sm:h-14 flex-shrink-0 rounded-2xl bg-base-200 border border-base-300 p-1.5 sm:p-2 flex items-center justify-center">
      <img src="{{meta.icon}}" class="max-w-full max-h-full object-contain" alt=""
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
      <span class="hidden text-2xl leading-none opacity-60">⚙</span>
    </div>
  {{/if}}

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-x-2 gap-y-1 flex-wrap min-w-0">
      <h1 class="text-lg sm:text-2xl font-semibold tracking-tight font-mono truncate min-w-0">{{service}}</h1>
      {{#if units}}
        {{!-- Filled from live unit state by configuration.js (neoUnitSummary). --}}
        <button type="button" class="badge badge-sm badge-ghost gap-1.5 cursor-pointer"
                data-unit-summary
                @click="setPaneTab('status')"
                title="Show runtime status">
          <span class="neo-unit-dot" data-unit-summary-dot aria-hidden="true"></span>
          <span data-unit-summary-text>checking…</span>
        </button>
      {{/if}}
      {{#each plugins}}
        {{> partials/plugin_pill url=url display=display size="badge-sm" extraClass="plugin-pill--header"}}
      {{/each}}
      {{#if assistant}}{{#unless is_core}}
        <button type="button" class="btn btn-xs btn-soft btn-primary gap-1 ml-auto"
                data-neo-agent="service:{{service}}" data-neo-agent-title="Help with {{service}}"
                data-neo-agent-hint="Ask anything about {{service}}: what a setting does, why it does not work, or how to set it up.">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 015.5 4h13A1.5 1.5 0 0120 5.5v9a1.5 1.5 0 01-1.5 1.5H10l-4 4v-4H5.5A1.5 1.5 0 014 14.5z"/></svg>
          Ask for help
        </button>
      {{/unless}}{{/if}}
    </div>

    {{#if meta.tagline}}
      <p class="mt-0.5 text-sm sm:text-base font-medium text-base-content/85">{{meta.tagline}}</p>
    {{/if}}

    {{#if meta.description}}
      <div x-data="{ open: false, long: false }"
           x-init="$nextTick(() => { long = $refs.desc.scrollHeight > $refs.desc.clientHeight + 2 })"
           class="mt-1">
        <p x-ref="desc"
           class="text-sm leading-relaxed text-base-content/70 whitespace-pre-line"
           :class="open ? '' : 'line-clamp-3'">{{meta.description}}</p>
        <button type="button" x-cloak x-show="long || open"
                class="link link-hover text-xs text-base-content/60 mt-0.5"
                @click="open = !open"
                x-text="open ? 'Show less' : 'Show more'"></button>
      </div>
    {{/if}}

    {{#if meta.replaces}}
      <div class="mt-1.5 flex flex-wrap items-center gap-1 text-xs text-base-content/60">
        <span>Instead of</span>
        {{#each meta.replaces}}
          <span class="badge badge-sm badge-ghost">{{this}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{#if meta.notes}}
      <details class="mt-2 group/notes">
        <summary class="cursor-pointer select-none text-xs text-base-content/60 link link-hover w-fit">Good to know</summary>
        <p class="mt-1 text-xs leading-relaxed text-base-content/70 whitespace-pre-line">{{meta.notes}}</p>
      </details>
    {{/if}}

    {{> pane/guides}}

    {{#if (or meta.projectUrl meta.githubUrl meta.releaseUrl)}}
      <div class="mt-2 flex flex-wrap gap-1.5">
        {{#if meta.projectUrl}}
          <a href="{{meta.projectUrl}}" target="_blank" rel="noopener" class="btn btn-xs btn-soft no-underline">Website ↗</a>
        {{/if}}
        {{#if meta.githubUrl}}
          <a href="{{meta.githubUrl}}" target="_blank" rel="noopener" class="btn btn-xs btn-soft no-underline">Source ↗</a>
        {{/if}}
        {{#if meta.releaseUrl}}
          <a href="{{meta.releaseUrl}}" target="_blank" rel="noopener" class="btn btn-xs btn-soft no-underline">Releases ↗</a>
        {{/if}}
      </div>
    {{/if}}

    {{#if meta.screenshots}}
      <div class="mt-3 flex gap-2 overflow-x-auto pb-1 -mx-1 px-1">
        {{#each meta.screenshots}}
          <a href="{{url}}" target="_blank" rel="noopener" class="block flex-shrink-0 group">
            <img src="{{url}}" alt="{{#if caption}}{{caption}}{{else}}{{../service}} screenshot{{/if}}"
                 class="h-20 w-auto max-w-[180px] rounded-lg border border-base-300 group-hover:border-primary transition-colors object-cover bg-base-200">
            {{#if caption}}
              <div class="text-[10px] text-center opacity-60 mt-0.5 max-w-[180px] truncate">{{caption}}</div>
            {{/if}}
          </a>
        {{/each}}
      </div>
    {{/if}}
  </div>

  {{#if options}}
    <div class="dropdown dropdown-end flex-shrink-0">
      <button type="button" tabindex="0" class="btn btn-ghost btn-sm btn-square" aria-label="More actions" title="More actions">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><circle cx="10" cy="4" r="1.6"/><circle cx="10" cy="10" r="1.6"/><circle cx="10" cy="16" r="1.6"/></svg>
      </button>
      <ul tabindex="0" class="dropdown-content menu menu-sm bg-base-100 rounded-box shadow-lg border border-base-300 z-30 w-56 p-1.5 mt-1">
        <li><button type="button" @click="expandAllSections(true); $el.blur()">Expand all sections</button></li>
        <li><button type="button" @click="expandAllSections(false); $el.blur()">Collapse all sections</button></li>
        <li class="menu-title pt-2">Reset</li>
        <li><button type="button" class="text-warning" @click="resetAll(); $el.blur()">Reset all to defaults</button></li>
      </ul>
    </div>
  {{/if}}
</div>
