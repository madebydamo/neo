{{!-- Rich service introduction header (requires meta). --}}
<div class="mb-4 pb-3 border-b border-base-300">
  <div class="flex items-start gap-3">
    {{#if meta.icon}}
      <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
        <img src="{{meta.icon}}" class="max-w-full max-h-full object-contain" alt=""
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <span class="hidden text-4xl leading-none">⚙</span>
      </div>
    {{/if}}
    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="card-title font-mono text-xl">{{service}}</h1>
          {{#if meta.projectUrl}}
            <a href="{{meta.projectUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">Project ↗</a>
          {{/if}}
          {{#if meta.githubUrl}}
            <a href="{{meta.githubUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">GitHub ↗</a>
          {{/if}}
          {{#if meta.releaseUrl}}
            <a href="{{meta.releaseUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">Releases ↗</a>
          {{/if}}
        </div>
        <button @click="resetAll()" class="btn btn-ghost btn-xs flex-shrink-0">Reset all to defaults</button>
      </div>

      {{#if meta.description}}
        <div class="mt-2 text-sm leading-relaxed text-base-content/80 whitespace-pre-line">
          {{meta.description}}
        </div>
      {{/if}}

      {{#if meta.screenshots}}
        <div class="mt-3">
          <div class="text-xs font-semibold text-base-content/60 mb-1.5">Examples</div>
          <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1">
            {{#each meta.screenshots}}
              <a href="{{url}}" target="_blank" class="block flex-shrink-0 group">
                <img src="{{url}}" alt="{{#if caption}}{{caption}}{{else}}{{../service}} screenshot{{/if}}"
                     class="h-20 w-auto max-w-[180px] rounded border border-base-300 group-hover:border-primary transition-colors object-cover bg-base-200">
                {{#if caption}}
                  <div class="text-[10px] text-center opacity-60 mt-0.5 max-w-[180px] truncate">{{caption}}</div>
                {{/if}}
              </a>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>
