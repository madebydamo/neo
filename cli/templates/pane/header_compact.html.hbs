{{!-- Fallback compact header when no meta is defined for the service. --}}
<div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
  <div class="flex items-center gap-2 min-w-0">
    {{#if is_core}}
      <button type="button"
              class="btn btn-ghost btn-xs flex-shrink-0"
              hx-get="/core-grid"
              hx-target="#config-content"
              hx-swap="innerHTML"
              title="Back to Settings">← Settings</button>
    {{else}}
      <button type="button"
              class="btn btn-ghost btn-xs flex-shrink-0"
              hx-get="/services-grid"
              hx-target="#config-content"
              hx-swap="innerHTML"
              title="Back to Services">← Services</button>
    {{/if}}
    <h1 class="card-title font-mono">{{service}}</h1>
  </div>
  <button @click="resetAll()" class="btn btn-ghost btn-xs flex-shrink-0">Reset all to defaults</button>
</div>
