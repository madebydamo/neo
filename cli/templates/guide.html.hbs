{{!-- One guide: header (services, time, difficulty), rendered Markdown,
     table of contents and related guides. --}}
<div id="guide-page" class="max-w-5xl" {{#if guide}}data-guide-title="{{guide.title}}" data-neo-eval-keys="guides" data-neo-eval-gen="{{eval.gen}}" data-neo-eval-provisional="{{eval.provisional}}" data-neo-eval-url="/configuration/guides/{{guide.id}}"{{/if}}>
  {{#if error}}
    <div role="alert" class="alert alert-error alert-soft text-sm">
      <div class="text-xs whitespace-pre-wrap break-words font-mono">{{error}}</div>
    </div>
  {{/if}}

  {{#if guide}}
    <header class="flex items-start gap-3 sm:gap-4">
      <div class="w-11 h-11 sm:w-14 sm:h-14 flex-shrink-0 rounded-2xl bg-base-200 border border-base-300 p-1.5 sm:p-2 flex items-center justify-center">
        {{#if guide.icon}}
          <img src="{{guide.icon}}" class="max-w-full max-h-full object-contain" alt="">
        {{else}}
          <span class="text-2xl leading-none opacity-60">✦</span>
        {{/if}}
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="text-lg sm:text-2xl font-semibold tracking-tight">{{guide.title}}</h1>
        {{#if guide.summary}}
          <p class="mt-1 text-sm leading-relaxed text-base-content/70">{{guide.summary}}</p>
        {{/if}}
        <p class="mt-2 text-xs leading-relaxed text-base-content/60">
          {{#if guide.minutes}}About {{guide.minutes}} min{{/if}}{{#if guide.difficulty}}{{#if guide.minutes}} · {{/if}}<span class="capitalize">{{guide.difficulty}}</span>{{/if}}{{#if guide.services}}{{#if (or guide.minutes guide.difficulty)}} · {{/if}}Uses
          {{#each guide.services}}<a href="/configuration/option/{{name}}" hx-get="/configuration/option/{{name}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
             class="link link-hover {{#if enabled}}text-success{{else}}text-base-content/80{{/if}}"
             title="{{#if enabled}}Installed{{else}}Not installed yet{{/if}}">{{name}}{{#if enabled}} ✓{{/if}}</a>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{#if guide.optional}} · optional
          {{#each guide.optional}}<a href="/configuration/option/{{name}}" hx-get="/configuration/option/{{name}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
             class="link link-hover text-base-content/70">{{name}}</a>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}
        </p>
      </div>
    </header>

    {{#if missing}}
      <div role="status" class="alert alert-info alert-soft text-sm mt-4">
        <span>This guide uses {{#each missing}}<strong>{{this}}</strong>{{#unless @last}}, {{/unless}}{{/each}}, which {{#if (gt (len missing) 1)}}are{{else}}is{{/if}} not switched on yet. The first steps show how.</span>
      </div>
    {{/if}}

    {{#if assistant}}
      <div class="mt-4">
        <button type="button" class="btn btn-primary btn-sm gap-1.5"
                data-neo-agent="guide:{{guide.id}}" data-neo-agent-title="{{guide.title}}"
                data-neo-agent-starter="Help me set this up step by step: {{guide.title}}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
          Do it with AI
        </button>
        <span class="ml-2 text-xs text-base-content/55">The assistant walks you through it and prepares the settings for you.</span>
      </div>
    {{/if}}
    {{#unless assistant}}
      <p class="mt-3 text-xs text-base-content/55">
        Want step-by-step help? <a href="/configuration/option/hermes" hx-get="/configuration/option/hermes" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true" class="link">Enable the assistant</a>.
      </p>
    {{/unless}}

    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <article class="neo-guide-body min-w-0">{{{html}}}</article>

      <aside class="space-y-5 lg:sticky lg:top-24 self-start text-sm">
        {{#if (gt (len toc) 1)}}
          <nav aria-label="On this page">
            <div class="text-xs font-semibold uppercase tracking-wider text-base-content/55 mb-1.5">On this page</div>
            <ul class="space-y-1">
              {{#each toc}}
                <li><a href="#{{id}}" class="link link-hover text-base-content/75"
                       onclick="event.preventDefault();var t=document.getElementById('{{id}}');if(t)t.scrollIntoView({behavior:'smooth',block:'start'});">{{title}}</a></li>
              {{/each}}
            </ul>
          </nav>
        {{/if}}
      </aside>
    </div>

    {{#if related}}
      <section class="mt-8 space-y-2.5">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-base-content/55">Related guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 sm:gap-3">
          {{#each related}}
            {{> partials/guide_card}}
          {{/each}}
        </div>
      </section>
    {{/if}}
  {{else}}
    {{#unless error}}
      <p class="text-sm text-base-content/60">This guide does not exist (any more).
        <a href="/configuration/guides" hx-get="/configuration/guides" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true" class="link">All guides</a></p>
    {{/unless}}
  {{/if}}
</div>
