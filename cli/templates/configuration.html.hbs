<html>
  <head>
    <title>neo config</title>
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png">

    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/sse.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/ws.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>
    <script src="/static/option_form.js"></script>
    <style>
      /* Sticky action bar offset (matches body p-6). */
      :root {
        --neo-sticky-bar-top: 1.5rem;
      }
      /* Hide Alpine-bound chrome until Alpine initializes. */
      [x-cloak] { display: none !important; }
      /* Navbar load spinner: explicit display so it always hides (no Tailwind utility clash). */
      #nav-busy { display: none; }
      #nav-busy.is-busy { display: inline-flex; }
    </style>
  </head>
  <body class="bg-base-300 text-base-content p-6 min-h-dvh" data-theme="{{theme}}">
    {{#if error}}
      <div class="alert alert-error mb-4 text-sm flex flex-col sm:flex-row sm:items-start gap-2">
        <span class="flex-1 whitespace-pre-wrap"><strong>Eval error{{#if error_kind}} ({{error_kind}}){{/if}}:</strong> {{error}}</span>
        <div class="flex flex-wrap gap-2 shrink-0">
          {{#if can_store_repair}}
            <button type="button"
                    class="btn btn-sm btn-warning"
                    hx-post="/nix/repair"
                    hx-target="#changes-body"
                    hx-swap="innerHTML"
                    hx-confirm="Run sudo nix-store --verify --repair? This can take a few minutes."
                    hx-on::after-request="var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Nix store repair';m.showModal();}">
              Repair Nix store
            </button>
          {{/if}}
          {{#if can_flake_update}}
            <button type="button"
                    class="btn btn-sm btn-info"
                    hx-post="/flake/update"
                    hx-target="#changes-body"
                    hx-swap="innerHTML"
                    hx-confirm="Run flake update + template refresh?"
                    hx-on::after-request="var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Update';m.showModal();}">
              Update flake inputs
            </button>
          {{/if}}
          <button class="btn btn-sm" onclick="location.reload()">Reload</button>
        </div>
      </div>
    {{/if}}
    <div class="max-w-7xl mx-auto" hx-ext="ws" ws-connect="/ws/status">
      {{!-- Shell owns navbar + tabs + breadcrumb so Alpine can drive chrome outside swaps. --}}
      <div id="config-shell"
           x-data="configShell()"
           data-initial-tab="{{#if initial_tab}}{{initial_tab}}{{else}}services{{/if}}"
           data-initial-detail="{{#if initial_detail}}{{initial_detail}}{{/if}}">
        {{!-- Sticky config bar: title reflects current service when editing. --}}
        <div class="navbar h-16 min-h-16 bg-base-100/95 backdrop-blur rounded-box mb-6 shadow sticky z-30"
             style="top: var(--neo-sticky-bar-top)">
          <div class="flex-1 min-w-0 flex items-center gap-2 px-4">
            <button type="button"
                    class="text-2xl font-bold flex-shrink-0 hover:opacity-80 transition-opacity"
                    @click="goHome()"
                    title="Back to configuration home">neo</button>
            {{!-- Default subtitle when on a grid/tab. --}}
            <span class="text-sm opacity-50 truncate"
                  x-show="!detail"
                  x-cloak>homeserver config</span>
            {{!-- Active service/section while editing (light, not bold). --}}
            <span class="text-sm font-mono font-normal opacity-70 truncate min-w-0"
                  x-show="detail"
                  x-text="detail"
                  x-cloak
                  :title="detail"></span>
          </div>
          {{!-- Activity + action bar: nav spinner (client, instant) sits next to
               server-driven eval/pending/reset; Update + Activate stay on the right. --}}
          <div class="flex-none flex items-center gap-2 pr-2">
            {{!-- Nav busy: toggled via .is-busy (not Tailwind `hidden`+`inline-flex` — those fight and stay visible). --}}
            <span id="nav-busy"
                  class="items-center gap-1 text-[10px] text-info opacity-90"
                  title="Loading…"
                  aria-live="polite"
                  aria-hidden="true">
              <span class="loading loading-spinner loading-xs"></span>
              <span class="hidden sm:inline">load</span>
            </span>
            <div id="action-bar-dynamic"
                 class="flex items-center gap-2"
                 hx-get="/changes/action-bar"
                 hx-trigger="load"
                 hx-swap="outerHTML"></div>
            <div class="join">
              <button hx-post="/flake/update" hx-target="#changes-body" hx-swap="innerHTML" hx-confirm="Run flake update + template refresh?" hx-on::after-request="var m=document.getElementById('changes-modal');m.querySelector('h3').textContent='Update';m.showModal();" class="btn btn-xs join-item btn-ghost">↻<span class="hidden sm:inline ml-1">Update</span></button>
              <button hx-post="/actions/activate" hx-target="#changes-body" hx-swap="innerHTML" hx-confirm="Trigger full activation now (via service)?" hx-on::after-request="var m=document.getElementById('changes-modal');m.querySelector('h3').textContent='Activation';m.showModal();" class="btn btn-xs join-item btn-error">▶<span class="hidden sm:inline ml-1">Activate</span></button>
            </div>
          </div>
        </div>

        <div class="tabs tabs-bordered mb-2 text-sm">
          <button
            type="button"
            class="tab"
            :class="{ 'tab-active': tab === 'services' }"
            @click="loadTab('services')">
            Services
          </button>
          <button
            type="button"
            class="tab"
            :class="{ 'tab-active': tab === 'settings' }"
            @click="loadTab('settings')">
            Settings
          </button>
          <button
            type="button"
            class="tab"
            :class="{ 'tab-active': tab === 'versioning' }"
            @click="loadTab('versioning')">
            Versioning
          </button>
        </div>
        {{!-- Persistent breadcrumb (outside #config-content); goUp() pushes the parent URL. --}}
        <div class="flex items-center gap-1.5 text-sm mb-3 min-h-[1.5rem]"
             x-show="detail"
             x-cloak>
          <button type="button"
                  class="btn btn-ghost btn-xs gap-1 px-1.5"
                  @click="goUp()">
            ← <span x-text="sectionLabel()"></span>
          </button>
          <span class="opacity-40 select-none" aria-hidden="true">›</span>
          <span class="font-mono text-xs font-medium truncate" x-text="detail"></span>
        </div>
        {{!--
          Source for shell nav: htmx.ajax ignores context.push; history only updates from
          hx-push-url on the source element. navigateContent() passes this as `source`.
          Loading feedback is #nav-busy in the navbar (not a progress bar).
        --}}
        <span id="config-nav-helper"
              class="hidden"
              aria-hidden="true"
              hx-push-url="true"></span>
        {{!-- hx-history-elt: history snapshots restore into this pane, not the whole body. --}}
        <div id="config-content"
             hx-history-elt
             hx-get="{{#if initial_content_url}}{{initial_content_url}}{{else}}/configuration{{/if}}"
             hx-trigger="load"
             hx-swap="innerHTML"
             hx-push-url="false"
             class="min-h-[100px]">
          <div class="text-xs opacity-60 p-4 border border-dashed rounded">Loading...</div>
        </div>
      </div>
    </div>

    {{!-- Global toast host (outside #config-content so it is never swapped away). --}}
    <div id="toast-host" class="toast toast-top toast-end z-[60] fixed top-4 right-4"></div>

    <dialog id="changes-modal" class="modal">
      <div class="modal-box max-w-4xl">
        <h3 id="changes-modal-title" class="font-bold text-lg mb-2">Pending changes summary</h3>
        <div id="changes-body" class="max-h-[60vh] overflow-auto"></div>
        <div class="modal-action">
          <form method="dialog" class="flex flex-nowrap items-center gap-2">
            <button type="submit" class="btn btn-sm btn-ghost">Close</button>
          </form>
        </div>
      </div>
    </dialog>

    <dialog id="activation-success" class="modal">
      <div class="modal-box max-w-3xl">
        <h3 class="font-bold text-lg mb-2 text-success">Activation complete</h3>
        <div id="activation-success-body" class="max-h-[50vh] overflow-auto text-sm"></div>
        <div class="modal-action">
          <form method="dialog" class="flex flex-nowrap items-center gap-2">
            <button type="button" onclick="confirmActivationReload()" class="btn btn-sm btn-success">Confirm &amp; reload</button>
            <button type="submit" class="btn btn-sm btn-ghost">Close</button>
          </form>
        </div>
      </div>
    </dialog>

    <dialog id="logs-dialog" class="modal">
      <div class="modal-box w-11/12 max-w-5xl">
        <h3 class="font-bold text-lg mb-1">Logs for <span id="log-unit" class="font-mono"></span></h3>
        <div class="text-[10px] opacity-60 mb-1">Live follow (journalctl -f). New lines appended automatically; scrollable infinitely.</div>
        <pre id="log-pre" class="bg-base-300 p-2 rounded text-[10px] font-mono whitespace-pre-wrap overflow-auto max-h-[55vh] min-h-[180px] border border-base-300"></pre>
        <div class="modal-action">
          <form method="dialog" class="flex flex-nowrap items-center gap-2">
            <button type="button" class="btn btn-sm" onclick="clearUnitLogs()">Clear</button>
            <button type="submit" class="btn btn-sm btn-ghost" onclick="closeUnitLogs()">Close</button>
          </form>
        </div>
      </div>
    </dialog>

    <dialog id="helper-dialog" class="modal">
      <div class="modal-box max-w-md">
        <h3 id="helper-dialog-title" class="font-bold text-lg mb-1">Helper</h3>
        <p id="helper-dialog-desc" class="text-sm opacity-70 mb-3"></p>
        <form id="helper-dialog-form" class="space-y-3" onsubmit="return false;">
          <div id="helper-dialog-fields" class="space-y-3"></div>
          <div class="modal-action">
            <button type="button" class="btn btn-sm btn-ghost" onclick="closeHelperDialog()">Cancel</button>
            <button type="submit" id="helper-dialog-submit" class="btn btn-sm btn-primary">Apply</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <script src="/static/configuration.js"></script>
  </body>
</html>
