<!DOCTYPE html>
<html lang="en">
  <head>
    {{> partials/head_meta title="neo config"}}

    <link rel="stylesheet" href="/static/neo-ui.css" />
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/sse.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/ws.js"></script>
    <script src="https://unpkg.com/alpinejs@3.17.5/dist/cdn.min.js" defer></script>
    <script src="/static/neo_util.js"></script>
    <script src="/static/widgets/registry.js"></script>
    <script src="/static/widgets/exclusive_list_pair.js"></script>
    <script src="/static/widgets/plugin_list.js"></script>
    <script src="/static/widgets/primary_item_list.js"></script>
    <script src="/static/widgets/provider_auth.js"></script>
    <script src="/static/widgets/proxy_route_list.js"></script>
    <script src="/static/option_form.js"></script>
    <script src="/static/version_tree.js"></script>
    <script src="/static/versioning.js"></script>
    <script src="/static/services_filter.js"></script>
    <script src="/static/services_grid.js"></script>
    <script src="/static/diff_view.js"></script>
    <script src="/static/agent_chat_core.js"></script>
    <script src="/static/agent_chat_refs.js"></script>
    <script src="/static/agent_chat.js"></script>
  </head>
  <body class="neo-config bg-base-300 text-base-content min-h-dvh" data-theme="{{theme}}">
    <div class="max-w-7xl mx-auto" hx-ext="ws" ws-connect="/ws/status">
      {{#if error}}
        <div role="alert" class="alert alert-error alert-soft mb-3 sm:mb-4 text-sm items-start">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true"><path d="M12 8v5M12 16.5v.01"/><path d="M10.3 3.9L2.6 17.5A2 2 0 004.3 20.5h15.4a2 2 0 001.7-3l-7.7-13.6a2 2 0 00-3.4 0z" stroke-linejoin="round"/></svg>
          <div class="min-w-0 flex-1">
            <div class="font-semibold">Evaluation failed{{#if error_kind}} <span class="font-normal opacity-70">({{error_kind}})</span>{{/if}}</div>
            <div class="mt-1 text-xs whitespace-pre-wrap break-words font-mono opacity-80 max-h-48 overflow-auto">{{error}}</div>
            <div class="mt-3 flex flex-wrap gap-2">
              {{> partials/eval_error_actions size="btn-sm" reload_size="btn-sm" repair_label="Repair Nix store" update_label="Update flake inputs" repair_confirm="Run sudo nix-store --verify --repair? This can take a few minutes." update_confirm="Run flake update + template refresh?"}}
            </div>
          </div>
        </div>
      {{/if}}
      {{!-- Shell owns navbar + tabs + breadcrumb so Alpine can drive chrome outside swaps. --}}
      <div id="config-shell"
           x-data="configShell()"
           data-initial-tab="{{#if initial_tab}}{{initial_tab}}{{else}}services{{/if}}"
           data-initial-detail="{{#if initial_detail}}{{initial_detail}}{{/if}}">
        {{!--
          Single continuous glass plate used while action + save bars are fused.
          Separate backdrop-filter layers cannot blend at the seam; this one plate
          covers both bars so blur is unbroken. Positioned by configuration.js.
        --}}
        <div id="config-fused-glass" class="neo-fused-glass" hidden aria-hidden="true"></div>
        {{!-- Sticky top bar (glass): brand · tabs (md+) · status + Update/Activate.
             Fuses with the option-pane strip on scroll. Height is mirrored by
             --neo-action-bar-height in input.css — keep them in sync. --}}
        <header id="config-action-bar"
                class="navbar h-14 min-h-14 sm:h-16 sm:min-h-16 gap-2 bg-base-100/60 backdrop-blur-xs rounded-box mb-2 md:mb-6 shadow sticky z-30 transition-[background-color,box-shadow,border-radius] duration-200"
                style="top: var(--neo-sticky-bar-top)">
          <div class="flex-1 md:flex-none min-w-0 flex items-center pl-1 sm:pl-2">
            <button type="button"
                    class="flex items-center gap-2 rounded-field px-1 py-1 hover:bg-base-content/5 transition-colors"
                    @click="goHome()"
                    title="Back to configuration home">
              <img src="/static/neo-icon.png" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg object-contain" alt="">
              <span class="text-xl sm:text-2xl font-bold tracking-tight">neo</span>
            </button>
          </div>

          {{> partials/shell_tabs extraClass="hidden md:flex mx-auto"}}

          {{!-- Activity + actions: one spinner for page-load + nix-eval (client folds
               data-eval-busy from #action-bar-dynamic into #nav-busy); status pill /
               reset are server-rendered (action_bar.rs) and pushed over the WS. --}}
          <div class="flex-none md:flex-1 flex items-center justify-end gap-1 sm:gap-1.5 pr-1 sm:pr-2">
            {{!-- Combined busy: .is-busy from load and/or eval (not Tailwind `hidden`+`inline-flex`). --}}
            <span id="nav-busy"
                  class="items-center gap-1.5 text-xs text-info px-1"
                  title="Loading…"
                  aria-live="polite"
                  aria-hidden="true">
              <span class="loading loading-ring loading-sm"></span>
              {{!-- nav_progress.js adds .is-slow after ~1.5s: label shows on every breakpoint. --}}
              <span class="neo-busy-label hidden lg:inline">Loading…</span>
            </span>
            <div id="action-bar-dynamic"
                 class="flex items-center gap-1"
                 data-eval-busy="false"
                 hx-get="/changes/action-bar"
                 hx-trigger="load"
                 hx-swap="outerHTML"></div>
            <div class="w-px h-6 bg-base-300 mx-0.5 hidden sm:block" aria-hidden="true"></div>
            {{#if assistant}}{{> partials/agent_launch}}{{/if}}
            <button type="button"
                    hx-post="/flake/update" data-neo-lock="system" hx-target="#changes-body" hx-swap="innerHTML"
                    hx-confirm="Run flake update + template refresh?"
                    hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Update')"
                    class="btn btn-sm btn-ghost gap-1.5 px-2 lg:px-3"
                    title="Update flake inputs and refresh the template">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M12 4v10M7.5 9.5L12 14l4.5-4.5"/><path d="M5 17v1.5A1.5 1.5 0 006.5 20h11a1.5 1.5 0 001.5-1.5V17"/></svg>
              <span class="hidden lg:inline">Update</span>
            </button>
            <button type="button"
                    hx-post="/actions/activate" data-neo-lock="system" hx-target="#changes-body" hx-swap="innerHTML"
                    hx-confirm="Trigger full activation now (via service)?"
                    hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Activation')"
                    class="btn btn-sm btn-primary gap-1.5 px-2.5 sm:px-3"
                    title="Build and switch to the current configuration">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 001.5.9l10.2-6.4a1 1 0 000-1.7L9.5 4.7A1 1 0 008 5.6z"/></svg>
              <span class="hidden sm:inline">Activate</span>
            </button>
          </div>
        </header>

        {{> partials/shell_tabs extraClass="md:hidden w-full mb-3"}}

        {{!-- Persistent breadcrumb (outside #config-content); goUp() pushes the parent URL. --}}
        <nav class="flex items-center gap-1 text-sm mb-3 min-h-8"
             aria-label="Breadcrumb"
             x-show="detail"
             x-cloak>
          <button type="button"
                  class="btn btn-ghost btn-sm gap-1 px-2 -ml-1 font-normal text-base-content/70 hover:text-base-content"
                  @click="goUp()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path fill-rule="evenodd" d="M12.8 5.2a.75.75 0 010 1.06L9.06 10l3.74 3.74a.75.75 0 11-1.06 1.06l-4.27-4.27a.75.75 0 010-1.06L11.74 5.2a.75.75 0 011.06 0z" clip-rule="evenodd"/></svg>
            <span x-text="sectionLabel()"></span>
          </button>
          <span class="text-base-content/30 select-none" aria-hidden="true">/</span>
          <span class="font-mono text-sm font-semibold truncate px-1" x-text="detail" :title="detail" aria-current="page"></span>
        </nav>
        {{!--
          Source for shell nav: htmx.ajax ignores context.push; history only updates from
          hx-push-url on the source element. navigateContent() passes this as `source`.
          Loading feedback: #nav-busy in the navbar (load + eval) plus nav_progress.js
          (top progress bar, pressed state on the clicked element, busy pane).
        --}}
        <span id="config-nav-helper"
              class="hidden"
              aria-hidden="true"
              hx-push-url="true"></span>
        {{!-- hx-history-elt: history snapshots restore into this pane, not the whole body.
             Deep-linked option/core pages SSR the pane into this div so labels/fields are in
             the first HTML response (no HTMX round-trip). Grids still lazy-load on hx-trigger. --}}
        {{!-- #neo-eval-sync (evaluation state, read by eval_sync.js) and
             #neo-eval-error (latest change does not evaluate); replaced over /ws/status. --}}
        {{{eval_status_html}}}
        <div id="config-content"
             hx-history-elt
             {{#unless initial_content_html}}
             hx-get="{{#if initial_content_url}}{{initial_content_url}}{{else}}/configuration{{/if}}"
             hx-trigger="load"
             hx-swap="innerHTML"
             hx-push-url="false"
             {{/unless}}
             class="min-h-[100px]">
          {{#if initial_content_html}}
            {{{initial_content_html}}}
          {{else}}
          <div class="flex flex-col items-center justify-center gap-2 py-16 text-sm text-base-content/50">
            <span class="loading loading-spinner loading-md"></span>
            Loading…
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Global toast host (outside #config-content so it is never swapped away). --}}
    <div id="toast-host" class="toast toast-top toast-end z-[60] fixed top-4 right-4"></div>

    {{!-- Live operation-lock holders (static/locks.js); replaced over /ws/status. --}}
    <div id="neo-locks" hidden hx-get="/locks" hx-trigger="load" hx-swap="outerHTML"></div>

    {{> partials/changes_modal title="Pending changes"}}

    {{!-- Unit logs. The output panel is filled by NeoOpMonitor.logPane (same as activation / update). --}}
    <dialog id="logs-dialog" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box neo-changes-modal-box max-w-4xl p-0 flex flex-col w-full">
        <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-base-300 shrink-0">
          <h3 class="font-semibold text-lg min-w-0 flex-1 truncate">
            Logs <span id="log-unit" class="font-normal text-sm opacity-50 font-mono"></span>
          </h3>
          <span id="log-conn" class="neo-op-conn shrink-0" data-conn="connecting" title="Live follow (journalctl -f). Scroll up to pause; Latest jumps back to the tail.">Connecting…</span>
          <form method="dialog">
            <button type="submit" class="btn btn-sm btn-ghost btn-square" aria-label="Close">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
            </button>
          </form>
        </div>
        <div id="logs-body" class="px-4 sm:px-6 py-4 min-h-0 flex-1 overflow-hidden flex flex-col">
          <div id="logs-output" class="neo-op"></div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <dialog id="helper-dialog" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box max-w-md">
        <h3 id="helper-dialog-title" class="font-semibold text-lg mb-1">Helper</h3>
        <p id="helper-dialog-desc" class="text-sm text-base-content/70 mb-4"></p>
        <form id="helper-dialog-form" class="space-y-3" onsubmit="return false;">
          <div id="helper-dialog-fields" class="space-y-3"></div>
          <div class="modal-action">
            <button type="button" class="btn btn-sm btn-ghost" onclick="closeHelperDialog()">Cancel</button>
            <button type="submit" id="helper-dialog-submit" class="btn btn-sm btn-primary">Apply</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <script src="/static/service_status.js"></script>
    <script src="/static/resources_panel.js"></script>
    <script src="/static/locks.js"></script>
    <script src="/static/reboot_watch.js"></script>
    <script src="/static/proposal_card.js"></script>
    <script src="/static/op_monitor.js"></script>
    <script src="/static/configuration.js"></script>
    <script src="/static/config_dialogs.js"></script>
    <script src="/static/unit_watch.js"></script>
    <script src="/static/plugin_pills.js"></script>
    <script src="/static/nav_progress.js"></script>
    <script src="/static/eval_sync.js"></script>
    {{#if assistant}}{{> partials/agent_drawer}}{{/if}}
  </body>
</html>
