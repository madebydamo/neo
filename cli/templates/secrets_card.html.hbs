{{!-- Settings → Secrets card (web/secrets_card.rs): where secret settings
     live and the switch inline → secrets.yaml → encrypted. --}}
{{#*inline "action"}}<button type="button" class="btn btn-sm {{class}}" hx-post="/secrets/{{action}}" hx-target="#secrets-card" hx-swap="outerHTML" data-neo-progress data-neo-lock="system:sh"{{#if confirm}} hx-confirm="{{confirm}}"{{/if}}>{{label}}</button>{{/inline}}
<div id="secrets-card" class="rounded-box border border-base-300 bg-base-100 p-4">
  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
    <span class="w-9 h-9 shrink-0 rounded-xl bg-base-200 text-base-content/70 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/></svg></span>
    <div class="min-w-0 flex-1">
      <div class="font-semibold text-sm flex items-center gap-2 flex-wrap">Secrets
        {{#if (eq backend "inline")}}<span class="badge badge-sm badge-ghost">in settings.toml</span>{{/if}}
        {{#if (eq backend "plain")}}<span class="badge badge-sm badge-warning badge-soft">secrets.yaml · plain text</span>{{/if}}
        {{#if (eq backend "sops")}}<span class="badge badge-sm badge-success badge-soft">encrypted</span>{{/if}}
      </div>
      <div class="text-xs text-base-content/60">
        {{#if (eq backend "inline")}}Secret settings (passwords, tokens, keys) are stored in plain text inside settings.toml.{{/if}}
        {{#if (eq backend "plain")}}Secret settings are kept apart in {{plain_file}}, still unencrypted: keep the config repository private.{{/if}}
        {{#if (eq backend "sops")}}Secret settings are encrypted in {{sops_file}}. This machine decrypts them with its SSH host key; every ssh-ed25519 key below can decrypt them too.{{#if escrowed}} The host key is escrowed for those keys in {{identity_file}}, so the machine can be restored from the repository.{{/if}}{{/if}}
      </div>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      {{#if (eq backend "inline")}}
        {{> action action="split" label="Move to secrets.yaml" class="btn-ghost"}}
        {{> action action="enable" label="Encrypt" class="btn-primary" confirm="Encrypt all secret settings for this machine and the SSH keys listed below? Activate afterwards to apply."}}
      {{/if}}
      {{#if (eq backend "plain")}}
        {{> action action="enable" label="Encrypt" class="btn-primary" confirm="Encrypt all secret settings for this machine and the SSH keys listed below? Activate afterwards to apply."}}
      {{/if}}
      {{#if (eq backend "sops")}}
        {{> action action="rekey" label="Re-encrypt" class="btn-ghost"}}
        {{> action action="disable" label="Decrypt" class="btn-soft btn-warning" confirm="Decrypt the secrets back into a plain-text secrets.yaml? Activate afterwards to apply."}}
      {{/if}}
    </div>
  </div>
  <div class="mt-3 text-xs">
    <div class="text-base-content/60 mb-1">Can decrypt:</div>
    <ul class="space-y-0.5 text-[11px]">
      {{#if host}}<li class="font-mono break-all">{{host}} <span class="text-base-content/45">(this machine)</span></li>{{/if}}
      {{#each admins}}<li class="font-mono break-all">{{this}}</li>{{else}}<li class="text-warning">No ssh-ed25519 key in System → SSH: add one before encrypting, or nobody could restore the secrets.</li>{{/each}}
    </ul>
    {{#if ignored}}<p class="text-xs text-base-content/50 mt-1">{{ignored}} other key(s) can log in but not decrypt (only ssh-ed25519 is supported).</p>{{/if}}
  </div>
  {{#if message}}<div role="alert" class="alert alert-{{message.kind}} alert-soft text-xs mt-3 py-2">{{message.text}}</div>{{/if}}
</div>
