{{!-- Access page (routes/access.rs): every way into the server. Default access for
     apps, each app's places / login page / SSO (clicks save a settings patch and
     re-render this fragment), open ports and the server's own logins. --}}
{{#*inline "toggleForm"}}
<form hx-post="/access/set" hx-trigger="submit, change" hx-target="#access-page" hx-swap="outerHTML" class="contents">
  <input type="hidden" name="path" value="{{path}}">
  <input type="hidden" name="value" value="{{value}}">
  {{> @partial-block}}
</form>
{{/inline}}
{{#*inline "placeIcon"}}
  {{#if (eq id "local")}}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"><path d="M3.5 9L10 3.5 16.5 9v7a1 1 0 01-1 1h-3.5v-4.5h-4V17H4.5a1 1 0 01-1-1V9z"/></svg>{{/if}}
  {{#if (eq id "web")}}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M3 10h14M10 3c2 2.1 2.9 4.4 2.9 7s-.9 4.9-2.9 7c-2-2.1-2.9-4.4-2.9-7S8 5.1 10 3z"/></svg>{{/if}}
  {{#if (eq id "tailscale")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"><circle cx="4.5" cy="10" r="1.8"/><circle cx="10" cy="10" r="1.8"/><circle cx="15.5" cy="10" r="1.8"/><circle cx="10" cy="4.5" r="1.8" opacity=".4"/><circle cx="10" cy="15.5" r="1.8"/></svg>{{/if}}
  {{#if (eq id "netbird")}}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"><circle cx="5" cy="5" r="1.8"/><circle cx="15" cy="5" r="1.8"/><circle cx="10" cy="15" r="1.8"/><path d="M6.6 6.2l2.5 7M13.4 6.2l-2.5 7M6.8 5h6.4"/></svg>{{/if}}
{{/inline}}
{{#*inline "followBadge"}}
  {{#if state.fixed}}<span class="badge badge-ghost badge-xs" title="This app decides this itself">set by app</span>
  {{else}}{{#if state.changed}}<span class="badge badge-outline badge-xs" title="Set for this app; does not follow the default">changed</span>{{/if}}{{/if}}
{{/inline}}
<div id="access-page" class="space-y-6 sm:space-y-8" x-data="accessFilter()" @neo-map-pin="onPin($event.detail)"
     data-neo-eval-keys="access" data-neo-eval-gen="{{eval.gen}}" data-neo-eval-provisional="{{eval.provisional}}" data-neo-eval-url="/configuration/access">
  <div class="flex items-start gap-3">
    <a href="/configuration/settings" hx-get="/configuration/settings" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
       class="btn btn-ghost btn-sm btn-square mt-0.5" title="Back to Settings" aria-label="Back to Settings">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path fill-rule="evenodd" d="M12.8 5.2a.75.75 0 010 1.06L9.06 10l3.74 3.74a.75.75 0 11-1.06 1.06L7.47 10.53a.75.75 0 010-1.06l4.27-4.27a.75.75 0 011.06 0z" clip-rule="evenodd"/></svg>
    </a>
    <div class="min-w-0">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">Access</h2>
      <p class="text-sm text-base-content/60 mt-0.5">Who can reach this server, from where, and how they log in. Changes here are saved to your settings; apply them from the bar at the top.</p>
    </div>
  </div>

  {{#if error}}
    <div role="alert" class="alert alert-error alert-soft text-sm">
      <div class="text-xs whitespace-pre-wrap break-words font-mono">{{error}}</div>
    </div>
  {{/if}}
  {{#if save_error}}
    <div role="alert" class="alert alert-error alert-soft text-sm">{{save_error}}</div>
  {{/if}}

  {{!-- What is open, in words (routes/access_map.rs). A click narrows the
       lists below to it. --}}
  {{#*inline "toneText"}}{{#if (eq tone "error")}}text-error{{/if}}{{#if (eq tone "warning")}}text-warning{{/if}}{{#if (eq tone "ok")}}text-success{{/if}}{{#if (eq tone "info")}}text-info{{/if}}{{#if (eq tone "muted")}}text-base-content/50{{/if}}{{/inline}}
  {{#*inline "toneChip"}}{{#if (eq tone "error")}}bg-error/12 text-error border-error/30{{/if}}{{#if (eq tone "warning")}}bg-warning/15 text-base-content border-warning/50{{/if}}{{#if (eq tone "ok")}}bg-success/10 text-success border-success/30{{/if}}{{#if (eq tone "info")}}bg-info/10 text-info border-info/30{{/if}}{{#if (eq tone "muted")}}bg-base-200 text-base-content/60 border-base-300{{/if}}{{/inline}}
  {{#*inline "toneBorder"}}{{#if (eq tone "error")}}border-error ring-2 ring-error/20{{/if}}{{#if (eq tone "warning")}}border-warning{{/if}}{{#if (eq tone "ok")}}border-success/50{{/if}}{{#if (eq tone "info")}}border-info/50{{/if}}{{#if (eq tone "muted")}}border-base-300 border-dashed{{/if}}{{/inline}}
  {{#*inline "toneDot"}}{{#if (eq tone "ok")}}bg-success text-success-content{{/if}}{{#if (eq tone "error")}}bg-error text-error-content{{/if}}{{#if (eq tone "warning")}}bg-warning text-warning-content{{/if}}{{#if (eq tone "info")}}bg-info text-info-content{{/if}}{{#if (eq tone "muted")}}bg-base-300 text-base-content/60{{/if}}{{/inline}}
  <section aria-labelledby="access-verdict-title"
           class="rounded-box border p-4 sm:p-5 {{#if (eq map.level "ok")}}border-success/40 bg-success/5{{/if}}{{#if (eq map.level "warning")}}border-warning/60 bg-warning/10{{/if}}{{#if (eq map.level "error")}}border-error/40 bg-error/5{{/if}}">
    <h3 id="access-verdict-title" class="sr-only">What is open</h3>
    <ul class="space-y-2">
      {{#each map.verdict}}
        <li class="flex items-start gap-2.5">
          <span class="mt-0.5 w-5 h-5 shrink-0 rounded-full flex items-center justify-center {{> toneDot}}">
            {{#if (eq tone "ok")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{{/if}}
            {{#if (eq tone "info")}}<span class="text-xs font-bold leading-none font-serif">i</span>{{/if}}
            {{#if (eq tone "warning")}}<span class="text-xs font-bold leading-none">!</span>{{/if}}
            {{#if (eq tone "error")}}<span class="text-xs font-bold leading-none">!</span>{{/if}}
          </span>
          <span class="flex-1 {{#if (eq tone "info")}}text-sm text-base-content/75{{else}}font-medium{{/if}}">{{text}}</span>
          {{#if filter}}<button type="button" class="btn btn-ghost btn-xs shrink-0" @click="show('{{filter}}')">Show</button>{{/if}}
        </li>
      {{/each}}
    </ul>
  </section>

  {{!-- The access map: where from → doors in the firewall → who gets in.
       Lines: static/access_map.js from the [data-neo-edge] list; a click pins
       a box's paths. On a phone the places are tabs and only what the chosen
       place reaches is listed (data-neo-from). --}}
  <section aria-labelledby="access-map-title" class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-4 lg:mb-5">
      <div>
        <h3 id="access-map-title" class="font-semibold">How people get in</h3>
        <p class="text-xs text-base-content/60 mt-0.5"><span class="hidden lg:inline">Follow a line from where someone is, through a door in the firewall, to what stands in their way. Click a box to follow its paths.</span><span class="lg:hidden">Pick where someone is, and see every way in from there.</span></p>
      </div>
      <ul class="hidden lg:flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-base-content/65" aria-label="Legend">
        <li class="flex items-center gap-1.5"><svg class="w-7 h-2 text-error" viewBox="0 0 28 4" aria-hidden="true"><path d="M1 2h26" stroke="currentColor" stroke-width="2.5" stroke-dasharray="7 5" stroke-linecap="round"/></svg>Open, but should not be</li>
        <li class="flex items-center gap-1.5"><svg class="w-7 h-2 text-success" viewBox="0 0 28 4" aria-hidden="true"><path d="M1 2h26" stroke="currentColor" stroke-width="2"/></svg>Internet, guarded</li>
        <li class="flex items-center gap-1.5"><svg class="w-7 h-2 text-info" viewBox="0 0 28 4" aria-hidden="true"><path d="M1 2h26" stroke="currentColor" stroke-width="2"/></svg>Public or own login</li>
        <li class="flex items-center gap-1.5"><svg class="w-7 h-2 text-warning" viewBox="0 0 28 4" aria-hidden="true"><path d="M1 2h26" stroke="currentColor" stroke-width="2" stroke-dasharray="5 4"/></svg>Skips the firewall</li>
        <li class="flex items-center gap-1.5"><svg class="w-7 h-2 text-base-content/30" viewBox="0 0 28 4" aria-hidden="true"><path d="M1 2h26" stroke="currentColor" stroke-width="2"/></svg>Home or VPN</li>
      </ul>
    </div>

    <div data-neo-map class="relative grid grid-cols-[minmax(0,1fr)] gap-5 lg:gap-0 lg:mt-10 lg:grid-cols-[minmax(9rem,11rem)_minmax(2rem,1fr)_minmax(13rem,16rem)_minmax(2rem,1fr)_minmax(16rem,28rem)]">
      <svg data-neo-map-canvas class="hidden lg:block absolute inset-0 w-full h-full pointer-events-none overflow-visible" aria-hidden="true"></svg>
      <div hidden>
        {{#each map.edges}}<i data-neo-edge data-from="{{from}}" data-to="{{to}}" data-tone="{{tone}}" data-dashed="{{dashed}}"></i>{{/each}}
      </div>

      {{!-- 1 Where from: a column of boxes, tabs on a phone. --}}
      <div class="relative">
        <div class="lg:absolute lg:-top-8 lg:left-0 whitespace-nowrap text-[11px] font-semibold uppercase tracking-wider text-base-content/45 mb-2 lg:mb-0"><span class="text-base-content/70">1</span> Where from</div>
        <div class="flex gap-2 overflow-x-auto -m-2 p-2 lg:flex-col lg:gap-3 lg:h-full lg:justify-around lg:overflow-visible lg:m-0 lg:p-0" role="tablist" aria-label="Where from">
          {{#each map.origins}}
            <button type="button" data-neo-node="{{id}}" role="tab" {{#if inactive}}disabled{{/if}}
                    :aria-selected="origin === '{{place}}'"
                    class="relative z-10 shrink-0 text-left rounded-box border bg-base-100 px-3 py-2 lg:py-2.5 flex items-center gap-2.5 transition outline-none focus-visible:ring-2 ring-primary {{#if inactive}}border-dashed border-base-300 opacity-50{{else}}border-base-300 shadow-sm hover:shadow-md cursor-pointer{{/if}}">
              <span class="w-8 h-8 lg:w-9 lg:h-9 shrink-0 rounded-full flex items-center justify-center {{#if (eq icon "globe")}}bg-base-content text-base-100{{else}}bg-base-200 text-base-content/70{{/if}}">
                {{#if (eq icon "globe")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.5 3.5 5.3 3.5 8.5s-1.1 6-3.5 8.5c-2.4-2.5-3.5-5.3-3.5-8.5s1.1-6 3.5-8.5z"/></svg>{{/if}}
                {{#if (eq icon "home")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5V19a1 1 0 01-1 1h-4.5v-5.5h-5V20H5a1 1 0 01-1-1v-8.5z"/></svg>{{/if}}
                {{#if (eq icon "vpn")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-5 h-5" aria-hidden="true"><circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M8 7.2l2.8 8.6M16 7.2l-2.8 8.6M8.2 6h7.6"/></svg>{{/if}}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold leading-tight whitespace-nowrap">{{label}}</span>
                <span class="hidden lg:block text-[11px] text-base-content/55 leading-tight">{{#if inactive}}Not set up{{else}}{{detail}}{{/if}}</span>
              </span>
            </button>
          {{/each}}
        </div>
      </div>
      <div class="hidden lg:block"></div>

      {{!-- 2 Doors in the firewall, one per service. --}}
      <div class="relative flex flex-col gap-2 lg:gap-2.5 lg:justify-around">
        <div class="lg:absolute lg:-top-8 lg:left-0 whitespace-nowrap text-[11px] font-semibold uppercase tracking-wider text-base-content/45"><span class="text-base-content/70">2</span> Doors in the firewall</div>
        <div class="hidden lg:block absolute inset-y-0 left-1/2 -translate-x-1/2 w-3 rounded-full bg-[repeating-linear-gradient(0deg,var(--color-base-300)_0_10px,var(--color-base-200)_10px_12px)]" aria-hidden="true"></div>
        {{#each map.doors}}
          <div data-neo-node="{{id}}" data-neo-from="{{origins}}" tabindex="0" role="button"
               :class="reaches($el) ? '' : 'max-lg:hidden'"
               class="relative z-10 rounded-box border border-base-300 bg-base-100 shadow-sm px-3 py-2 cursor-pointer hover:shadow-md transition outline-none focus-visible:ring-2 ring-primary">
            <div class="flex items-center gap-2 min-w-0">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" class="w-4 h-4 shrink-0 text-base-content/55" aria-hidden="true"><path d="M5 17.5V3.5a1 1 0 011-1h8a1 1 0 011 1v14M3 17.5h14"/><path d="M12 10h.01" stroke-linecap="round" stroke-width="2.4"/></svg>
              <span class="text-sm font-semibold leading-tight truncate flex-1" title="{{title}}">{{title}}</span>
            </div>
            <div class="font-mono text-[11px] text-base-content/50 truncate mt-0.5 pl-6" title="Ports {{ports}}">{{ports}}</div>
            <div class="flex items-center gap-1.5 mt-1 pl-6 min-w-0">
              {{#with firewall}}<span class="shrink-0 inline-flex items-center px-1.5 h-5 rounded border text-[10px] font-medium {{> toneChip}}" title="{{help}}">{{text}}</span>{{/with}}
              {{#if guard}}{{#with guard}}
                <span class="min-w-0 inline-flex items-center gap-1 text-[11px] {{> toneText}}" title="{{help}}">
                  <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 shrink-0" aria-hidden="true"><path d="M10 1.5l6.5 2.6v4.8c0 4-2.7 7.4-6.5 8.6-3.8-1.2-6.5-4.6-6.5-8.6V4.1L10 1.5z"/></svg>
                  <span class="truncate">{{text}}</span>
                </span>
              {{/with}}{{/if}}
              {{#if web}}<span class="text-[11px] text-base-content/55 truncate">Leads to your apps →</span>{{/if}}
            </div>
            <div class="lg:hidden text-[11px] text-base-content/50 mt-1 pl-6">From {{from}}</div>
          </div>
        {{/each}}
      </div>
      <div class="hidden lg:block"></div>

      {{!-- 3 Behind the web door: apps grouped by exposure. --}}
      <div class="relative flex flex-col gap-2 lg:gap-3 lg:justify-around">
        <div class="lg:absolute lg:-top-8 lg:left-0 whitespace-nowrap text-[11px] font-semibold uppercase tracking-wider text-base-content/45"><span class="text-base-content/70">3</span> Behind the web door</div>
        {{#each map.groups}}
          <div data-neo-node="{{id}}" data-neo-from="{{origins}}" tabindex="0" role="button"
               @click="pick('{{filter}}')" @keydown.enter="pick('{{filter}}')"
               :class="reaches($el) ? '' : 'max-lg:hidden'"
               title="Click to show only these apps in the list below"
               class="relative z-10 rounded-box border-2 bg-base-100 px-3 py-2.5 cursor-pointer hover:shadow-md transition outline-none focus-visible:ring-2 ring-primary/30 {{> toneBorder}}">
            <div class="flex items-start gap-2">
              <span class="w-7 h-7 shrink-0 rounded-lg flex items-center justify-center {{> toneDot}}">
                {{#if (eq guard "login")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M10 1.5l6.5 2.6v4.8c0 4-2.7 7.4-6.5 8.6-3.8-1.2-6.5-4.6-6.5-8.6V4.1L10 1.5z"/></svg>{{/if}}
                {{#if (eq guard "own")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path fill-rule="evenodd" d="M12.5 2a5.5 5.5 0 00-5.3 7L2.3 13.9a1 1 0 00-.3.7V17a1 1 0 001 1h2.5a1 1 0 001-1v-1h1a1 1 0 001-1v-1h1l1-1a5.5 5.5 0 102.3-11zm1 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" clip-rule="evenodd"/></svg>{{/if}}
                {{#if (eq guard "public")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.5 3.5 5.3 3.5 8.5s-1.1 6-3.5 8.5c-2.4-2.5-3.5-5.3-3.5-8.5s1.1-6 3.5-8.5z"/></svg>{{/if}}
                {{#if (eq guard "none")}}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M5 17.5V3.5a1 1 0 011-1h8a1 1 0 011 1v14M3 17.5h14"/><path d="M9 3l5 1.5v13L9 17.5z" fill="currentColor" fill-opacity=".25"/></svg>{{/if}}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-sm font-semibold leading-tight {{#if (eq tone "error")}}text-error{{/if}}">{{title}}</span>
                  <span class="text-[11px] text-base-content/50 shrink-0">{{count}}</span>
                </div>
                <div class="text-[11px] text-base-content/60 leading-tight">{{detail}}</div>
                <div class="text-[11px] text-base-content/45 leading-tight">From {{from}}</div>
              </div>
            </div>
            <div class="flex flex-wrap gap-1 mt-2">
              {{#each apps}}
                <span class="inline-flex items-center gap-1 h-6 pl-1 pr-2 rounded-full bg-base-200 text-[11px]">
                  {{#if icon}}<img src="{{icon}}" alt="" class="w-4 h-4 object-contain" loading="lazy" data-neo-icon-fallback>{{else}}<span class="w-4 h-4 rounded-full bg-base-300"></span>{{/if}}
                  {{title}}
                </span>
              {{/each}}
            </div>
            <button type="button" class="mt-2 text-[11px] link link-hover text-base-content/60" @click.stop="show('{{filter}}')">Show in the list ↓</button>
          </div>
        {{else}}
          <p class="text-xs text-base-content/55">No app has a web address yet.</p>
        {{/each}}
        <p class="lg:hidden text-xs text-base-content/55" x-show="origin && !Array.prototype.some.call($el.parentElement.querySelectorAll('[data-neo-node^=g-]'), function (e) { return reaches(e); })" x-cloak>No app opens from here.</p>
      </div>
    </div>
  </section>

  {{#if warnings}}
    <ul class="space-y-2" aria-label="Things to check">
      {{#each warnings}}
        <li class="alert {{#if (eq level "error")}}alert-error{{else}}alert-warning{{/if}} alert-soft text-sm py-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M8.49 2.86c.67-1.15 2.35-1.15 3.02 0l6.28 10.8c.67 1.16-.17 2.6-1.51 2.6H3.72c-1.34 0-2.18-1.44-1.51-2.6L8.5 2.86zM10 7a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 7zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
          <span class="flex-1">{{text}}</span>
          {{#if link}}<a class="link text-xs shrink-0" href="{{link}}" hx-get="{{link}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">{{link_label}}</a>{{/if}}
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{!-- Defaults every app follows until it is changed for that app. --}}
  <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-5 space-y-4" aria-labelledby="access-defaults-title">
    <div>
      <h3 id="access-defaults-title" class="font-semibold">Default for all apps</h3>
      <p class="text-xs text-base-content/60 mt-0.5">Every app follows these until you change it for that app below.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div>
        <div class="text-xs font-medium text-base-content/70 mb-1.5">Apps are reachable from</div>
        <div class="flex flex-wrap gap-1.5">
          {{#each defaults.places}}
            {{#> toggleForm}}
              <button type="submit" data-neo-lock="system:sh"
                      class="btn btn-sm {{#if on}}btn-primary{{else}}btn-outline{{/if}}"
                      aria-pressed="{{#if on}}true{{else}}false{{/if}}"
                      title="{{#if inactive}}{{label}} is not set up on this server{{else}}{{#if on}}Stop{{else}}Allow{{/if}} {{label}} for apps that follow the default{{/if}}">
                {{label}}{{#if inactive}}<span class="text-[10px] opacity-60 font-normal">not set up</span>{{/if}}
              </button>
            {{/toggleForm}}
          {{/each}}
        </div>
      </div>
      <div class="space-y-2">
        {{#with defaults.login}}
          {{#> toggleForm}}
            <label class="flex items-center justify-between gap-3 cursor-pointer">
              <span class="text-sm">Apps ask for login</span>
              <input type="checkbox" class="toggle toggle-primary toggle-sm" {{#if on}}checked{{/if}}
                     data-neo-lock="system:sh" aria-label="Apps ask for login">
            </label>
          {{/toggleForm}}
        {{/with}}
        {{#with defaults.sso}}
          {{#> toggleForm}}
            <label class="flex items-center justify-between gap-3 cursor-pointer">
              <span class="text-sm">Sign in to apps with your login page account
                <span class="block text-xs text-base-content/55">One account for every app that supports it, managed on the login page.</span>
              </span>
              <input type="checkbox" class="toggle toggle-primary toggle-sm" {{#if on}}checked{{/if}}
                     {{#if ../defaults.sso_blocked}}disabled title="Turn on the login page (tinyauth) first"{{/if}}
                     data-neo-lock="system:sh" aria-label="Sign in to apps with your login page account">
            </label>
          {{/toggleForm}}
        {{/with}}
      </div>
    </div>
  </section>

  {{!-- Quick filters (static/access_filter.js): narrow both lists to the
       entry points worth a look. A second click on a chip shows all again. --}}
  <nav id="access-lists" class="flex flex-wrap items-center gap-1.5 scroll-mt-24" aria-label="Quick filters">
    <span class="text-xs font-medium text-base-content/60 mr-1">Show</span>
    <button type="button" class="btn btn-xs rounded-full" :class="filter === 'all' ? 'btn-neutral' : 'btn-ghost border-base-300'"
            @click="filter = 'all'" :aria-pressed="filter === 'all'">Everything</button>
    {{#each filters}}
      <button type="button" data-neo-filter="{{id}}" title="{{help}}"
              class="btn btn-xs rounded-full gap-1.5 {{#unless apps}}{{#unless ports}}opacity-50{{/unless}}{{/unless}}"
              :class="filter === '{{id}}' ? '{{#if (eq id "risk")}}btn-error{{else}}btn-neutral{{/if}}' : 'btn-ghost border-base-300'"
              @click="pick('{{id}}')" :aria-pressed="filter === '{{id}}'">
        {{label}}
        <span class="badge badge-xs font-normal {{#if (eq id "risk")}}{{#if apps}}badge-error{{else}}{{#if ports}}badge-error{{else}}badge-ghost{{/if}}{{/if}}{{else}}{{#if (eq id "bucket-public")}}badge-info{{else}}{{#if (eq id "bucket-own")}}badge-info{{else}}badge-ghost{{/if}}{{/if}}{{/if}}">{{#if apps}}{{apps}} {{#if (eq apps 1)}}app{{else}}apps{{/if}}{{#if ports}} · {{/if}}{{/if}}{{#if ports}}{{ports}} {{#if (eq ports 1)}}port{{else}}ports{{/if}}{{/if}}{{#unless apps}}{{#unless ports}}0{{/unless}}{{/unless}}</span>
      </button>
    {{/each}}
    {{#each map.groups}}{{#unless (eq filter "bucket-public")}}{{#unless (eq filter "bucket-own")}}
      <button type="button" x-show="filter === '{{filter}}'" x-cloak class="btn btn-xs rounded-full btn-neutral gap-1" @click="filter = 'all'" title="Show everything again">
        {{title}} <span aria-hidden="true">×</span>
      </button>
    {{/unless}}{{/unless}}{{/each}}
  </nav>

  {{!-- Apps: where each one opens from → the login page → its account →
       who gets in. Every pill is a toggle that saves a settings patch. --}}
  <section class="space-y-3" aria-labelledby="access-apps-title">
    <div>
      <h3 id="access-apps-title" class="font-semibold">Apps</h3>
      <p class="text-xs text-base-content/60 mt-0.5">Click a place, the login page or the account to change it for one app.{{#unless relay}} Internet works only with a relay or when your router forwards ports 80 and 443 to this server.{{/unless}}</p>
    </div>
    {{#if apps}}
    <div class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
      <div class="hidden lg:grid lg:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)_minmax(9rem,13rem)_5.5rem] gap-4 px-4 py-2 text-[11px] font-medium uppercase tracking-wider text-base-content/50">
        <div>App</div>
        <div class="flex items-center gap-2"><span>Opens from</span><span class="flex-1 border-t border-dashed border-base-300"></span><span>Login page</span><span class="w-8 border-t border-dashed border-base-300"></span><span>Account</span></div>
        <div>Who gets in</div>
        <div></div>
      </div>
      {{#each apps}}
        <div data-neo-tags="{{tags}}" data-neo-section="apps"
             class="relative px-4 py-3 grid gap-x-4 gap-y-2 lg:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)_minmax(9rem,13rem)_5.5rem] lg:items-center {{#if risk}}bg-error/5{{/if}}">
          {{#if risk}}<span class="absolute left-0 inset-y-0 w-1 bg-error" aria-hidden="true"></span>{{/if}}
          {{#if (eq bucket "public")}}<span class="absolute left-0 inset-y-0 w-1 bg-info" aria-hidden="true" title="Public website, on purpose"></span>{{/if}}
          {{#if (eq bucket "own")}}<span class="absolute left-0 inset-y-0 w-1 bg-info" aria-hidden="true" title="The app's own login guards it"></span>{{/if}}
          {{!-- App --}}
          <div class="flex items-center gap-2.5 min-w-0">
            {{#if icon}}<img src="{{icon}}" alt="" class="w-8 h-8 shrink-0 object-contain rounded-lg" loading="lazy" data-neo-icon-fallback>
            {{else}}<span class="w-8 h-8 shrink-0 rounded-lg bg-base-200"></span>{{/if}}
            <div class="min-w-0">
              <a class="font-medium text-sm hover:underline" href="{{settings_url}}" hx-get="{{settings_url}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">{{title}}</a>
              {{#if host}}<div class="text-[11px] text-base-content/50 font-mono truncate">{{host}}</div>{{/if}}
            </div>
          </div>

          {{!-- Flow: places → login page → account --}}
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 min-w-0">
            <div class="flex flex-wrap items-center gap-1" role="group" aria-label="{{title}}: opens from">
              {{#each places}}
                {{#> toggleForm}}
                  <button type="submit" data-neo-lock="system:sh"
                          class="inline-flex items-center gap-1 h-6 px-2 rounded-full border text-[11px] font-medium transition-colors
                                 {{#if on}}{{#if danger}}bg-error/15 border-error/50 text-error{{else}}{{#if info}}bg-info/12 border-info/40 text-info{{else}}{{#if inactive}}border-base-300 text-base-content/40 bg-base-200{{else}}bg-success/12 border-success/40 text-success{{/if}}{{/if}}{{/if}}{{else}}border-dashed border-base-300 text-base-content/35 hover:text-base-content/70{{/if}}"
                          aria-pressed="{{#if on}}true{{else}}false{{/if}}"
                          aria-label="{{label}}: {{#if on}}allowed{{else}}blocked{{/if}}"
                          title="{{label}}: {{#if on}}allowed{{else}}blocked{{/if}}{{#if inactive}} (not set up){{/if}}{{#if danger}}, and no login page guards it{{/if}}. Click to change.">
                    {{> placeIcon}}<span>{{label}}</span>
                  </button>
                {{/toggleForm}}
              {{/each}}
              {{> followBadge state=places_state}}
            </div>
            <svg class="hidden sm:block w-6 h-3 shrink-0 text-base-content/30" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 6h21M17 2l4 4-4 4"/></svg>
            <div class="flex items-center gap-1">
              {{#if login}}
                {{#with login}}
                  {{#> toggleForm}}
                    <button type="submit" data-neo-lock="system:sh"
                            class="inline-flex items-center gap-1 h-6 px-2 rounded-md border text-[11px] font-medium
                                   {{#if on}}bg-base-content text-base-100 border-base-content{{else}}{{#if danger}}border-error/50 text-error bg-error/10{{else}}{{#if info}}border-info/40 text-info bg-info/10{{else}}border-dashed border-base-300 text-base-content/45{{/if}}{{/if}}{{/if}}"
                            aria-pressed="{{#if on}}true{{else}}false{{/if}}" aria-label="{{../title}}: ask for login"
                            title="{{#if on}}The login page asks for a login first. Click to turn off.{{else}}No login page in front of this app. Click to turn on.{{/if}}">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path d="M10 1.5l6.5 2.6v4.8c0 4-2.7 7.4-6.5 8.6-3.8-1.2-6.5-4.6-6.5-8.6V4.1L10 1.5z"/></svg>
                      {{#if on}}Login page{{else}}No login page{{/if}}
                    </button>
                  {{/toggleForm}}
                {{/with}}
                {{> followBadge state=login_state}}
              {{else}}
                <span class="inline-flex items-center h-6 px-2 rounded-md border text-[11px] {{#if (eq bucket "public")}}border-info/40 text-info bg-info/10{{else}}{{#if (eq bucket "own")}}border-info/40 text-info bg-info/10{{else}}border-base-300 text-base-content/50{{/if}}{{/if}}" title="This app handles its own login">{{#if (eq bucket "public")}}Public{{else}}Own login{{/if}}</span>
              {{/if}}
            </div>
            {{#if sso}}
              <svg class="hidden sm:block w-4 h-3 shrink-0 text-base-content/30" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 6h13M9 2l4 4-4 4"/></svg>
              <div class="flex items-center gap-1">
                {{#with sso}}
                  {{#> toggleForm}}
                    <button type="submit" data-neo-lock="system:sh"
                            {{#if inactive}}{{#unless on}}disabled title="Turn on the login page (tinyauth) first"{{/unless}}{{/if}}
                            class="inline-flex items-center gap-1 h-6 px-2 rounded-md border text-[11px] font-medium disabled:opacity-40
                                   {{#if on}}bg-info/15 border-info/40 text-info{{else}}border-dashed border-base-300 text-base-content/45{{/if}}"
                            aria-pressed="{{#if on}}true{{else}}false{{/if}}" aria-label="{{../title}}: sign in with the login page account"
                            {{#unless inactive}}title="{{#if on}}Signs in with the login page account. Click to turn off.{{else}}Click to sign in with the login page account.{{/if}}"{{/unless}}>
                      <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path fill-rule="evenodd" d="M12.5 2a5.5 5.5 0 00-5.3 7L2.3 13.9a1 1 0 00-.3.7V17a1 1 0 001 1h2.5a1 1 0 001-1v-1h1a1 1 0 001-1v-1h1l1-1a5.5 5.5 0 102.3-11zm1 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" clip-rule="evenodd"/></svg>
                      Account
                    </button>
                  {{/toggleForm}}
                {{/with}}
                {{> followBadge state=sso_state}}
              </div>
            {{/if}}
            {{#if public_paths}}<span class="badge badge-warning badge-soft badge-xs" title="Addresses of this app that open without login (share links, phone apps)">{{public_paths}} open paths</span>{{/if}}
          </div>

          {{!-- Who gets in --}}
          <div class="text-xs min-w-0 flex items-start gap-1.5">
            <svg viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0 mt-px {{#if risk}}text-error{{else}}text-base-content/40{{/if}}" aria-hidden="true"><path d="M10 9a3.5 3.5 0 100-7 3.5 3.5 0 000 7zm-6.5 8a6.5 6.5 0 0113 0 .5.5 0 01-.5.5H4a.5.5 0 01-.5-.5z"/></svg>
            <div class="min-w-0">
              <div class="{{#if risk}}text-error font-medium{{/if}}">{{who}}</div>
              {{#if own_login}}{{#if login.on}}<div class="text-base-content/50">then {{own_login}}</div>{{/if}}{{/if}}
            </div>
          </div>

          <div class="lg:text-right">
            {{#if any_changed}}
              <form hx-post="/access/set" hx-target="#access-page" hx-swap="outerHTML">
                <input type="hidden" name="path" value="services.{{name}}">
                <input type="hidden" name="op" value="follow">
                <button type="submit" class="btn btn-ghost btn-xs whitespace-nowrap" data-neo-lock="system:sh"
                        title="Remove what is set for this app and follow the default again">Use defaults</button>
              </form>
            {{/if}}
          </div>
        </div>
      {{/each}}
      <p data-neo-filter-empty="apps" hidden class="px-4 py-3 text-sm text-base-content/60">No app matches this filter.</p>
    </div>
    {{else}}
      <p class="rounded-box border border-dashed border-base-300 p-4 text-sm text-base-content/60">No app has a web address yet. {{#unless domain}}Set your domain in SWAG first.{{/unless}}</p>
    {{/if}}
  </section>

  {{!-- Every open port as a flow (routes/access_ports.rs): where it is reached
       from → the host firewall → the port and what protects it. Geometry is in
       percent, so the SVG stretches with the rows; no script. --}}
  {{#*inline "fwMark"}}{{#if (eq mark "check")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{{/if}}{{#if (eq mark "lock")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H5a1 1 0 00-1 1v7a1 1 0 001 1h10a1 1 0 001-1V9a1 1 0 00-1-1h-1V6a4 4 0 00-4-4zm2 6V6a2 2 0 10-4 0v2h4z" clip-rule="evenodd"/></svg>{{/if}}{{#if (eq mark "cross")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path d="M5.3 5.3a1 1 0 011.4 0L10 8.6l3.3-3.3a1 1 0 111.4 1.4L11.4 10l3.3 3.3a1 1 0 01-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 01-1.4-1.4L8.6 10 5.3 6.7a1 1 0 010-1.4z"/></svg>{{/if}}{{#if (eq mark "warn")}}<svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3" aria-hidden="true"><path fill-rule="evenodd" d="M8.49 2.86c.67-1.15 2.35-1.15 3.02 0l6.28 10.8c.67 1.16-.17 2.6-1.51 2.6H3.72c-1.34 0-2.18-1.44-1.51-2.6L8.5 2.86zM10 7a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 7zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>{{/if}}
  {{/inline}}
  <details class="group space-y-3" aria-labelledby="access-ports-title" x-effect="if (filter !== 'all') $el.open = true">
    <summary class="cursor-pointer list-none">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h3 id="access-ports-title" class="font-semibold inline-flex items-center gap-1.5"><svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-open:rotate-90" aria-hidden="true"><path fill-rule="evenodd" d="M7.2 14.8a.75.75 0 010-1.06L10.94 10 7.2 6.26a.75.75 0 111.06-1.06l4.27 4.27a.75.75 0 010 1.06l-4.27 4.27a.75.75 0 01-1.06 0z" clip-rule="evenodd"/></svg>All ports in detail</h3>
        <p class="text-xs text-base-content/60 mt-0.5">Every port one by one: where it can be reached from, what the firewall does, and what protects it.</p>
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-base-content/65" aria-label="Legend">
        <li class="flex items-center gap-1.5"><svg class="w-6 h-2 text-success" viewBox="0 0 24 4" aria-hidden="true"><path d="M0 2h24" stroke="currentColor" stroke-width="2"/></svg>Firewall lets it in</li>
        <li class="flex items-center gap-1.5"><svg class="w-6 h-2 text-info" viewBox="0 0 24 4" aria-hidden="true"><path d="M0 2h24" stroke="currentColor" stroke-width="2"/></svg>One network only</li>
        {{#if ports.any_docker}}<li class="flex items-center gap-1.5"><svg class="w-6 h-2 text-warning" viewBox="0 0 24 4" aria-hidden="true"><path d="M0 2h24" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3"/></svg>Skips the firewall (Docker)</li>{{/if}}
        {{#if ports.any_blocked}}<li class="flex items-center gap-1.5"><svg class="w-6 h-2 text-base-content/40" viewBox="0 0 24 4" aria-hidden="true"><path d="M0 2h14" stroke="currentColor" stroke-width="2"/><path d="M17 0v4" stroke="currentColor" stroke-width="2"/></svg>Blocked</li>{{/if}}
      </ul>
    </div>
    </summary>
    {{#if ports.firewall_off}}
      <div role="alert" class="alert alert-error alert-soft text-sm py-2.5">The firewall is switched off: every port below answers every network.</div>
    {{/if}}
    {{#if ports.rows}}
    <div class="rounded-box border border-base-300 bg-base-100 p-3 sm:p-4">
      <div class="relative md:mt-5 md:grid md:grid-cols-[11rem_minmax(5rem,1fr)_minmax(0,24rem)] lg:grid-cols-[12rem_minmax(6rem,1fr)_minmax(0,28rem)]">
        {{!-- Networks. --}}
        <div class="relative hidden md:block">
          {{#each ports.sources}}
            <div class="absolute inset-x-0 -translate-y-1/2" style="top: {{y}}%">
              <div class="rounded-box border border-base-300 bg-base-200/60 px-3 py-2 shadow-xs">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-7 h-7 shrink-0 rounded-lg bg-base-100 border border-base-300 flex items-center justify-center text-base-content/70">
                    {{#if (eq icon "globe")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.5 3.5 5.3 3.5 8.5s-1.1 6-3.5 8.5c-2.4-2.5-3.5-5.3-3.5-8.5s1.1-6 3.5-8.5z"/></svg>
                    {{/if}}{{#if (eq icon "server")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="6" rx="1.5"/><rect x="3.5" y="13.5" width="17" height="6" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01" stroke-linecap="round" stroke-width="2.4"/></svg>
                    {{/if}}{{#if (eq icon "address")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0113 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
                    {{/if}}{{#if (eq icon "vpn")}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-4 h-4" aria-hidden="true"><circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M8 7.2l2.8 8.6M16 7.2l-2.8 8.6M8.2 6h7.6"/></svg>{{/if}}
                  </span>
                  <div class="min-w-0">
                    <div class="text-sm font-medium leading-tight truncate">{{label}}</div>
                    <div class="text-[10px] text-base-content/55 leading-tight truncate" title="{{detail}}">{{detail}}</div>
                  </div>
                </div>
                {{#if networks}}<div class="flex flex-wrap gap-1 mt-1.5">{{#each networks}}<span class="badge badge-ghost badge-xs">{{this}}</span>{{/each}}</div>{{/if}}
              </div>
            </div>
          {{/each}}
        </div>

        {{!-- Edges and the firewall. --}}
        <div class="relative hidden md:block" aria-hidden="true">
          <svg class="absolute inset-0 w-full h-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none">
            {{#each ports.ports}}
              <path data-neo-tags="{{tags}}" data-neo-filter-mode="dim" d="{{edge}}" fill="none" stroke="currentColor" stroke-width="1.75" vector-effect="non-scaling-stroke"
                    class="{{tone}}" {{#if dashed}}stroke-dasharray="5 4"{{/if}}/>
            {{/each}}
          </svg>
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-1.5 rounded-full bg-base-300"></div>
          <div class="absolute left-1/2 -translate-x-1/2 -top-1 -translate-y-full text-[10px] font-medium uppercase tracking-wider text-base-content/50 whitespace-nowrap">Firewall</div>
          {{#each ports.ports}}
            <span data-neo-tags="{{tags}}" data-neo-filter-mode="dim" class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-base-100 border-2 border-current flex items-center justify-center {{tone}}"
                  style="top: {{cross_y}}%" title="{{port}}: {{firewall_label}}">{{> fwMark}}</span>
          {{/each}}
        </div>

        {{!-- Ports. --}}
        <ul class="space-y-2 md:space-y-0 md:pt-0" aria-label="Open ports">
          {{#each ports.ports}}
            <li data-neo-tags="{{tags}}" data-neo-section="ports" data-neo-filter-mode="dim" class="md:h-20 md:flex md:items-center transition-opacity">
              <div class="w-full rounded-box border {{#if described}}border-base-300{{else}}border-warning{{/if}} bg-base-100 px-3 py-2 flex items-center gap-3 min-w-0">
                <div class="shrink-0 w-14 text-center">
                  <div class="font-mono text-sm font-semibold leading-none">{{port}}</div>
                  <div class="text-[10px] text-base-content/50 mt-0.5">{{protocol}}</div>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-1.5 min-w-0">
                    <span class="text-sm truncate" title="{{label}}">{{label}}</span>
                    {{#if service}}<a class="text-[11px] link link-hover text-base-content/55 shrink-0" href="{{service_url}}" hx-get="{{service_url}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">{{service}}</a>{{/if}}
                  </div>
                  <div class="flex items-center gap-1.5 mt-0.5 min-w-0 text-[11px]">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 shrink-0 text-base-content/45" aria-hidden="true"><path d="M10 1.5l6.5 2.6v4.8c0 4-2.7 7.4-6.5 8.6-3.8-1.2-6.5-4.6-6.5-8.6V4.1L10 1.5z"/></svg>
                    <span class="truncate {{#if described}}text-base-content/65{{else}}text-warning{{/if}}" title="Protected by: {{login}}">{{login}}</span>
                    {{#if open}}<span class="badge badge-ghost badge-xs shrink-0" title="Anyone who reaches it may use it, on purpose">public by design</span>{{/if}}
                  </div>
                  <div class="flex flex-wrap items-center gap-1 mt-1">
                    <span class="badge badge-soft badge-xs gap-1 {{chip}}" title="{{firewall_help}}">{{> fwMark}}{{firewall_label}}</span>
                    <span class="badge badge-ghost badge-xs md:hidden">{{scope}}</span>
                  </div>
                </div>
              </div>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
    <p data-neo-filter-empty="ports" hidden class="text-xs text-base-content/60">No port matches this filter.</p>
    {{else}}
      <p class="rounded-box border border-dashed border-base-300 p-4 text-sm text-base-content/60">No open ports.</p>
    {{/if}}
  </details>

  {{!-- The server's own logins. --}}
  <section class="space-y-3" aria-labelledby="access-logins-title">
    <h3 id="access-logins-title" class="font-semibold">Logins</h3>
    <div class="grid gap-3 md:grid-cols-2">
      <div class="rounded-box border border-base-300 bg-base-100 p-4 space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="font-semibold text-sm">SSH</div>
            <div class="text-xs text-base-content/60">Users {{#each ssh.users}}<span class="font-mono">{{this}}</span>{{#unless @last}} and {{/unless}}{{/each}} on port {{#each ssh.ports}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}.</div>
          </div>
          <a class="btn btn-ghost btn-xs" href="{{ssh_keys_url}}" hx-get="{{ssh_keys_url}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">Manage keys</a>
        </div>
        <ul class="space-y-1.5">
          {{#each ssh_keys}}
            <li class="flex items-center gap-2 text-xs">
              <span class="badge badge-ghost badge-xs font-mono">{{kind}}</span>
              <span class="flex-1 min-w-0 truncate">{{#if comment}}{{comment}}{{else}}<span class="text-base-content/50">no name</span>{{/if}}</span>
              <span class="font-mono text-base-content/45" title="Last characters of the key">…{{tail}}</span>
            </li>
          {{else}}
            <li class="text-xs text-warning">No SSH key: anyone with the password can try to log in.</li>
          {{/each}}
        </ul>
        <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-xs">
          <dt class="text-base-content/55">Password over SSH</dt><dd>{{#if ssh.password_login}}<span class="text-warning">On</span>{{else}}Off (keys only){{/if}}</dd>
          <dt class="text-base-content/55">Console password</dt><dd>{{#if ssh.console_password}}Set{{else}}Not set{{/if}} · <a class="link link-hover" href="{{console_password_url}}" hx-get="{{console_password_url}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">change</a></dd>
          <dt class="text-base-content/55">NetBird SSH</dt><dd>{{#if ssh.netbird_ssh}}On{{else}}Off{{/if}}</dd>
        </dl>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-4 space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="font-semibold text-sm">Login page</div>
            <div class="text-xs text-base-content/60">{{#if login_page.enabled}}One login for your apps{{#if login_page.url}} at <span class="font-mono">{{login_page.url}}</span>{{/if}}.{{else}}Off: apps that ask for login cannot open.{{/if}}</div>
          </div>
          <a class="btn btn-ghost btn-xs" href="{{login_page_settings_url}}" hx-get="{{login_page_settings_url}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true">Manage users</a>
        </div>
        <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-xs">
          <dt class="text-base-content/55">Users</dt>
          <dd>{{#each login_page.users}}<span class="font-mono">{{this}}</span>{{#unless @last}}, {{/unless}}{{else}}<span class="text-base-content/50">None yet</span>{{/each}}</dd>
          <dt class="text-base-content/55">Outside accounts</dt>
          <dd>{{#each login_page.providers}}{{this}}{{#unless @last}}, {{/unless}}{{else}}<span class="text-base-content/50">None</span>{{/each}}</dd>
          {{#if login_page.groups}}
            <dt class="text-base-content/55">Allowed groups</dt>
            <dd>{{#each login_page.groups}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd>
          {{/if}}
          <dt class="text-base-content/55">Apps signing in with it</dt>
          <dd>{{#each login_page.oidc_apps}}{{this}}{{#unless @last}}, {{/unless}}{{else}}<span class="text-base-content/50">None</span>{{/each}}</dd>
        </dl>
      </div>
    </div>
  </section>
</div>
