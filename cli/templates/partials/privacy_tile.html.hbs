{{!-- One privacy map tile (inside x-data with sel / pick). --}}
<button type="button" @click="pick('{{id}}')"
        class="neo-privacy-tile group flex flex-col items-start gap-1.5 rounded-box border p-2.5 text-left transition-[border-color,box-shadow] {{#if home}}border-success/30 bg-base-100{{else}}border-base-300 bg-base-100{{/if}} hover:border-primary/50 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-primary"
        :class="sel === '{{id}}' ? 'ring-2 ring-primary border-primary/50' : ''"
        :aria-pressed="sel === '{{id}}'">
  <span class="w-8 h-8 rounded-lg flex items-center justify-center {{#if home}}bg-success/15 text-success{{else}}bg-base-200 text-base-content/70{{/if}}">
    {{> options/group_icon icon=icon tint=icon_tint}}
  </span>
  <span class="text-sm font-medium leading-tight">{{label}}</span>
  <span class="text-[11px] text-base-content/55 leading-tight">
    {{#if home}}{{#each services}}{{#if enabled}}{{name}} {{/if}}{{/each}}{{else}}{{#if services}}{{len services}} app{{#if (gt (len services) 1)}}s{{/if}} can help{{else}}No app yet{{/if}}{{/if}}
  </span>
</button>
