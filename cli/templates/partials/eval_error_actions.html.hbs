{{!-- Repair / Update / Reload below an evaluation error. Needs can_store_repair and
     can_flake_update from the context; output opens in the shared changes dialog.
     Params: size, reload_size (button classes), repair_label, update_label,
     repair_confirm, update_confirm. --}}
{{#if can_store_repair}}
  <button type="button"
          class="btn {{size}} btn-warning"
          hx-post="/nix/repair" data-neo-lock="system"
          hx-target="#changes-body"
          hx-swap="innerHTML"
          hx-confirm="{{repair_confirm}}"
          hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Nix store repair')">
    {{repair_label}}
  </button>
{{/if}}
{{#if can_flake_update}}
  <button type="button"
          class="btn {{size}} btn-info"
          hx-post="/flake/update" data-neo-lock="system"
          hx-target="#changes-body"
          hx-swap="innerHTML"
          hx-confirm="{{update_confirm}}"
          hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Update')">
    {{update_label}}
  </button>
{{/if}}
<button class="btn {{reload_size}} btn-ghost" onclick="location.reload()">Reload</button>
