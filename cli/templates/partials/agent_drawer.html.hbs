{{!-- Assistant chat drawer (static/agent_chat.js). Opened by any element with
     data-neo-agent="<context>"; hidden until then. Each open starts a new chat;
     "Chats" lists past ones (#neo-agent-history replaces the log meanwhile).
     Params: placeholder, refs_label (what @ mentions; default apps, settings, guides). --}}
<aside id="neo-agent" class="hidden neo-agent fixed z-50 inset-0 sm:inset-auto sm:top-3 sm:bottom-3 sm:right-3 sm:w-[26rem] flex flex-col bg-base-100 sm:rounded-box border border-base-300 shadow-2xl"
       role="dialog" aria-label="Assistant chat">
  <div class="flex items-center gap-1.5 px-3 py-2.5 border-b border-base-300 shrink-0">
    <span class="w-7 h-7 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0 mr-0.5" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M4 5.5A1.5 1.5 0 015.5 4h13A1.5 1.5 0 0120 5.5v9a1.5 1.5 0 01-1.5 1.5H10l-4 4v-4H5.5A1.5 1.5 0 014 14.5z"/></svg>
    </span>
    <h2 id="neo-agent-title" class="font-semibold text-sm min-w-0 flex-1 truncate">Assistant</h2>
    <button id="neo-agent-chats" type="button" class="btn btn-ghost btn-xs gap-1" onclick="NeoAgent.history()"
            aria-pressed="false" title="Past chats">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd"/></svg>
      Chats
    </button>
    <button id="neo-agent-new" type="button" class="btn btn-ghost btn-xs" onclick="NeoAgent.newChat()" title="Start a new chat">New chat</button>
    <button type="button" class="btn btn-ghost btn-sm btn-square" onclick="NeoAgent.close()" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
    </button>
  </div>
  <div id="neo-agent-log" class="flex-1 min-h-0 overflow-y-auto px-3 py-3 space-y-2.5" aria-live="polite"></div>
  <div id="neo-agent-history" class="hidden flex-1 min-h-0 overflow-y-auto px-3 py-3" aria-label="Past chats"></div>
  {{!-- Turn status (phase, elapsed time, current tool): agent_chat.js paintStatus(). --}}
  <div id="neo-agent-status" class="neo-agent-status hidden" data-phase="idle">
    <span class="neo-agent-status-icon" aria-hidden="true"></span>
    <span id="neo-agent-status-text" class="min-w-0 flex-1 truncate"></span>
  </div>
  <form id="neo-agent-form" class="relative border-t border-base-300 p-2.5 flex items-end gap-2 shrink-0">
    {{!-- @ references popup: filled by refPicker() in agent_chat.js. --}}
    <div id="neo-agent-refs" class="neo-agent-refs hidden" role="listbox" aria-label="{{#if refs_label}}{{refs_label}}{{else}}Apps, settings and guides{{/if}} to mention"></div>
    <textarea id="neo-agent-input" rows="2" class="textarea textarea-sm flex-1 resize-none min-h-0 leading-snug"
              placeholder="{{#if placeholder}}{{placeholder}}{{else}}Ask the assistant… Type @ to mention an app, setting or guide.{{/if}}" aria-label="Message"></textarea>
    <button id="neo-agent-send" type="submit" class="btn btn-sm btn-primary">Send</button>
    <button id="neo-agent-stop" type="button" class="btn btn-sm hidden" onclick="NeoAgent.stop()">Stop</button>
  </form>
</aside>
