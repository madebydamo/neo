<html>
  <head>
    <title>neo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" />
    <link rel="stylesheet" href="/static/neo.css" />
  </head>
  <body class="bg-base-300 text-base-content h-dvh min-h-dvh h-screen overflow-hidden overscroll-none" data-theme="dark">
    <div class="flex h-full">
      <!-- Slim icon sidebar (icon-bar style) -->
      <div class="w-16 bg-base-200 border-r border-base-300 flex flex-col items-center py-2 gap-y-1 overflow-y-auto flex-shrink-0">
        <!-- Logo / home -->
        <div class="w-12 h-10 flex items-center justify-center mb-1" title="neo homeserver">
          <img src="/static/neo-icon.png" class="w-8 h-8 object-contain rounded" alt="neo">
        </div>

        <div class="w-8 border-t border-base-300 my-1"></div>

        <!-- Proxied services -->
        {{#each services}}
          <button
            class="nav-btn svc-btn w-12 h-10 rounded-xl flex items-center justify-center text-base-content/80 hover:text-base-content"
            title="{{name}} (https://{{subdomain}}.{{domain}})"
            data-sub="{{subdomain}}"
            data-name="{{name}}"
            onclick="handleSidebarClick(event, '{{subdomain}}', '{{domain}}', this)">
            <div class="relative w-8 h-8 flex items-center justify-center">
              {{#if icon}}
                <img src="{{icon}}" class="w-8 h-8 object-contain" alt=""
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <span class="hidden text-3xl leading-none">⚙</span>
              {{else}}
                <span class="text-3xl leading-none">⚙</span>
              {{/if}}
              <span class="absolute -bottom-px -right-px text-[7px] font-black bg-base-100 text-base-content px-0.5 leading-none rounded-sm ring-1 ring-base-300/70 font-mono">
                {{initials}}
              </span>
            </div>
          </button>
        {{/each}}

        {{#unless services}}
          <div class="text-[10px] opacity-40 text-center px-1 mt-2">No<br>proxied<br>services</div>
        {{/unless}}

        <!-- Config editor (loads inside this view, keeps the navigator visible) -->
        <div class="w-8 border-t border-base-300 my-1"></div>
        <button
          id="config-btn"
          class="nav-btn w-12 h-10 rounded-xl flex flex-col items-center justify-center text-base-content/80 hover:text-base-content"
          title="Configuration editor (loads inside the viewer pane)"
          onclick="handleSidebarClick(event, '__config', '', this)">
          <span class="text-lg leading-none">⚙</span>
          <span class="font-mono text-[8px] leading-none opacity-70">cfg</span>
        </button>
      </div>

      <!-- Main viewer area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <div class="h-8 bg-base-100 border-b border-base-300 flex items-center px-3 text-xs flex-shrink-0">
          <span class="font-semibold">neo</span>
          <span class="ml-1.5 opacity-50">navigator</span>
          <div class="ml-auto flex items-center gap-2 text-[10px]">
            <span id="current-url" class="opacity-60 font-mono truncate max-w-[50vw]"></span>
            <button onclick="reloadFrame()" class="btn btn-ghost btn-xs px-2" title="Soft reload current app">↻</button>
            <button onclick="hardResetCurrent()" class="btn btn-ghost btn-xs px-2" title="Hard reset this app (unload from memory + fresh load)">⟲</button>
            <button onclick="openInNewTab()" class="btn btn-ghost btn-xs px-2" title="Open in new tab">↗</button>
          </div>
        </div>

        <!-- Multi-iframe host (one iframe per service, shown/hidden to avoid reloads on switch) -->
        <div class="flex-1 relative bg-base-300 overflow-hidden" id="viewer-wrap">
          <!-- Dynamically populated with per-service <iframe> elements (absolute, inset-0) -->
          <div id="viewer-host" class="absolute inset-0 overflow-hidden"></div>

          <!-- Welcome / empty state overlay (hidden when any service is shown) -->
          <div id="welcome" class="absolute inset-0 overflow-hidden flex items-center justify-center bg-base-300/95">
            <div class="text-center max-w-xs px-4">
              <img src="/static/neo-icon.png" class="w-12 h-12 mx-auto mb-3 opacity-30 object-contain rounded" alt="neo">
              <div class="font-semibold mb-1">Select a service</div>
              <p class="text-xs opacity-60">Click an icon on the left to load its web UI in this view. The ⚙ cfg button loads the full configuration editor inside the pane (navigator stays visible).</p>
              {{#if domain}}
                <p class="text-[10px] opacity-40 mt-3 font-mono">Base domain: {{domain}}</p>
              {{else}}
                <p class="text-[10px] text-warning mt-3">No swag.domain configured — set it to enable links.</p>
              {{/if}}
            </div>
          </div>

          <!-- Embedding blocked state (for services with X-Frame-Options / frame-ancestors, e.g. the "neo" admin UI itself) -->
          <div id="embedding-blocked" class="absolute inset-0 overflow-hidden hidden flex items-center justify-center bg-base-300/95 p-4">
            <div class="card bg-base-100 shadow max-w-md w-full">
              <div class="card-body">
                <h3 class="card-title text-warning text-base">Embedding blocked by the service</h3>
                <p class="text-sm">This service sets <span class="font-mono">X-Frame-Options</span> or <span class="font-mono">CSP frame-ancestors</span> to protect against clickjacking.</p>
                <p class="text-xs opacity-70 mt-1">Common for admin/sensitive interfaces (including neo itself).</p>

                <div class="mt-3 flex flex-wrap gap-2">
                  <button onclick="openBlockedInNewTab()" class="btn btn-primary btn-sm flex-1">Open in new tab ↗</button>
                  <button onclick="copyBlockedUrl()" class="btn btn-ghost btn-sm">Copy URL</button>
                </div>
                <div class="text-[10px] opacity-50 mt-2 font-mono break-all" id="blocked-url"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom status -->
        <div class="h-5 bg-base-100 border-t border-base-300 text-[10px] px-2 flex items-center text-base-content/50 flex-shrink-0">
          <span id="status">Ready</span>
          <span class="ml-auto opacity-30">iframe · https only</span>
        </div>
      </div>
    </div>

    <script src="/static/neo.js"></script>
  </body>
</html>
