<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>neo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
    {{!-- Standalone / home-screen: hide browser chrome (address/search bar) --}}
    {{!-- Android / Chromium + legacy --}}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="neo">
    {{!-- iOS Safari "Add to Home Screen" (standalone window; still needed alongside the manifest) --}}
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="neo">
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#1d232a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#f2f2f2" media="(prefers-color-scheme: light)">
    <meta name="color-scheme" content="dark light">
    {{!--
      Seerr-compatible install surface:
      - root /site.webmanifest with application/manifest+json (see pages::site_webmanifest)
      - crossorigin=use-credentials: default manifest fetch omits cookies; behind tinyauth that
        yields a login 302 HTML page and standalone install never activates.
      - manifest + icons are also on auth.publicPaths so uncredentialed fetches still work.
    --}}
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials">
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/favicon/icon-192.png">
    <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png">

    <link rel="stylesheet" href="/static/neo-ui.css" />
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <link rel="stylesheet" href="/static/neo.css" />
  </head>
  <body class="bg-base-300 text-base-content h-dvh min-h-dvh overflow-hidden overscroll-none" data-theme="light">
    <div id="nav-error" class="hidden"></div>
    <div class="flex h-full relative">
      <!-- Mobile backdrop (closes drawer when tapped) -->
      <div id="sidebar-backdrop"
           class="fixed inset-0 z-40 bg-black/40 hidden md:hidden"
           onclick="closeSidebar()"
           aria-hidden="true"></div>

      <!-- Slim icon sidebar: always visible on md+, off-canvas drawer on mobile -->
      <aside id="sidebar"
             class="fixed md:static inset-y-0 left-0 z-50 w-16 bg-base-200 border-r border-base-content/10 flex flex-col items-center pt-2 pb-3 gap-y-1 overflow-y-auto flex-shrink-0 h-dvh -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out shadow-lg md:shadow-none"
             data-open="false"
             aria-label="Services">
        <div id="nav-services"
             hx-get="/nav-services"
             hx-trigger="load"
             hx-swap="innerHTML"
             class="flex flex-col items-center gap-y-1.5 w-full">
          <span class="loading loading-spinner loading-xs opacity-40 mt-2" title="Loading services…"></span>
        </div>
        {{!-- Shown by sidebar_layout.js once this browser has a custom order. --}}
        <button type="button" id="sidebar-reset"
                class="hidden mt-auto pt-3 btn btn-ghost btn-xs btn-square opacity-40 hover:opacity-100"
                title="Reset sidebar order and groups" aria-label="Reset sidebar order and groups">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 102.2-5.3M4.5 4.5v4h4"/></svg>
        </button>
      </aside>

      <!-- Main viewer area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <div class="h-10 bg-base-100 border-b border-base-content/10 flex items-center gap-1 px-1.5 sm:px-2 text-xs flex-shrink-0">
          <button type="button"
                  id="sidebar-toggle"
                  class="btn btn-ghost btn-sm btn-square md:hidden"
                  onclick="toggleSidebar()"
                  aria-label="Toggle services menu"
                  aria-controls="sidebar"
                  aria-expanded="false"
                  title="Services">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M2.5 5.25A.75.75 0 013.25 4.5h13.5a.75.75 0 010 1.5H3.25a.75.75 0 01-.75-.75zm0 4.75a.75.75 0 01.75-.75h13.5a.75.75 0 010 1.5H3.25A.75.75 0 012.5 10zm.75 4a.75.75 0 000 1.5h13.5a.75.75 0 000-1.5H3.25z" clip-rule="evenodd"/></svg>
          </button>
          <div class="min-w-0 flex-1 flex items-center">
            <div class="neo-url-pill is-empty min-w-0 max-w-full md:max-w-xl flex items-center gap-1.5 h-7 px-2.5 rounded-field bg-base-200 text-base-content/70">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 shrink-0 opacity-50" aria-hidden="true"><path fill-rule="evenodd" d="M10 1.5a4 4 0 00-4 4V8H5a1.5 1.5 0 00-1.5 1.5v7A1.5 1.5 0 005 18h10a1.5 1.5 0 001.5-1.5v-7A1.5 1.5 0 0015 8h-1V5.5a4 4 0 00-4-4zm2.5 6.5V5.5a2.5 2.5 0 00-5 0V8h5z" clip-rule="evenodd"/></svg>
              {{!-- readonly (not disabled) so it stays focusable/tappable; neo.js selects
                   the whole value on focus/click so the native copy pop-up appears
                   (important on iOS/Android, where a plain <span> can't be selected as easily). --}}
              <input id="current-url" type="text" readonly spellcheck="false"
                     class="font-mono text-[11px] truncate bg-transparent border-0 outline-none p-0 m-0 w-full cursor-pointer focus:cursor-text"
                     aria-label="Current service URL — tap to select and copy" />
            </div>
          </div>
          <div class="flex items-center gap-0.5 flex-shrink-0">
            <button onclick="reloadFrame()" class="btn btn-ghost btn-sm btn-square" title="Soft reload current app" aria-label="Reload">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M19.5 12a7.5 7.5 0 11-2.2-5.3M19.5 4.5v4h-4"/></svg>
            </button>
            <button onclick="hardResetCurrent()" class="btn btn-ghost btn-sm btn-square" title="Hard reset this app (unload from memory + fresh load)" aria-label="Hard reset">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M12 3v6M6.3 6.3a8 8 0 1011.4 0"/></svg>
            </button>
            <button onclick="openInNewTab()" class="btn btn-ghost btn-sm btn-square" title="Open in new tab" aria-label="Open in new tab">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M13.5 4.5h6v6M19.5 4.5L11 13M17 14v4.5a1.5 1.5 0 01-1.5 1.5h-10A1.5 1.5 0 014 18.5v-10A1.5 1.5 0 015.5 7H10"/></svg>
            </button>
          </div>
        </div>

        <!-- Multi-iframe host (one iframe per service, shown/hidden to avoid reloads on switch) -->
        <div class="flex-1 relative bg-base-300 overflow-hidden" id="viewer-wrap">
          <!-- Dynamically populated with per-service <iframe> elements (absolute, inset-0) -->
          <div id="viewer-host" class="absolute inset-0 overflow-hidden"></div>

          <!-- Welcome / empty state overlay (hidden when any service is shown) -->
          <div id="welcome" class="absolute inset-0 overflow-hidden flex items-center justify-center bg-base-300 p-4">
            <div class="text-center max-w-sm">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-base-100 border border-base-content/10 shadow-sm flex items-center justify-center">
                <img src="/static/neo-icon.png" class="w-10 h-10 object-contain" alt="neo">
              </div>
              <div class="text-lg font-semibold tracking-tight">Pick a service</div>
              <p class="text-sm text-base-content/60 mt-1 md:hidden">Open the menu and choose a service to load its web UI here.</p>
              <p class="text-sm text-base-content/60 mt-1 hidden md:block">Choose a service on the left to load its web UI here.</p>
              <p class="text-xs text-base-content/45 mt-3">Drag icons to reorder them, drop one on another to make a group. <span class="md:hidden">Touch and hold to start dragging.</span> Saved in this browser.</p>
              <p id="welcome-domain" class="text-[11px] text-base-content/40 mt-4">Loading domain…</p>
            </div>
          </div>

          <!-- Embedding blocked state (for services with X-Frame-Options / frame-ancestors, e.g. the "neo" admin UI itself) -->
          <div id="embedding-blocked" class="absolute inset-0 overflow-hidden hidden flex items-center justify-center bg-base-300 p-4">
            <div class="rounded-box bg-base-100 border border-base-content/10 shadow-sm max-w-md w-full p-5 sm:p-6">
              <div class="flex items-start gap-3">
                <span class="w-10 h-10 shrink-0 rounded-xl bg-warning/15 text-warning flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8.2-7.5 9.5-4.3-1.3-7.5-5-7.5-9.5V6L12 3z"/></svg>
                </span>
                <div class="min-w-0">
                  <h3 class="font-semibold">This app can't be embedded</h3>
                  <p class="text-sm text-base-content/70 mt-1">The service blocks being shown inside another page to protect against clickjacking — common for admin interfaces.</p>
                </div>
              </div>
              <div class="text-[11px] text-base-content/50 mt-4 font-mono break-all rounded-field bg-base-200 px-2.5 py-1.5" id="blocked-url"></div>
              <div class="mt-4 flex flex-wrap gap-2">
                <button onclick="openBlockedInNewTab()" class="btn btn-primary btn-sm flex-1">Open in new tab ↗</button>
                <button onclick="copyBlockedUrl()" class="btn btn-ghost btn-sm">Copy URL</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {{!-- Store repair / update progress from the nav error banner (static/op_monitor.js). --}}
    <dialog id="changes-modal" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box neo-changes-modal-box max-w-4xl p-0 flex flex-col w-full">
        <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-base-300 shrink-0">
          <h3 id="changes-modal-title" class="font-semibold text-lg min-w-0 truncate">Nix store repair</h3>
          <form method="dialog">
            <button type="submit" class="btn btn-sm btn-ghost btn-square" aria-label="Close">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
            </button>
          </form>
        </div>
        <div id="changes-body" class="px-4 sm:px-6 py-4 min-h-0 flex-1 overflow-auto"></div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    {{!-- Sidebar group rename / ungroup and layout reset (static/sidebar_layout.js). --}}
    <dialog id="sidebar-group-dialog" class="modal modal-bottom sm:modal-middle">
      <form method="dialog" class="modal-box max-w-sm">
        <h3 class="font-semibold text-lg">Group</h3>
        <label class="form-control w-full mt-3">
          <span class="label-text text-sm mb-1">Name</span>
          <input name="name" type="text" maxlength="40" autocomplete="off" class="input input-bordered w-full" />
        </label>
        <div class="modal-action flex-wrap">
          <button type="submit" value="ungroup" class="btn btn-ghost btn-sm mr-auto">Ungroup</button>
          <button type="submit" value="cancel" class="btn btn-ghost btn-sm" formnovalidate>Cancel</button>
          <button type="submit" value="save" class="btn btn-primary btn-sm">Save</button>
        </div>
      </form>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
    <dialog id="sidebar-reset-dialog" class="modal modal-bottom sm:modal-middle">
      <form method="dialog" class="modal-box max-w-sm">
        <h3 class="font-semibold text-lg">Reset the sidebar?</h3>
        <p class="text-sm text-base-content/70 mt-2">Your order and groups in this browser are removed and the default order comes back.</p>
        <div class="modal-action">
          <button type="submit" value="cancel" class="btn btn-ghost btn-sm">Cancel</button>
          <button type="submit" value="reset" class="btn btn-warning btn-sm">Reset</button>
        </div>
      </form>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <script src="/static/service_status.js"></script>
    <script src="/static/sidebar_layout.js"></script>
    <script src="/static/op_monitor.js"></script>
    <script src="/static/neo.js"></script>
  </body>
</html>
