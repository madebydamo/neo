<html>
  <head>
    <title>neo web</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" />
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>
  </head>
  <body class="bg-base-300 text-base-content p-6" data-theme="dark">
    <div class="max-w-7xl mx-auto">
      <div class="navbar bg-base-100 rounded-box mb-6 shadow">
        <div class="flex-1">
          <span class="text-2xl font-bold px-4">neo</span>
          <span class="text-sm opacity-60">homeserver config</span>
        </div>
        <div class="flex-none text-xs opacity-50 pr-4">
          DaisyUI + Tailwind + HTMX + Alpine (dev CDNs)
        </div>
      </div>

      <div class="flex gap-6">
        <div class="w-5/12">
          <div class="card bg-base-100 shadow">
            <div class="card-body p-0">
              <div class="overflow-x-auto">
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Service</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each services}}
                      <tr class="hover cursor-pointer"
                          hx-get="/option/{{name}}"
                          hx-target="#options-pane"
                          hx-swap="outerHTML">
                        <td class="font-mono">{{name}}</td>
                        <td>
                          {{#if enabled}}
                            <span class="badge badge-success badge-sm">enabled</span>
                          {{else}}
                            <span class="badge badge-ghost badge-sm">disabled</span>
                          {{/if}}
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <p class="text-xs opacity-40 mt-2 px-1">Click a service to load its typed options.</p>
        </div>

        <div id="options-pane" class="w-7/12">
          <div class="card bg-base-100 shadow h-full">
            <div class="card-body text-base-content/60">
              Select a service on the left to edit its configuration.
            </div>
          </div>
        </div>
      </div>

      <p class="mt-6 text-[10px] opacity-30">
        Rocket + Handlebars + HTMX + Alpine + DaisyUI (CDN). Phase 2 forms (type-driven inputs + reset-to-default).
      </p>
    </div>

    <script>
      document.documentElement.setAttribute('data-theme', 'dark');
    </script>

    <script>
      function optionForm() {
        return {
          values: {},
          defaults: {},
          originals: {},
          hadCurrent: {},
          isOpen: {},

          initForm() {
            const raw = document.getElementById('options-seed')?.textContent || '[]';
            let opts = [];
            try { opts = JSON.parse(raw); } catch (e) { opts = []; }

            opts.forEach(o => {
              const hasCurrent = (o.current !== undefined && o.current !== null);
              let v = hasCurrent ? o.current : o.default;
              if (Array.isArray(v)) v = [...v];
              else if (v && typeof v === 'object') v = {...v};
              this.values[o.name] = v;
              this.defaults[o.name] = o.default;
              this.originals[o.name] = (Array.isArray(v) ? [...v] : (v && typeof v === 'object' ? {...v} : v));
              this.hadCurrent[o.name] = hasCurrent;
            });

            // Discover direct submodule sections for collapsible headers
            opts.forEach(o => {
              if (o.type && o.type.kind === 'submodule') {
                this.isOpen[o.name] = true;
              }
            });
          },

          resetField(name) {
            this.values[name] = this.defaults[name];
            if (Array.isArray(this.values[name])) this.values[name] = [...this.values[name]];
            else if (this.values[name] && typeof this.values[name] === 'object') this.values[name] = {...this.values[name]};
          },

          revertField(name) {
            if (!name) return;
            const origs = this.originals || {};
            if (!origs[name]) return;
            let v = origs[name];
            if (Array.isArray(v)) v = [...v];
            else if (v && typeof v === 'object' && v !== null) v = {...v};
            const vals = this.values || {};
            vals[name] = v;
          },

          resetAll() {
            Object.keys(this.defaults).forEach(k => {
              this.values[k] = this.defaults[k];
              if (Array.isArray(this.values[k])) this.values[k] = [...this.values[k]];
              else if (this.values[k] && typeof this.values[k] === 'object') this.values[k] = {...this.values[k]};
            });
          },

          toggleSubmodule(name) {
            if (name in this.isOpen) this.isOpen[name] = !this.isOpen[name];
          },

          shouldShowField(name) {
            if (!name || !name.includes('.')) return true;
            for (const p in this.isOpen) {
              if ((name === p || name.startsWith(p + '.')) && !this.isOpen[p]) {
                return false;
              }
            }
            return true;
          },

          resetSubtree(prefix) {
            Object.keys(this.defaults).forEach(k => {
              if (k === prefix || k.startsWith(prefix + '.')) {
                this.values[k] = this.defaults[k];
                if (Array.isArray(this.values[k])) this.values[k] = [...this.values[k]];
                else if (this.values[k] && typeof this.values[k] === 'object') this.values[k] = {...this.values[k]};
              }
            });
          },

          deepEqual(a, b) {
            try { return JSON.stringify(a) === JSON.stringify(b); } catch (_) { return false; }
          },

          isAtDefault(name) {
            if (!name) return true;
            const vals = this.values || {};
            const defs = this.defaults || {};
            return this.deepEqual(vals[name], defs[name]);
          },

          isAtOriginal(name) {
            if (!name) return true;
            const vals = this.values || {};
            const origs = this.originals || {};
            return this.deepEqual(vals[name], origs[name]);
          },

          sourceLabel(name) {
            if (!name) return '';
            // Show "default" when the value equals the declared default (whether it came via current or not).
            // Show "modified" when it differs from the default.
            return this.isAtDefault(name) ? 'default' : 'modified';
          },

          isExplicitEmpty(name) {
            if (!name) return false;
            const vals = this.values || {};
            const v = vals[name];
            if (v === '') return true;
            if (Array.isArray(v)) return v.length === 0;
            if (v && typeof v === 'object' && v !== null) return Object.keys(v).length === 0;
            return false;
          },

          addListItem(name) {
            if (!Array.isArray(this.values[name])) this.values[name] = [];
            this.values[name].push('');
          },

          removeListItem(name, idx) {
            if (Array.isArray(this.values[name])) this.values[name].splice(idx, 1);
          },

          addAttrItem(name, inputEl) {
            if (!this.values[name] || typeof this.values[name] !== 'object') this.values[name] = {};
            const key = inputEl?.value?.trim();
            if (key && !this.values[name].hasOwnProperty(key)) {
              this.values[name][key] = '';
              if (inputEl) inputEl.value = '';
            }
          },

          removeAttrItem(name, key) {
            if (this.values[name] && typeof this.values[name] === 'object') {
              delete this.values[name][key];
            }
          },

          logState() {
            const svc = this.$el?.dataset?.service || this.$el?.querySelector('h2')?.textContent?.trim() || 'service';
            console.log('Current edited state for ' + svc, this.values);
          },

          copyJson() {
            const txt = JSON.stringify(this.values, null, 2);
            navigator.clipboard?.writeText(txt).then(() => {
              const orig = event?.target?.innerText;
              if (event?.target) event.target.innerText = 'Copied!';
              setTimeout(() => { if (event?.target) event.target.innerText = orig || 'Copy JSON'; }, 1200);
            }).catch(() => alert(txt));
          }
        }
      }

      // Ensure Alpine picks up x-data etc. after HTMX outerHTML swaps of the options pane.
      document.addEventListener('htmx:afterSettle', () => {
        const pane = document.getElementById('options-pane');
        if (pane && pane.hasAttribute('x-data') && typeof Alpine !== 'undefined') {
          Alpine.initTree(pane);
        }
      });
    </script>
  </body>
</html>
