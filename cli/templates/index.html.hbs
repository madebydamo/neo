<html>
  <head>
    <title>neo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
    {{!-- Standalone / home-screen: hide browser chrome (address/search bar) --}}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="neo">
    <meta name="theme-color" content="#1d232a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#f2f2f2" media="(prefers-color-scheme: light)">
    <meta name="application-name" content="neo">
    <link rel="manifest" href="/static/manifest.webmanifest">
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png">

    <link rel="stylesheet" href="/static/neo-ui.css" />
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <link rel="stylesheet" href="/static/neo.css" />
  </head>
  <body class="bg-base-300 text-base-content h-dvh min-h-dvh overflow-hidden overscroll-none" data-theme="lofi">
    <div id="nav-error" class="hidden"></div>
    <div class="flex h-full relative">
      <!-- Mobile backdrop (closes drawer when tapped) -->
      <div id="sidebar-backdrop"
           class="fixed inset-0 z-40 bg-black/40 hidden md:hidden"
           onclick="closeSidebar()"
           aria-hidden="true"></div>

      <!-- Slim icon sidebar: always visible on md+, off-canvas drawer on mobile -->
      <aside id="sidebar"
             class="fixed md:static inset-y-0 left-0 z-50 w-16 bg-base-200 border-r border-base-300 flex flex-col items-center py-2 gap-y-1 overflow-y-auto flex-shrink-0 h-dvh -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out shadow-lg md:shadow-none"
             data-open="false"
             aria-label="Services">
        <div id="nav-services"
             hx-get="/nav-services"
             hx-trigger="load"
             hx-swap="innerHTML"
             class="flex flex-col items-center gap-y-1 w-full">
          <span class="loading loading-spinner loading-xs opacity-40 mt-2" title="Loading services…"></span>
        </div>
      </aside>

      <!-- Main viewer area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <div class="h-8 bg-base-100 border-b border-base-300 flex items-center px-2 sm:px-3 text-xs flex-shrink-0">
          <button type="button"
                  id="sidebar-toggle"
                  class="btn btn-ghost btn-xs px-2 mr-1 md:hidden"
                  onclick="toggleSidebar()"
                  aria-label="Toggle services menu"
                  aria-controls="sidebar"
                  aria-expanded="false"
                  title="Services">☰</button>
          <span class="font-semibold">neo</span>
          <span class="ml-1.5 opacity-50 hidden sm:inline">navigator</span>
          <div class="ml-auto flex items-center gap-1 sm:gap-2 text-[10px] min-w-0">
            <span id="current-url" class="opacity-60 font-mono truncate max-w-[40vw] sm:max-w-[50vw]"></span>
            <button onclick="reloadFrame()" class="btn btn-ghost btn-xs px-2" title="Soft reload current app">↻</button>
            <button onclick="hardResetCurrent()" class="btn btn-ghost btn-xs px-2" title="Hard reset this app (unload from memory + fresh load)">⟲</button>
            <button onclick="openInNewTab()" class="btn btn-ghost btn-xs px-2" title="Open in new tab">↗</button>
          </div>
        </div>

        <!-- Multi-iframe host (one iframe per service, shown/hidden to avoid reloads on switch) -->
        <div class="flex-1 relative bg-base-300 overflow-hidden" id="viewer-wrap">
          <!-- Dynamically populated with per-service <iframe> elements (absolute, inset-0) -->
          <div id="viewer-host" class="absolute inset-0 overflow-hidden"></div>

          <!-- Welcome / empty state overlay (hidden when any service is shown) -->
          <div id="welcome" class="absolute inset-0 overflow-hidden flex items-center justify-center bg-base-300/95">
            <div class="text-center max-w-xs px-4">
              <img src="/static/neo-icon.png" class="w-12 h-12 mx-auto mb-3 opacity-30 object-contain rounded" alt="neo">
              <div class="font-semibold mb-1">Select a service</div>
              <p class="text-xs opacity-60 md:hidden">Open the menu (☰) and pick a service to load its web UI here.</p>
              <p class="text-xs opacity-60 hidden md:block">Click an icon on the left to load its web UI in this view.</p>
              <p id="welcome-domain" class="text-[10px] opacity-40 mt-3">Loading domain…</p>
            </div>
          </div>

          <!-- Embedding blocked state (for services with X-Frame-Options / frame-ancestors, e.g. the "neo" admin UI itself) -->
          <div id="embedding-blocked" class="absolute inset-0 overflow-hidden hidden flex items-center justify-center bg-base-300/95 p-4">
            <div class="card bg-base-100 shadow max-w-md w-full">
              <div class="card-body">
                <h3 class="card-title text-warning text-base">Embedding blocked by the service</h3>
                <p class="text-sm">This service does not allow to be embedded into this site, to protect against clickjacking.</p>
                <p class="text-xs opacity-70 mt-1">Common for admin/sensitive interfaces.</p>

                <div class="text-[10px] opacity-50 mt-2 font-mono break-all" id="blocked-url"></div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button onclick="openBlockedInNewTab()" class="btn btn-primary btn-sm flex-1">Open in new tab ↗</button>
                  <button onclick="copyBlockedUrl()" class="btn btn-ghost btn-sm">Copy URL</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom status -->
        <div class="h-5 bg-base-100 border-t border-base-300 text-[10px] px-2 flex items-center text-base-content/50 flex-shrink-0">
          <span id="status">Ready</span>
          <span class="ml-auto opacity-30">iframe · https only</span>
        </div>
      </div>
    </div>

    {{!-- Used by store-repair progress from the nav error banner. --}}
    <dialog id="changes-modal" class="modal">
      <div class="modal-box max-w-2xl">
        <h3 id="changes-modal-title" class="font-bold text-lg">Nix store repair</h3>
        <div id="changes-body" class="py-2"></div>
        <div class="modal-action">
          <form method="dialog"><button class="btn">Close</button></form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <script src="/static/neo.js"></script>
  </body>
</html>
