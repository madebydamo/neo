{{!-- Service / core option pane shell. Concern-specific pieces live under pane/ and options/. --}}
<div id="options-pane" class="card bg-base-100 shadow" data-service="{{service}}" data-save-endpoint="{{save_endpoint}}" data-is-core="{{#if is_core}}true{{else}}false{{/if}}" data-load-url="{{#if is_core}}/core/{{service}}{{else}}/option/{{service}}{{/if}}" x-data="optionForm()" x-init="initForm()">
  <!-- Seed script moved to top so it is available immediately when x-init runs -->
  <script id="options-seed" type="application/json">{{{options_json}}}</script>

  <div class="card-body">
    {{> pane/error}}
    {{> pane/back_nav}}
    {{#if meta}}
      {{> pane/header}}
    {{else}}
      {{> pane/header_compact}}
    {{/if}}
    {{> pane/runtime_units}}

    <div class="text-[10px] text-base-content/50 -mt-1 mb-3">
      Values loaded from flake evaluation (current where set in your nixosConfiguration).
    </div>

    {{> pane/options_list}}
  </div>
</div>
