<div id="options-pane" class="card bg-base-100 shadow" data-service="{{service}}" data-save-endpoint="{{save_endpoint}}" x-data="optionForm()" x-init="initForm()">
  <!-- Seed script moved to top so it is available immediately when x-init runs -->
  <script id="options-seed" type="application/json">{{{options_json}}}</script>

  <div class="card-body">
    {{#if is_core}}
      <button class="btn btn-ghost btn-xs mb-2" hx-get="/core-grid" hx-target="#config-content" hx-swap="innerHTML">← Back to core grid</button>
    {{else}}
      <button class="btn btn-ghost btn-xs mb-2" hx-get="/services-grid" hx-target="#config-content" hx-swap="innerHTML">← Back to services grid</button>
    {{/if}}
    {{#if meta}}
      <!-- Rich service introduction header -->
      <div class="mb-4 pb-3 border-b border-base-300">
        <div class="flex items-start gap-3">
          {{#if meta.icon}}
            <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
              <img src="{{meta.icon}}" class="max-w-full max-h-full object-contain" alt=""
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
              <span class="hidden text-4xl leading-none">⚙</span>
            </div>
          {{/if}}
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <div class="flex items-center gap-2 flex-wrap">
                <h1 class="card-title font-mono text-xl">{{service}}</h1>
                {{#if meta.projectUrl}}
                  <a href="{{meta.projectUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">Project ↗</a>
                {{/if}}
                {{#if meta.githubUrl}}
                  <a href="{{meta.githubUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">GitHub ↗</a>
                {{/if}}
                {{#if meta.releaseUrl}}
                  <a href="{{meta.releaseUrl}}" target="_blank" class="btn btn-xs btn-outline no-underline">Releases ↗</a>
                {{/if}}
              </div>
              <button @click="resetAll()" class="btn btn-ghost btn-xs flex-shrink-0">Reset all to defaults</button>
            </div>

            {{#if meta.description}}
              <div class="mt-2 text-sm leading-relaxed text-base-content/80 whitespace-pre-line">
                {{meta.description}}
              </div>
            {{/if}}

            {{#if meta.screenshots}}
              <div class="mt-3">
                <div class="text-xs font-semibold text-base-content/60 mb-1.5">Examples</div>
                <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1">
                  {{#each meta.screenshots}}
                    <a href="{{url}}" target="_blank" class="block flex-shrink-0 group">
                      <img src="{{url}}" alt="{{#if caption}}{{caption}}{{else}}{{../service}} screenshot{{/if}}"
                           class="h-20 w-auto max-w-[180px] rounded border border-base-300 group-hover:border-primary transition-colors object-cover bg-base-200">
                      {{#if caption}}
                        <div class="text-[10px] text-center opacity-60 mt-0.5 max-w-[180px] truncate">{{caption}}</div>
                      {{/if}}
                    </a>
                  {{/each}}
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    {{else}}
      <!-- Fallback compact header when no meta is defined for the service -->
      <div class="flex items-center justify-between mb-2">
        <h1 class="card-title font-mono">{{service}}</h1>
        <button @click="resetAll()" class="btn btn-ghost btn-xs">Reset all to defaults</button>
      </div>
    {{/if}}

    <div class="text-[10px] text-base-content/50 -mt-1 mb-3">
      Values loaded from flake evaluation (current where set in your nixosConfiguration).
    </div>

    {{#if options}}
      <div class="space-y-4">
        {{#each options}}
          {{! Submodule records are purely structural and are omitted (children with dotted names are shown flat) }}
          {{#unless (eq type.kind "submodule")}}
            <div class="border border-base-300 rounded-lg p-3 bg-base-200/40">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 flex-wrap min-w-0">
                  <span class="font-mono text-sm break-all">{{name}}</span>
                  {{#if readOnly}}<span class="badge badge-warning badge-xs">readOnly</span>{{/if}}
                  <div class="dropdown dropdown-right dropdown-hover">
                    <span tabindex="0" role="button"
                          class="cursor-help text-base-content/40 hover:text-primary text-[13px] leading-none select-none">
                      ⓘ
                    </span>
                    <div tabindex="0" class="dropdown-content card card-sm bg-base-100 shadow-sm z-10 w-72 text-left">
                      <div class="card-body text-sm">
                        {{#if description}}
                          <div>{{description}}</div>
                          <div class="divider my-1"></div>
                        {{/if}}
                        <div><span class="font-semibold">type:</span> <span class="font-mono text-xs">{{typeLabel}}</span></div>
                        <div><span class="font-semibold">default:</span> <span class="font-mono text-xs">{{defaultDisplay}}</span></div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-1 flex-shrink-0">
                  <span x-show="sourceLabel('{{name}}') === 'modified'"
                        class="badge badge-warning badge-xs">modified</span>
                  <button @click="revertField('{{name}}')"
                          class="btn btn-ghost btn-xs"
                          :class="{ 'opacity-40': isAtOriginal('{{name}}') }"
                          :disabled="isAtOriginal('{{name}}')"
                          title="Revert this field to loaded value">↺</button>
                </div>
              </div>

              {{! Scalar inputs }}
              {{#if (eq type.kind "bool")}}
                <div class="form-control mt-2">
                  <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="toggle toggle-primary" x-model="values['{{name}}']">
                    <span class="label-text text-xs">enabled</span>
                  </label>
                </div>
              {{/if}}

              {{#if (eq type.kind "str")}}
                <div class="mt-2">
                  <input type="text" class="input input-primary input-sm w-full font-mono"
                         x-model="values['{{name}}']"
                         placeholder="{{defaultDisplay}}">
                </div>
              {{/if}}

              {{#if (eq type.kind "nullOr")}}
                {{#if (eq type.elem.kind "str")}}
                  <div class="mt-2 flex gap-2">
                    <input type="text" class="input input-primary input-sm flex-1 font-mono"
                           x-model="values['{{name}}']"
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
                {{#if (eq type.elem.kind "path")}}
                  <div class="mt-2 flex gap-2">
                    <input type="text" class="input input-primary input-sm flex-1 font-mono"
                           x-model="values['{{name}}']"
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
                {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
                  <div class="mt-2 flex gap-2">
                    <input type="number"
                           class="input input-primary input-sm flex-1 font-mono"
                           x-model.number="values['{{name}}']"
                           {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
                           {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
                {{#if (eq type.elem.kind "float")}}
                  <div class="mt-2 flex gap-2">
                    <input type="number"
                           class="input input-primary input-sm flex-1 font-mono"
                           x-model.number="values['{{name}}']"
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
              {{/if}}

              {{#if (or (eq type.kind "int") (eq type.kind "port"))}}
                <div class="mt-2">
                  <input type="number"
                         class="input input-primary input-sm w-full font-mono"
                         x-model.number="values['{{name}}']"
                         {{#if type.min}}min="{{type.min}}"{{/if}}
                         {{#if type.max}}max="{{type.max}}"{{/if}}>
                </div>
              {{/if}}

              {{! enum (dropdown) }}
              {{#if (eq type.kind "enum")}}
                <div class="mt-2">
                  <select class="select select-sm select-primary w-full font-mono"
                          x-model="values['{{name}}']">
                    {{#each type.values}}
                      <option value="{{this}}">{{this}}</option>
                    {{/each}}
                  </select>
                </div>
              {{/if}}

              {{! listOf (repeatable rows via Alpine) }}
              {{#if (eq type.kind "listOf")}}
                <div class="mt-2">
                  <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
                    <div class="flex gap-2 mb-1.5">
                      <input type="text" class="input input-primary input-sm flex-1 font-mono"
                             x-model="values['{{name}}'][idx]">
                      <button @click="removeListItem('{{name}}', idx)" class="btn btn-ghost btn-xs">✕</button>
                    </div>
                  </template>
                  <button @click="addListItem('{{name}}')" class="btn btn-outline btn-xs mt-1">+ add</button>
                </div>
              {{/if}}

              {{! attrsOf str (simple key-value) }}
              {{#if (eq type.kind "attrsOf")}}
                <div class="mt-2 space-y-1">
                  <template x-for="(val, key) in (values['{{name}}'] || {})" :key="key">
                    <div class="flex gap-2">
                      <input class="input input-primary input-sm w-40 font-mono" :value="key" disabled>
                      <input class="input input-primary input-sm flex-1 font-mono" x-model="values['{{name}}'][key]">
                      <button @click="removeAttrItem('{{name}}', key)" class="btn btn-ghost btn-xs">✕</button>
                    </div>
                  </template>
                  <div class="flex gap-2">
                    <input class="input input-primary input-sm w-40" placeholder="key" x-ref="newkey_{{name}}">
                    <button @click="addAttrItem('{{name}}', $refs['newkey_{{name}}'])" class="btn btn-outline btn-xs">+ add</button>
                  </div>
                </div>
              {{/if}}

            </div>
          {{/unless}}
        {{/each}}
      </div>

      <div class="mt-4 flex gap-2">
        <button @click="save()" class="btn btn-sm btn-primary">Save</button>
        <button @click="revertAll()" class="btn btn-sm btn-ghost">Discard changes</button>
      </div>
    {{else}}
      <p class="text-base-content/60">No options found or service does not exist.</p>
    {{/if}}
  </div>
</div>
