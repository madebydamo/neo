<div id="options-pane" class="card bg-base-100 shadow" data-service="{{service}}" x-data="optionForm()" x-init="initForm()">
  <!-- Seed script moved to top so it is available immediately when x-init runs -->
  <script id="options-seed" type="application/json">{{{options_json}}}</script>

  <div class="card-body">
    <div class="flex items-center justify-between mb-2">
      <h2 class="card-title font-mono">{{service}}</h2>
      <button @click="resetAll()" class="btn btn-ghost btn-xs">Reset all to defaults</button>
    </div>
    <div class="text-[10px] text-base-content/50 -mt-1 mb-2">
      Values loaded from flake evaluation (current where set in your nixosConfiguration).
    </div>

    {{#if options}}
      <div class="space-y-4">
        {{#each options}}
          {{! Submodule records are purely structural and are omitted (children with dotted names are shown flat) }}
          {{#unless (eq type.kind "submodule")}}
            <div class="border border-base-300 rounded-lg p-3 bg-base-200/40">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 flex-wrap min-w-0">
                  <span class="font-mono text-sm break-all">{{name}}</span>
                  {{#if readOnly}}<span class="badge badge-warning badge-xs">readOnly</span>{{/if}}
                  <details class="dropdown dropdown-right">
                    <summary class="cursor-pointer list-none">
                      <span class="cursor-help text-base-content/40 hover:text-primary text-[13px] leading-none select-none">ⓘ</span>
                    </summary>
                    <div class="dropdown-content card card-sm bg-base-100 shadow-sm z-10 w-72 text-left">
                      <div class="card-body text-sm">
                        {{#if description}}
                          <div>{{description}}</div>
                          <div class="divider my-1"></div>
                        {{/if}}
                        <div><span class="font-semibold">type:</span> <span class="font-mono text-xs">{{typeLabel}}</span></div>
                        <div><span class="font-semibold">default:</span> <span class="font-mono text-xs">{{defaultDisplay}}</span></div>
                      </div>
                    </div>
                  </details>
                </div>

                <div class="flex items-center gap-1 flex-shrink-0">
                  <span x-show="sourceLabel('{{name}}') === 'modified'"
                        class="badge badge-warning badge-xs">modified</span>
                  <button @click="revertField('{{name}}')"
                          class="btn btn-ghost btn-xs"
                          :class="{ 'opacity-40': isAtOriginal('{{name}}') }"
                          :disabled="isAtOriginal('{{name}}')"
                          title="Revert this field to loaded value">↺</button>
                </div>
              </div>

              {{! Scalar inputs }}
              {{#if (eq type.kind "bool")}}
                <div class="form-control mt-2">
                  <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="toggle toggle-primary" x-model="values['{{name}}']">
                    <span class="label-text text-xs">enabled</span>
                  </label>
                </div>
              {{/if}}

              {{#if (eq type.kind "str")}}
                <div class="mt-2">
                  <input type="text" class="input input-bordered input-sm w-full font-mono"
                         x-model="values['{{name}}']"
                         placeholder="{{defaultDisplay}}">
                </div>
              {{/if}}

              {{#if (eq type.kind "nullOr")}}
                {{#if (eq type.elem.kind "str")}}
                  <div class="mt-2 flex gap-2">
                    <input type="text" class="input input-bordered input-sm flex-1 font-mono"
                           x-model="values['{{name}}']"
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
                {{#if (eq type.elem.kind "path")}}
                  <div class="mt-2 flex gap-2">
                    <input type="text" class="input input-bordered input-sm flex-1 font-mono"
                           x-model="values['{{name}}']"
                           placeholder="null (use default)">
                    <button @click="values['{{name}}'] = null" class="btn btn-ghost btn-xs">clear</button>
                  </div>
                {{/if}}
              {{/if}}

              {{#if (or (eq type.kind "int") (eq type.kind "port"))}}
                <div class="mt-2">
                  <input type="number"
                         class="input input-bordered input-sm w-full font-mono"
                         x-model.number="values['{{name}}']"
                         {{#if type.min}}min="{{type.min}}"{{/if}}
                         {{#if type.max}}max="{{type.max}}"{{/if}}>
                </div>
              {{/if}}

              {{! listOf (repeatable rows via Alpine) }}
              {{#if (eq type.kind "listOf")}}
                <div class="mt-2">
                  <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
                    <div class="flex gap-2 mb-1.5">
                      <input type="text" class="input input-bordered input-sm flex-1 font-mono"
                             x-model="values['{{name}}'][idx]">
                      <button @click="removeListItem('{{name}}', idx)" class="btn btn-ghost btn-xs">✕</button>
                    </div>
                  </template>
                  <button @click="addListItem('{{name}}')" class="btn btn-outline btn-xs mt-1">+ add</button>
                </div>
              {{/if}}

              {{! attrsOf str (simple key-value) }}
              {{#if (eq type.kind "attrsOf")}}
                <div class="mt-2 space-y-1">
                  <template x-for="(val, key) in (values['{{name}}'] || {})" :key="key">
                    <div class="flex gap-2">
                      <input class="input input-bordered input-sm w-40 font-mono" :value="key" disabled>
                      <input class="input input-bordered input-sm flex-1 font-mono" x-model="values['{{name}}'][key]">
                      <button @click="removeAttrItem('{{name}}', key)" class="btn btn-ghost btn-xs">✕</button>
                    </div>
                  </template>
                  <div class="flex gap-2">
                    <input class="input input-bordered input-sm w-40" placeholder="key" x-ref="newkey_{{name}}">
                    <button @click="addAttrItem('{{name}}', $refs['newkey_{{name}}'])" class="btn btn-outline btn-xs">+ add</button>
                  </div>
                </div>
              {{/if}}

            </div>
          {{/unless}}
        {{/each}}
      </div>

      <div class="mt-4 flex gap-2">
        <button @click="logState()" class="btn btn-sm">Log current state (console)</button>
        <button @click="copyJson()" class="btn btn-sm btn-outline">Copy JSON</button>
      </div>
    {{else}}
      <p class="text-base-content/60">No options found or service does not exist.</p>
    {{/if}}
  </div>
</div>