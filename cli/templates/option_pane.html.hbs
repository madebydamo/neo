<div id="options-pane" class="w-1/2 p-6 border-l border-zinc-700">
  <h2 class="text-2xl mb-4 font-mono">{{service}}</h2>
  {{#if options}}
    <div class="space-y-4">
      {{#each options}}
        <div class="bg-zinc-800 p-4 rounded">
          <div class="font-mono text-emerald-400">{{name}}</div>
          <div class="text-sm text-zinc-400 mt-1">Type: {{type}}</div>
          <div class="text-sm text-zinc-400">Default: {{default}}</div>
          <div class="text-sm mt-2">{{description}}</div>

          {{#if (eq type "str")}}
            <div class="mt-3">
              <label class="text-xs text-zinc-500">Current value (default: {{default}})</label>
              <input type="text" value="{{#if current}}{{current}}{{else}}{{default}}{{/if}}" placeholder="{{default}}" class="w-full bg-zinc-900 border border-zinc-700 rounded px-2 py-1 text-sm mt-1">
            </div>
          {{/if}}

          {{#if (eq type "bool")}}
            <div class="mt-3">
              <label class="text-xs text-zinc-500">Current value: {{current}} (default: {{default}})</label>
              <span class="text-xs text-zinc-400">(checkbox form would go here)</span>
            </div>
          {{/if}}

          {{#if (eq type "int")}}
            <div class="mt-3">
              <label class="text-xs text-zinc-500">Current value (default: {{default}})</label>
              <input type="number" value="{{#if current}}{{current}}{{else}}{{default}}{{/if}}" placeholder="{{default}}" class="w-full bg-zinc-900 border border-zinc-700 rounded px-2 py-1 text-sm mt-1">
            </div>
          {{/if}}

          <div class="text-xs mt-2 text-amber-400">
            Effective value shown (default when unset in config)
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="text-zinc-500">No options found or service does not exist.</p>
  {{/if}}
</div>