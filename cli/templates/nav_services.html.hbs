{{!-- Fragment for navigator sidebar (loaded via htmx after index shell is shown). --}}
{{#if error}}
  <div id="nav-error" class="alert alert-error m-2 text-sm flex flex-col gap-2" hx-swap-oob="true">
    <span class="whitespace-pre-wrap"><strong>Eval error{{#if error_kind}} ({{error_kind}}){{/if}}:</strong> {{error}}</span>
    <div class="flex flex-wrap gap-1">
      {{#if can_store_repair}}
        <button type="button"
                class="btn btn-xs btn-warning"
                hx-post="/nix/repair" data-neo-lock="system"
                hx-target="#changes-body"
                hx-swap="innerHTML"
                hx-confirm="Run sudo nix-store --verify --repair?"
                hx-on::after-request="if(!event.detail.successful)return;var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Nix store repair';m.showModal();}">
          Repair store
        </button>
      {{/if}}
      {{#if can_flake_update}}
        <button type="button"
                class="btn btn-xs btn-info"
                hx-post="/flake/update" data-neo-lock="system"
                hx-target="#changes-body"
                hx-swap="innerHTML"
                hx-confirm="Run flake update + template refresh?"
                hx-on::after-request="if(!event.detail.successful)return;var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Update';m.showModal();}">
          Update inputs
        </button>
      {{/if}}
      <button class="btn btn-sm btn-ghost" onclick="location.reload()">Reload</button>
    </div>
  </div>
{{else}}
  <div id="nav-error" class="hidden" hx-swap-oob="true"></div>
{{/if}}

{{#if domain}}
  <p id="welcome-domain" class="text-[10px] opacity-40 mt-3 font-mono" hx-swap-oob="true">Base domain: {{domain}}</p>
{{else}}
  <p id="welcome-domain" class="text-[10px] text-warning mt-3" hx-swap-oob="true">No swag.domain configured — set it to enable links.</p>
{{/if}}

{{#each services}}
  <button
    class="nav-btn svc-btn w-12 h-11 rounded-xl flex-shrink-0 flex items-center justify-center text-base-content/80 hover:text-base-content"
    title="{{name}} (https://{{subdomain}}.{{domain}})"
    data-sub="{{subdomain}}"
    data-domain="{{domain}}"
    data-name="{{name}}"
    data-iframe-compatible="{{iframeCompatible}}"
    onclick="handleSidebarClick(event, '{{subdomain}}', '{{domain}}', this)">
    <div class="relative w-8 h-8 flex items-center justify-center">
      {{#if icon}}
        <img src="{{icon}}" class="w-8 h-8 object-contain" alt=""
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <span class="hidden text-3xl leading-none">⚙</span>
      {{else}}
        <span class="text-3xl leading-none">⚙</span>
      {{/if}}
      {{!-- Runtime health; painted by service_status.js (one batched request).
           Only surfaces problems (failed / stopped / degraded / changing); a healthy
           service shows nothing. The green top-right dot means "loaded" (warm iframe). --}}
      <span class="neo-unit-alert"
            data-service-status="{{name}}"
            data-units="{{#each units}}{{this}}{{#unless @last}} {{/unless}}{{/each}}"
            data-timers="{{#each timers}}{{this}}{{#unless @last}} {{/unless}}{{/each}}"
            role="img"
            aria-label="{{name}}: checking status"></span>
      <span class="absolute -bottom-0.5 -right-1 text-[7px] font-bold bg-base-100 text-base-content px-0.5 py-px leading-none rounded ring-1 ring-base-content/15 font-mono">
        {{initials}}
      </span>
    </div>
  </button>
{{/each}}

{{#unless services}}
  {{#unless error}}
    <div class="text-[10px] opacity-40 text-center px-1 mt-2">No<br>proxied<br>services</div>
  {{/unless}}
{{/unless}}

{{!-- Apply shell metadata once services (and domain/theme) are known --}}
<script>
  (function () {
    var theme = {{#if theme}}"{{theme}}"{{else}}"light"{{/if}};
    document.body.setAttribute('data-theme', theme);
    {{#if hostname}}
    document.title = 'neo — {{hostname}}';
    {{/if}}
  })();
</script>
