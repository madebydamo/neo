{{! listOf: scalars or one-deep submodule entries }}
{{#if (eq type.elem.kind "submodule")}}
  <div>
    <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
      <div>
        <div class="h-2" x-show="idx > 0"></div>

        <div class="border border-base-300 rounded-lg p-2 sm:p-3 bg-base-100/60 space-y-2 sm:space-y-3">
          <div class="flex items-center justify-between gap-2 sm:gap-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50"
                  x-text="'Entry ' + (idx + 1)"></span>
            <button type="button"
                    class="btn btn-ghost btn-xs text-error shrink-0"
                    @click="removeListItem('{{name}}', idx)"
                    title="Remove this entry">
              Remove
            </button>
          </div>

          <div class="divider my-0 before:h-px after:h-px"></div>

          <div class="space-y-3">
            {{#each type.elem.fields}}
              {{> options/entry_field parent=../name accessor="idx" target_key="index"}}
            {{/each}}
          </div>
        </div>
      </div>
    </template>

    <p class="text-xs text-base-content/45 italic" x-show="!(values['{{name}}'] || []).length">None added yet.</p>
    <button type="button" @click="addListItem('{{name}}')"
            class="btn btn-ghost btn-sm text-primary px-2 mt-2">+ Add entry</button>
  </div>
{{else}}
  {{! Multi-select: listOf with type.values → toggle pills (labels from ui.choiceLabels). }}
  {{#if type.values}}
    {{#if (lt (len type.choices) 7)}}
      <div class="flex flex-wrap gap-2" role="group" aria-label="{{label}}">
        {{#each type.choices}}
          <button type="button"
                  class="btn btn-sm rounded-full gap-1.5"
                  :class="isListChoiceSelected('{{../name}}', {{@index}}) ? 'btn-primary' : 'btn-outline border-base-300 font-normal'"
                  :aria-pressed="isListChoiceSelected('{{../name}}', {{@index}})"
                  @click="toggleListChoiceAt('{{../name}}', {{@index}})">
            <svg x-show="isListChoiceSelected('{{../name}}', {{@index}})" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
            {{label}}
          </button>
        {{/each}}
      </div>
    {{else}}
      <div class="max-h-56 overflow-y-auto rounded-lg border border-base-300 bg-base-200/30 p-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {{#each type.choices}}
            <label class="flex items-center gap-2.5 rounded-lg border border-base-300/80 bg-base-100 px-2.5 py-2 cursor-pointer hover:border-primary/40 hover:bg-primary/5 transition-colors">
              <input type="checkbox" class="checkbox checkbox-primary checkbox-sm shrink-0"
                     :checked="isListChoiceSelected('{{../name}}', {{@index}})"
                     @change="toggleListChoiceAt('{{../name}}', {{@index}})">
              <span class="text-sm leading-tight break-all">{{label}}</span>
            </label>
          {{/each}}
        </div>
      </div>
    {{/if}}
    {{#unless type.choices}}
      <p class="text-xs text-base-content/50">{{#if ui.choiceEmptyHint}}{{ui.choiceEmptyHint}}{{else}}No choices available.{{/if}}</p>
    {{/unless}}
  {{else}}
  <div class="space-y-1.5">
    <p class="text-xs text-base-content/45 italic" x-show="!(values['{{name}}'] || []).length">None added yet.</p>
    <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
      <div class="flex gap-2 items-center">
        {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
          <input type="number" class="input input-sm flex-1 font-mono"
                 x-model.number="values['{{name}}'][idx]"
                 {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
                 {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}>
        {{else}}
          {{#if (eq type.elem.kind "float")}}
            <input type="number" class="input input-sm flex-1 font-mono" step="any"
                   x-model.number="values['{{name}}'][idx]">
          {{else}}
            {{#if (eq type.elem.kind "bool")}}
              <label class="label cursor-pointer justify-start gap-2 flex-1">
                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                       x-model="values['{{name}}'][idx]">
              </label>
            {{else}}
              {{#if (eq type.elem.kind "enum")}}
                <select class="select select-sm flex-1 font-mono"
                        x-model="values['{{name}}'][idx]">
                  {{#each type.elem.values}}
                    <option value="{{this}}">{{this}}</option>
                  {{/each}}
                </select>
              {{else}}
                <input type="text" class="input input-sm flex-1 font-mono"
                       x-model="values['{{name}}'][idx]">
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
        {{> options/helper_button option=name target_key="index" accessor="idx"}}
        <button type="button" @click="removeListItem('{{name}}', idx)"
                class="btn btn-ghost btn-sm btn-square shrink-0 text-base-content/50 hover:text-error"
                title="Remove" aria-label="Remove">✕</button>
      </div>
    </template>
    <button type="button" @click="addListItem('{{name}}')" class="btn btn-ghost btn-sm text-primary px-2">+ Add</button>
  </div>
  {{/if}}
{{/if}}
