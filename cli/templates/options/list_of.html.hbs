{{! listOf: scalars or one-deep submodule entries }}
{{#if (eq type.elem.kind "submodule")}}
  <div class="mt-2">
    <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
      <div>
        <div class="divider my-3 text-xs text-base-content/40" x-show="idx > 0">entry</div>

        <div class="border border-base-300 rounded-lg p-2 sm:p-3 bg-base-100/60 space-y-2 sm:space-y-3">
          <div class="flex items-center justify-between gap-2 sm:gap-3">
            <span class="text-sm font-medium text-base-content/80">
              Entry <span class="font-mono text-base-content/50" x-text="'#' + idx"></span>
            </span>
            <button type="button"
                    class="btn btn-ghost btn-xs text-error shrink-0"
                    @click="removeListItem('{{name}}', idx)"
                    title="Remove this entry">
              Remove
            </button>
          </div>

          <div class="divider my-0 before:h-px after:h-px"></div>

          <div class="space-y-3">
            {{#each type.elem.fields}}
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs text-base-content/70">{{name}}</span>
                  {{#if description}}
                    <div class="dropdown dropdown-right dropdown-hover">
                      <span tabindex="0" role="button" class="cursor-help text-base-content/40 text-[11px]">ⓘ</span>
                      <div tabindex="0" class="dropdown-content card card-sm bg-base-100 shadow-sm z-10 w-64 text-left">
                        <div class="card-body text-xs">{{description}}</div>
                      </div>
                    </div>
                  {{/if}}
                </div>

                {{#if (eq type.kind "bool")}}
                  <label class="label cursor-pointer justify-start gap-2 py-0">
                    <input type="checkbox" class="toggle toggle-primary toggle-sm"
                           x-model="values['{{../name}}'][idx]['{{name}}']">
                  </label>
                {{/if}}

                {{#if (or (eq type.kind "int") (eq type.kind "port"))}}
                  <input type="number" class="input input-primary input-sm w-full font-mono"
                         x-model.number="values['{{../name}}'][idx]['{{name}}']"
                         {{#if type.min}}min="{{type.min}}"{{/if}}
                         {{#if type.max}}max="{{type.max}}"{{/if}}>
                {{/if}}

                {{#if (eq type.kind "float")}}
                  <input type="number" class="input input-primary input-sm w-full font-mono" step="any"
                         x-model.number="values['{{../name}}'][idx]['{{name}}']">
                {{/if}}

                {{#if (eq type.kind "listOf")}}
                  <div class="pl-1 space-y-1">
                    <template x-for="(nitem, nidx) in (values['{{../name}}'][idx]['{{name}}'] || [])" :key="nidx">
                      <div class="flex gap-2 items-center">
                        {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
                          <input type="number" class="input input-primary input-sm flex-1 font-mono"
                                 x-model.number="values['{{../name}}'][idx]['{{name}}'][nidx]">
                        {{else}}
                          <input type="text" class="input input-primary input-sm flex-1 font-mono"
                                 x-model="values['{{../name}}'][idx]['{{name}}'][nidx]">
                        {{/if}}
                        <button type="button"
                                @click="removeNestedListItemAtIndex('{{../name}}', idx, '{{name}}', nidx)"
                                class="btn btn-ghost btn-xs text-error shrink-0">Remove</button>
                      </div>
                    </template>
                    <button type="button" @click="addNestedListItemAtIndex('{{../name}}', idx, '{{name}}')"
                            class="btn btn-outline btn-xs">+ Add</button>
                  </div>
                {{/if}}

                {{#if (eq type.kind "enum")}}
                  <select class="select select-sm select-primary w-full font-mono"
                          x-model="values['{{../name}}'][idx]['{{name}}']">
                    {{#each type.values}}
                      <option value="{{this}}">{{this}}</option>
                    {{/each}}
                  </select>
                {{/if}}

                {{#if (eq type.kind "nullOr")}}
                  <div class="flex gap-2 items-center">
                    <input type="text" class="input input-primary input-sm flex-1 font-mono"
                           x-model="values['{{../name}}'][idx]['{{name}}']">
                    <template x-if="resolveHelper('{{../name}}', { field: '{{name}}' })">
                      <button type="button" class="btn btn-outline btn-xs shrink-0"
                              @click="runHelper('{{../name}}', { index: idx, field: '{{name}}' })"
                              :disabled="helperBusy"
                              x-text="resolveHelper('{{../name}}', { field: '{{name}}' }).label"></button>
                    </template>
                    <button type="button" @click="values['{{../name}}'][idx]['{{name}}'] = null"
                            class="btn btn-ghost btn-xs shrink-0">Clear</button>
                  </div>
                {{/if}}

                {{#if (or (eq type.kind "str") (eq type.kind "path"))}}
                  <div class="flex gap-2 items-center">
                    <input type="text" class="input input-primary input-sm flex-1 font-mono"
                           x-model="values['{{../name}}'][idx]['{{name}}']">
                    <template x-if="resolveHelper('{{../name}}', { field: '{{name}}' })">
                      <button type="button" class="btn btn-outline btn-xs shrink-0"
                              @click="runHelper('{{../name}}', { index: idx, field: '{{name}}' })"
                              :disabled="helperBusy"
                              x-text="resolveHelper('{{../name}}', { field: '{{name}}' }).label"></button>
                    </template>
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </div>
      </div>
    </template>

    <div class="divider my-3 text-xs text-base-content/40"
         x-show="(values['{{name}}'] || []).length > 0"></div>

    <button type="button" @click="addListItem('{{name}}')"
            class="btn btn-outline btn-xs mt-1">+ Add entry</button>
  </div>
{{else}}
  {{! Multi-select: listOf with type.values }}
  {{#if type.values}}
    <div class="mt-2 max-h-56 overflow-y-auto rounded-lg border border-base-300 bg-base-200/30 p-2">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
        {{#each type.values}}
          <label class="flex items-center gap-2.5 rounded-lg border border-base-300/80 bg-base-100 px-2.5 py-2 cursor-pointer hover:border-primary/40 hover:bg-primary/5 transition-colors">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm shrink-0"
                   :checked="(values['{{../name}}'] || []).includes('{{this}}')"
                   @change="toggleListChoice('{{../name}}', '{{this}}', $event.target.checked)">
            <span class="font-mono text-xs leading-tight break-all">{{this}}</span>
          </label>
        {{else}}
          <p class="text-xs text-base-content/50 px-1 col-span-full">No choices available.</p>
        {{/each}}
      </div>
    </div>
  {{else}}
  <div class="mt-2">
    <template x-for="(item, idx) in (values['{{name}}'] || [])" :key="idx">
      <div class="flex gap-2 items-center mb-1.5">
        {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
          <input type="number" class="input input-primary input-sm flex-1 font-mono"
                 x-model.number="values['{{name}}'][idx]"
                 {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
                 {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}>
        {{else}}
          {{#if (eq type.elem.kind "float")}}
            <input type="number" class="input input-primary input-sm flex-1 font-mono" step="any"
                   x-model.number="values['{{name}}'][idx]">
          {{else}}
            {{#if (eq type.elem.kind "bool")}}
              <label class="label cursor-pointer justify-start gap-2 flex-1">
                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                       x-model="values['{{name}}'][idx]">
              </label>
            {{else}}
              {{#if (eq type.elem.kind "enum")}}
                <select class="select select-sm select-primary flex-1 font-mono"
                        x-model="values['{{name}}'][idx]">
                  {{#each type.elem.values}}
                    <option value="{{this}}">{{this}}</option>
                  {{/each}}
                </select>
              {{else}}
                <input type="text" class="input input-primary input-sm flex-1 font-mono"
                       x-model="values['{{name}}'][idx]">
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
        <template x-if="resolveHelper('{{name}}')">
          <button type="button" class="btn btn-outline btn-xs shrink-0"
                  @click="runHelper('{{name}}', { index: idx })"
                  :disabled="helperBusy"
                  x-text="resolveHelper('{{name}}').label"></button>
        </template>
        <button type="button" @click="removeListItem('{{name}}', idx)"
                class="btn btn-ghost btn-xs text-error shrink-0">Remove</button>
      </div>
    </template>
    <button type="button" @click="addListItem('{{name}}')" class="btn btn-outline btn-xs mt-1">+ Add</button>
  </div>
  {{/if}}
{{/if}}
