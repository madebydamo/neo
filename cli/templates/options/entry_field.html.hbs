{{!-- One field of an attrsOf / listOf submodule entry. Context: the field. Params: parent
     (option name), accessor (Alpine variable: key or idx), target_key ("key" or "index",
     what a helper is told). --}}
<div class="space-y-1" x-show="isEntryFieldVisible('{{parent}}', {{accessor}}, '{{visibleWhen}}')">
  <div class="flex items-center gap-2">
    <span class="text-xs font-medium text-base-content/70">{{label}}</span>
    {{#if description}}
      <div class="dropdown dropdown-right dropdown-hover">
        <span tabindex="0" role="button" class="cursor-help text-base-content/40 text-[11px]">ⓘ</span>
        <div tabindex="0" class="dropdown-content card card-sm bg-base-100 shadow-sm z-10 w-64 text-left">
          <div class="card-body text-xs">{{description}}</div>
        </div>
      </div>
    {{/if}}
  </div>

  {{#if (eq type.kind "bool")}}
    <label class="label cursor-pointer justify-start gap-2 py-0">
      <input type="checkbox" class="toggle toggle-primary toggle-sm"
             x-model="values['{{parent}}'][{{accessor}}]['{{name}}']">
    </label>
  {{/if}}

  {{#if (or (eq type.kind "int") (eq type.kind "port"))}}
    <input type="number" class="input input-sm w-full font-mono"
           x-model.number="values['{{parent}}'][{{accessor}}]['{{name}}']"
           {{#if type.min}}min="{{type.min}}"{{/if}}
           {{#if type.max}}max="{{type.max}}"{{/if}}>
  {{/if}}

  {{#if (eq type.kind "float")}}
    <input type="number" class="input input-sm w-full font-mono" step="any"
           x-model.number="values['{{parent}}'][{{accessor}}]['{{name}}']">
  {{/if}}

  {{#if (eq type.kind "listOf")}}
    {{#if type.values}}
      <div class="max-h-56 overflow-y-auto rounded-lg border border-base-300 bg-base-200/30 p-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {{#each type.values}}
            <label class="flex items-center gap-2.5 rounded-lg border border-base-300/80 bg-base-100 px-2.5 py-2 cursor-pointer hover:border-primary/40 hover:bg-primary/5 transition-colors">
              <input type="checkbox" class="checkbox checkbox-primary checkbox-sm shrink-0"
                     :checked="((values['{{../parent}}'][{{../accessor}}]['{{../name}}'] || [])).includes('{{this}}')"
                     @change="toggleNestedListChoice('{{../parent}}', {{../accessor}}, '{{../name}}', '{{this}}', $event.target.checked)">
              <span class="font-mono text-xs leading-tight break-all">{{this}}</span>
            </label>
          {{else}}
            <p class="text-xs text-base-content/50 px-1 col-span-full">No choices available.</p>
          {{/each}}
        </div>
      </div>
    {{else}}
    <div class="pl-1 space-y-1">
      <template x-for="(nitem, nidx) in (values['{{parent}}'][{{accessor}}]['{{name}}'] || [])" :key="nidx">
        <div class="flex gap-2 items-center">
          {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
            <input type="number" class="input input-sm flex-1 font-mono"
                   x-model.number="values['{{parent}}'][{{accessor}}]['{{name}}'][nidx]">
          {{else}}
            {{#if (eq type.elem.kind "bool")}}
              <label class="label cursor-pointer justify-start gap-2 flex-1">
                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                       x-model="values['{{parent}}'][{{accessor}}]['{{name}}'][nidx]">
              </label>
            {{else}}
              {{#if (eq type.elem.kind "enum")}}
                <select class="select select-sm flex-1 font-mono"
                        x-model="values['{{parent}}'][{{accessor}}]['{{name}}'][nidx]">
                  {{#each type.elem.values}}
                    <option value="{{this}}">{{this}}</option>
                  {{/each}}
                </select>
              {{else}}
                <input type="text" class="input input-sm flex-1 font-mono"
                       x-model="values['{{parent}}'][{{accessor}}]['{{name}}'][nidx]">
              {{/if}}
            {{/if}}
          {{/if}}
          <button type="button"
                  @click="removeNestedListItem('{{parent}}', {{accessor}}, '{{name}}', nidx)"
                  class="btn btn-ghost btn-sm btn-square shrink-0 text-base-content/50 hover:text-error" title="Remove" aria-label="Remove">✕</button>
        </div>
      </template>
      <button type="button"
              @click="addNestedListItem('{{parent}}', {{accessor}}, '{{name}}')"
              class="btn btn-ghost btn-xs text-primary px-1">+ Add</button>
    </div>
    {{/if}}
  {{/if}}

  {{#if (eq type.kind "attrsOf")}}
    <div class="pl-1 space-y-1">
      <template x-for="(nval, nkey) in (values['{{parent}}'][{{accessor}}]['{{name}}'] || {})" :key="nkey">
        <div class="flex gap-2 items-center">
          <input class="input input-sm w-32 font-mono" :value="nkey" disabled>
          {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
            <input type="number" class="input input-sm flex-1 font-mono"
                   x-model.number="values['{{parent}}'][{{accessor}}]['{{name}}'][nkey]">
          {{else}}
            {{#if (eq type.elem.kind "bool")}}
              <label class="label cursor-pointer justify-start gap-2 flex-1">
                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                       x-model="values['{{parent}}'][{{accessor}}]['{{name}}'][nkey]">
              </label>
            {{else}}
              <input type="text" class="input input-sm flex-1 font-mono"
                     x-model="values['{{parent}}'][{{accessor}}]['{{name}}'][nkey]">
            {{/if}}
          {{/if}}
          <button type="button"
                  @click="removeNestedAttrItem('{{parent}}', {{accessor}}, '{{name}}', nkey)"
                  class="btn btn-ghost btn-sm btn-square shrink-0 text-base-content/50 hover:text-error" title="Remove" aria-label="Remove">✕</button>
        </div>
      </template>
      <div class="flex gap-2 items-center">
        <input class="input input-sm w-32 font-mono" placeholder="key">
        <button type="button"
                @click="addNestedAttrItem('{{parent}}', {{accessor}}, '{{name}}', $event.target.previousElementSibling)"
                class="btn btn-ghost btn-sm text-primary shrink-0">+ Add</button>
      </div>
    </div>
  {{/if}}

  {{#if (eq type.kind "enum")}}
    <select class="select select-sm w-full font-mono"
            x-model="values['{{parent}}'][{{accessor}}]['{{name}}']">
      {{#each type.values}}
        <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>
  {{/if}}

  {{#if (eq type.kind "nullOr")}}
    <div class="flex gap-2 items-center"{{#if secret}} x-data="{ reveal: false }"{{/if}}>
      <input {{#if secret}}:type="reveal ? 'text' : 'password'" autocomplete="off"{{else}}type="text"{{/if}} class="input input-sm flex-1 font-mono"
             x-model="values['{{parent}}'][{{accessor}}]['{{name}}']"
             placeholder="{{defaultDisplay}}"
             aria-label="{{label}}">
      {{#if secret}}
        {{> options/secret_toggle}}
      {{/if}}
      {{> options/helper_button option=parent field=name target_key=target_key accessor=accessor}}
      <button type="button" @click="values['{{parent}}'][{{accessor}}]['{{name}}'] = null"
              class="btn btn-ghost btn-xs shrink-0">Clear</button>
    </div>
  {{/if}}

  {{#if (or (eq type.kind "str") (or (eq type.kind "path") (eq type.kind "strMatching")))}}
    <div class="flex gap-2 items-center"{{#if secret}} x-data="{ reveal: false }"{{/if}}>
      <input {{#if secret}}:type="reveal ? 'text' : 'password'" autocomplete="off"{{else}}type="text"{{/if}} class="input input-sm flex-1 font-mono"
             x-model="values['{{parent}}'][{{accessor}}]['{{name}}']"
             placeholder="{{defaultDisplay}}"
             aria-label="{{label}}">
      {{#if secret}}
        {{> options/secret_toggle}}
      {{/if}}
      {{> options/helper_button option=parent field=name target_key=target_key accessor=accessor}}
    </div>
  {{/if}}
</div>
