{{#if (eq type.elem.kind "str")}}
  <div class="mt-2 flex gap-2 items-center">
    <input type="text" class="input input-primary input-sm flex-1 font-mono"
           x-model="values['{{name}}']"
           placeholder="null (use default)">
    <template x-if="resolveHelper('{{name}}')">
      <button type="button" class="btn btn-outline btn-xs shrink-0"
              @click="runHelper('{{name}}')"
              :disabled="helperBusy"
              x-text="resolveHelper('{{name}}').label"></button>
    </template>
    <button type="button" @click="values['{{name}}'] = null"
            class="btn btn-ghost btn-xs shrink-0">Clear</button>
  </div>
{{/if}}
{{#if (eq type.elem.kind "path")}}
  <div class="mt-2 flex gap-2 items-center">
    <input type="text" class="input input-primary input-sm flex-1 font-mono"
           x-model="values['{{name}}']"
           placeholder="null (use default)">
    <template x-if="resolveHelper('{{name}}')">
      <button type="button" class="btn btn-outline btn-xs shrink-0"
              @click="runHelper('{{name}}')"
              :disabled="helperBusy"
              x-text="resolveHelper('{{name}}').label"></button>
    </template>
    <button type="button" @click="values['{{name}}'] = null"
            class="btn btn-ghost btn-xs shrink-0">Clear</button>
  </div>
{{/if}}
{{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
  <div class="mt-2 flex gap-2 items-center">
    <input type="number"
           class="input input-primary input-sm flex-1 font-mono"
           x-model.number="values['{{name}}']"
           {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
           {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}
           placeholder="null (use default)">
    <button type="button" @click="values['{{name}}'] = null"
            class="btn btn-ghost btn-xs shrink-0">Clear</button>
  </div>
{{/if}}
{{#if (eq type.elem.kind "float")}}
  <div class="mt-2 flex gap-2 items-center">
    <input type="number"
           class="input input-primary input-sm flex-1 font-mono"
           x-model.number="values['{{name}}']"
           step="any"
           {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
           {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}
           placeholder="null (use default)">
    <button type="button" @click="values['{{name}}'] = null"
            class="btn btn-ghost btn-xs shrink-0">Clear</button>
  </div>
{{/if}}
