{{! nullOr scalar: empty / "Clear" means unset (null → module default). }}
<div class="flex gap-2 items-center"{{#if secret}} x-data="{ reveal: false }"{{/if}}>
  {{#if (or (eq type.elem.kind "str") (or (eq type.elem.kind "path") (eq type.elem.kind "strMatching")))}}
    <input {{#if secret}}:type="reveal ? 'text' : 'password'" autocomplete="off"{{else}}type="text"{{/if}} class="input input-sm w-full flex-1 font-mono"
           :class="{ 'input-error': !!patternError('{{name}}') }"
           x-model="values['{{name}}']"
           placeholder="Not set"
           aria-label="{{label}}">
    {{#if secret}}
      {{> options/secret_toggle}}
    {{/if}}
    {{> options/helper_button option=name}}
  {{else}}{{#if (or (eq type.elem.kind "int") (or (eq type.elem.kind "port") (eq type.elem.kind "float")))}}
    <input type="number"
           class="input input-sm w-full flex-1 font-mono"
           x-model.number="values['{{name}}']"
           {{#if (eq type.elem.kind "float")}}step="any"{{/if}}
           {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
           {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}
           placeholder="Not set"
           aria-label="{{label}}">
  {{else}}{{#if (eq type.elem.kind "enum")}}
    <select class="select select-sm w-full flex-1"
            x-model="values['{{name}}']"
            @change="if (values['{{name}}'] === '') values['{{name}}'] = null"
            aria-label="{{label}}">
      <option value="">Not set</option>
      {{#each type.elem.choices}}
        <option value="{{value}}">{{label}}</option>
      {{/each}}
    </select>
  {{else}}
    <p class="flex-1 text-xs text-base-content/50 font-mono break-all">{{currentDisplay}}</p>
  {{/if}}{{/if}}{{/if}}
  <button type="button" @click="values['{{name}}'] = null"
          x-show="values['{{name}}'] !== null && values['{{name}}'] !== undefined"
          class="btn btn-ghost btn-sm btn-square shrink-0"
          title="Clear (use default)" aria-label="Clear">✕</button>
</div>
