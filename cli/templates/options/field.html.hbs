{{! One settings row. Label + description on the left; scalar controls sit to the
    right on md+ and below on phones; collections and widgets span the full row.
    Submodule records are omitted unless they carry a composite ui.widget
    (children with dotted names are shown flat otherwise). }}
{{#if (eq type.kind "submodule")}}
  {{#if (eq ui.widget "providerAuth")}}
    <div class="neo-field py-3 sm:py-4" data-option="{{name}}" x-show="isFieldVisible('{{name}}')">
      {{> options/field_head}}
      <div class="mt-2">
        {{> options/widgets/provider_auth}}
      </div>
    </div>
  {{/if}}
{{else}}
  {{#if (eq type.kind "bool")}}
    <div class="neo-field py-3 sm:py-4" data-option="{{name}}" x-show="isFieldVisible('{{name}}')">
      {{> options/field_head}}
    </div>
  {{else}}{{#if (eq type.kind "separatedString")}}
    <div class="neo-field py-3 sm:py-4" data-option="{{name}}" x-show="isFieldVisible('{{name}}')">
      {{> options/field_head}}
      <div class="mt-2">
        {{> options/separated_string}}
      </div>
    </div>
  {{else}}{{#if (or (eq type.kind "listOf") (eq type.kind "attrsOf"))}}
    <div class="neo-field py-3 sm:py-4" data-option="{{name}}" x-show="isFieldVisible('{{name}}')">
      {{> options/field_head}}
      <div class="mt-2">
        {{#if (eq type.kind "listOf")}}
          {{#if (eq ui.widget "pluginList")}}
            {{> options/widgets/plugin_list}}
          {{else}}{{#if (eq ui.widget "primaryItemList")}}
            {{> options/widgets/primary_item_list}}
          {{else}}
            {{> options/list_of}}
          {{/if}}{{/if}}
        {{else}}{{#if (eq ui.widget "proxyRouteList")}}
          {{> options/widgets/proxy_route_list}}
        {{else}}{{#if (eq ui.widget "pluginList")}}
          {{> options/widgets/plugin_list}}
        {{else}}
          {{> options/attrs_of}}
        {{/if}}{{/if}}{{/if}}
      </div>
    </div>
  {{else}}
    <div class="neo-field py-3 sm:py-4 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-6 md:items-start"
         data-option="{{name}}" x-show="isFieldVisible('{{name}}')">
      {{> options/field_head}}
      <div class="mt-2 md:mt-0">
        {{#if (or (eq type.kind "str") (or (eq type.kind "path") (eq type.kind "strMatching")))}}
          {{> options/str}}
        {{else}}{{#if (eq type.kind "nullOr")}}
          {{> options/null_or}}
        {{else}}{{#if (or (eq type.kind "int") (or (eq type.kind "port") (eq type.kind "float")))}}
          {{> options/number}}
        {{else}}{{#if (eq type.kind "enum")}}
          {{> options/enum}}
        {{else}}
          <p class="text-xs text-base-content/50 font-mono break-all">{{currentDisplay}}</p>
        {{/if}}{{/if}}{{/if}}{{/if}}
      </div>
    </div>
  {{/if}}{{/if}}{{/if}}
{{/if}}
