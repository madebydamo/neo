{{!-- Section icon from ui.group icon (mkGroup: path or URL, see nix/lib/ui.nix).
     SVGs are a currentColor mask so they follow the theme; other images render as-is. --}}
{{#if icon}}
  {{#if tint}}
    <span class="block w-5 h-5 bg-current" aria-hidden="true"
          style="-webkit-mask: url('{{icon}}') center / contain no-repeat; mask: url('{{icon}}') center / contain no-repeat;"></span>
  {{else}}
    <img src="{{icon}}" alt="" class="w-5 h-5 object-contain" aria-hidden="true">
  {{/if}}
{{else}}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-5 h-5" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
{{/if}}
