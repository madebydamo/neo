{{! attrsOf: scalar values or one-deep submodule entries; widgets via option.ui }}
{{#if (eq type.elem.kind "submodule")}}
  <div>
    {{#if (eq ui.widget "exclusiveListPair")}}
      {{> options/widgets/exclusive_list_pair}}
    {{else}}
    <template x-for="(key, idx) in attrKeys('{{name}}')" :key="key">
      <div>
        <div class="h-2" x-show="idx > 0"></div>

        <div class="border border-base-300 rounded-lg p-2 sm:p-3 bg-base-100/60 space-y-2 sm:space-y-3">
          {{! Card header: named entry + remove }}
          <div class="flex items-end justify-between gap-2 sm:gap-3">
            <div class="flex flex-col flex-1 min-w-0 gap-1">
              <label class="label py-0 gap-2 justify-start flex-wrap">
                <span class="label-text text-xs font-semibold">Name</span>
                <span class="label-text-alt text-[10px] text-base-content/45">unique key for this entry</span>
              </label>
              <input type="text"
                     class="input input-sm font-mono w-full max-w-md"
                     :value="key"
                     @change="renameAttrKey('{{name}}', key, $event.target.value)"
                     placeholder="e.g. home"
                     aria-label="Entry name">
            </div>
            <button type="button"
                    class="btn btn-ghost btn-xs text-error shrink-0"
                    @click="removeAttrItem('{{name}}', key)"
                    title="Remove this entry">
              Remove
            </button>
          </div>

          <div class="divider my-0 before:h-px after:h-px"></div>

          <div class="space-y-3">
            {{#each type.elem.fields}}
              {{> options/entry_field parent=../name accessor="key" target_key="key"}}
            {{/each}}
          </div>
        </div>
      </div>
    </template>

    <p class="text-xs text-base-content/45 italic" x-show="!attrKeys('{{name}}').length">None added yet.</p>

    <div class="flex gap-2 items-center mt-3">
      <input class="input input-sm w-28 sm:w-40 font-mono"
             placeholder="new entry name"
             x-ref="newkey_{{name}}"
             @keydown.enter.prevent="addAttrItem('{{name}}', $refs['newkey_{{name}}'])"
             aria-label="New entry name">
      <button type="button"
              @click="addAttrItem('{{name}}', $refs['newkey_{{name}}'])"
              class="btn btn-ghost btn-sm text-primary shrink-0">
        + Add entry
      </button>
    </div>
    {{/if}}
  </div>
{{else}}
  <div class="space-y-1.5">
    <template x-for="(val, key) in (values['{{name}}'] || {})" :key="key">
      <div class="flex gap-2 items-center"{{#if secret}} x-data="{ reveal: false }"{{/if}}>
        <input class="input input-sm w-28 sm:w-40 font-mono"
               :value="key"
               @change="renameAttrKey('{{name}}', key, $event.target.value)"
               title="Key (rename)"
               aria-label="Key">
        {{#if (or (eq type.elem.kind "int") (eq type.elem.kind "port"))}}
          <input type="number" class="input input-sm flex-1 font-mono"
                 x-model.number="values['{{name}}'][key]"
                 {{#if type.elem.min}}min="{{type.elem.min}}"{{/if}}
                 {{#if type.elem.max}}max="{{type.elem.max}}"{{/if}}>
        {{else}}
          {{#if (eq type.elem.kind "float")}}
            <input type="number" class="input input-sm flex-1 font-mono" step="any"
                   x-model.number="values['{{name}}'][key]">
          {{else}}
            {{#if (eq type.elem.kind "bool")}}
              <label class="label cursor-pointer justify-start gap-2 flex-1">
                <input type="checkbox" class="toggle toggle-primary toggle-sm"
                       x-model="values['{{name}}'][key]">
              </label>
            {{else}}
              <input {{#if secret}}:type="reveal ? 'text' : 'password'" autocomplete="off"{{/if}} class="input input-sm flex-1 font-mono" x-model="values['{{name}}'][key]" aria-label="{{label}}">
              {{#if secret}}
                {{> options/secret_toggle}}
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
        <button type="button"
                @click="removeAttrItem('{{name}}', key)"
                class="btn btn-ghost btn-sm btn-square shrink-0 text-base-content/50 hover:text-error"
                title="Remove" aria-label="Remove">✕</button>
      </div>
    </template>
    <div class="flex gap-2 items-center mt-2">
      <input class="input input-sm w-28 sm:w-40 font-mono" placeholder="key" x-ref="newkey_{{name}}">
      <button type="button" @click="addAttrItem('{{name}}', $refs['newkey_{{name}}'])"
              class="btn btn-ghost btn-sm text-primary shrink-0">+ Add</button>
    </div>
  </div>
{{/if}}
