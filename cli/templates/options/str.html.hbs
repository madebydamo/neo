<div class="mt-1.5 sm:mt-2 flex gap-2 items-center">
  <input type="text" class="input input-primary input-sm flex-1 font-mono"
         x-model="values['{{name}}']"
         placeholder="{{defaultDisplay}}">
  <template x-if="resolveHelper('{{name}}')">
    <button type="button" class="btn btn-outline btn-xs shrink-0"
            @click="runHelper('{{name}}')"
            :disabled="helperBusy"
            x-text="resolveHelper('{{name}}').label"></button>
  </template>
</div>
