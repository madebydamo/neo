{{!-- A settings change the assistant suggests. Buttons save through the
     settings form's write path and apply like the Apply button. Secrets the
     assistant asks for are typed (or generated) in the inputs below and sent
     with the Save click only (static/proposal_card.js). --}}
<div id="proposal-{{id}}" class="neo-proposal rounded-box border border-base-300 bg-base-100 p-3 sm:p-4 space-y-3" data-proposal="{{id}}" data-status="{{status}}" data-services="{{#each changes}}{{service}} {{/each}}">
  {{#if found}}
    <div class="flex items-start gap-2">
      <span class="badge badge-sm {{#if done}}badge-success badge-soft{{else}}badge-primary badge-soft{{/if}} shrink-0 mt-0.5">Suggested change</span>
      <p class="text-sm font-medium leading-snug min-w-0">{{summary}}</p>
    </div>

    <ul class="divide-y divide-base-300/70 text-sm">
      {{#each changes}}
        <li class="py-2 space-y-1.5">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-3 gap-y-0.5">
            <span class="min-w-0 sm:w-2/5">
              <a href="/configuration/option/{{service}}" hx-get="/configuration/option/{{service}}" hx-target="#config-content" hx-swap="innerHTML" hx-push-url="true"
                 class="font-mono text-xs text-base-content/60 link link-hover">{{service}}</a>
              <span class="flex flex-wrap items-baseline gap-1.5">
                {{#if (eq action "add")}}<span class="badge badge-xs badge-success badge-soft">New</span>{{/if}}
                {{#if (eq action "set")}}<span class="badge badge-xs badge-info badge-soft">Set</span>{{/if}}
                {{#if (eq action "change")}}<span class="badge badge-xs badge-info badge-soft">Change</span>{{/if}}
                {{#if (eq action "remove")}}<span class="badge badge-xs badge-warning">Remove</span>{{/if}}
                {{#if (eq action "reset")}}<span class="badge badge-xs badge-ghost">Reset</span>{{/if}}
                <span class="font-medium break-words">{{label}}</span>
              </span>
            </span>
            <span class="min-w-0 flex-1 flex flex-wrap items-baseline gap-1.5 break-all">
              <span class="text-base-content/55 {{#unless (eq old "not set")}}line-through decoration-base-content/30{{/unless}}">{{old}}</span>
              <span aria-hidden="true" class="text-base-content/40">→</span>
              <span class="font-medium {{#if secret}}italic{{/if}} {{#if (eq action "remove")}}text-warning{{/if}}">{{new}}</span>
            </span>
          </div>
          {{#each warnings}}
            <p role="alert" class="flex items-center gap-1.5 text-xs font-medium rounded-box px-2 py-1 bg-warning/15 border border-warning/50 text-base-content">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-3.5 h-3.5 shrink-0 text-warning" aria-hidden="true"><path d="M12 8v5M12 16.5v.01"/><path d="M10.3 3.9L2.6 17.5A2 2 0 004.3 20.5h15.4a2 2 0 001.7-3l-7.7-13.6a2 2 0 00-3.4 0z" stroke-linejoin="round"/></svg>
              {{this}}
            </p>
          {{/each}}
          {{#if notes}}
            <p class="text-xs text-base-content/60">{{#each notes}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>
          {{/if}}
        </li>
      {{/each}}
    </ul>

    {{#if pending}}
      {{#each asks}}
        <div class="rounded-box border border-base-300 bg-base-200/50 p-2.5 space-y-1.5">
          <label class="text-sm font-medium block" for="proposal-{{../id}}-{{name}}">{{label}}</label>
          {{#if used_for}}
            <p class="text-xs text-base-content/60">Used for {{#each used_for}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
          {{/if}}
          <div class="join w-full">
            <input id="proposal-{{../id}}-{{name}}" type="password" name="{{name}}" data-neo-ask autocomplete="new-password" spellcheck="false"
                   class="input input-sm join-item flex-1 min-w-0 font-mono" placeholder="Type it or click Generate">
            <button type="button" class="btn btn-sm join-item" data-neo-ask-toggle="{{name}}" aria-label="Show or hide">Show</button>
            <button type="button" class="btn btn-sm join-item" data-neo-ask-generate="{{name}}">Generate</button>
          </div>
        </div>
      {{/each}}
      {{#if asks}}
        <p class="text-xs text-base-content/60" data-neo-ask-hint>Enter or generate the value above, then save. It goes straight into your settings; the assistant never sees it.</p>
      {{/if}}
    {{/if}}

    {{#if message}}
      <div role="status" class="text-xs rounded-box px-3 py-2 border text-base-content {{#if done}}bg-success/10 border-success/30{{else}}bg-warning/10 border-warning/40{{/if}}">{{message}}</div>
    {{/if}}

    {{#if pending}}
      {{#if other_pending}}
        <p class="text-xs text-base-content/60">There are other saved changes that are not applied yet. Save &amp; apply applies them too.</p>
      {{/if}}
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm btn-primary"
                hx-post="/proposals/{{id}}/apply" hx-target="#proposal-{{id}}" hx-swap="outerHTML"
                hx-include="#proposal-{{id}} [data-neo-ask]" data-neo-ask-save
                data-neo-lock="system"
                hx-on::after-request="NeoOpMonitor.changesAfterRequest(event, 'Activation', true)">
          Save &amp; apply
        </button>
        <button type="button" class="btn btn-sm"
                hx-post="/proposals/{{id}}/save" hx-target="#proposal-{{id}}" hx-swap="outerHTML"
                hx-include="#proposal-{{id}} [data-neo-ask]" data-neo-ask-save
                data-neo-lock="system:sh">Save</button>
        <button type="button" class="btn btn-sm btn-ghost"
                hx-post="/proposals/{{id}}/reject" hx-target="#proposal-{{id}}" hx-swap="outerHTML">Reject</button>
      </div>
    {{/if}}
  {{else}}
    <p class="text-sm text-base-content/60">This suggestion has expired. Ask the assistant again.</p>
  {{/if}}
</div>
