{{!-- Settings tab: system-wide option sections + SSH key + settings.toml backup + power. --}}
<div id="core-grid" class="space-y-6 sm:space-y-8">
  <div>
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">Settings</h2>
    <p class="text-sm text-base-content/60 mt-0.5">System-wide configuration for this homeserver.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-2 sm:gap-3">
    {{#> partials/core_card url="/configuration/core/core" title="System" slug="core" tone="bg-primary/10 text-primary" summary="Hostname, time zone, SSH access, plugins, volumes and Nix builders."}}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="6" rx="1.5"/><rect x="3.5" y="13.5" width="17" height="6" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01" stroke-linecap="round" stroke-width="2.4"/></svg>
    {{/partials/core_card}}

    {{#> partials/core_card url="/configuration/core/neo-cli" title="Neo CLI" slug="neo-cli" tone="bg-secondary/10 text-secondary" summary="Config repository, template, git identity and activation branches."}}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M7 10l3 2.5L7 15M12.5 15h4.5"/></svg>
    {{/partials/core_card}}

    {{#> partials/core_card url="/configuration/core/disko" title="Disks" slug="disko" tone="bg-accent/10 text-accent" summary="Main disk, extra disks and ZFS pool layout."}}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5" aria-hidden="true"><ellipse cx="12" cy="6.5" rx="7.5" ry="2.8"/><path d="M4.5 6.5v11c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-11M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/></svg>
    {{/partials/core_card}}
  </div>

  <div class="space-y-3">
    {{> partials/section_heading title="Access & backup"}}

    <div hx-get="/ssh/homeserver/public-key-card" hx-trigger="load" hx-swap="innerHTML">
      <div class="rounded-box border border-base-300 bg-base-100 p-4 text-xs text-base-content/50 flex items-center gap-2">
        <span class="loading loading-spinner loading-xs"></span> Loading SSH public key…
      </div>
    </div>
    <div hx-get="/ssh/git/public-key-card" hx-trigger="load" hx-swap="innerHTML">
      <div class="rounded-box border border-base-300 bg-base-100 p-4 text-xs text-base-content/50 flex items-center gap-2">
        <span class="loading loading-spinner loading-xs"></span> Loading git SSH public key…
      </div>
    </div>
    <div hx-get="/secrets/card" hx-trigger="load" hx-swap="outerHTML">
      <div class="rounded-box border border-base-300 bg-base-100 p-4 text-xs text-base-content/50 flex items-center gap-2">
        <span class="loading loading-spinner loading-xs"></span> Loading secrets…
      </div>
    </div>

    <div id="settings-toml-card" class="rounded-box border border-base-300 bg-base-100 p-4">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="w-9 h-9 shrink-0 rounded-xl bg-base-200 text-base-content/70 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M6.5 3.5h7l4 4v12a1 1 0 01-1 1h-10a1 1 0 01-1-1v-15a1 1 0 011-1z"/><path d="M13.5 3.5v4h4M9 12.5h6M9 16h4" stroke-linecap="round"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm font-mono">settings.toml</div>
          <div class="text-xs text-base-content/60">Download a backup or replace the working-tree file. Contains secrets. Activate afterwards to apply.</div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" class="btn btn-sm btn-ghost" onclick="neoDownloadSettingsToml()">Download</button>
          <label class="btn btn-sm btn-soft btn-primary">
            Upload…
            <input type="file" accept=".toml,text/plain,application/toml" class="hidden"
              aria-label="Upload settings.toml"
              onchange="neoUploadSettingsToml(this)" />
          </label>
        </div>
      </div>
      <div id="settings-toml-status" class="mt-3 empty:hidden"></div>
    </div>
  </div>
  <div class="space-y-3">
    {{> partials/section_heading title="Power"}}

    <div id="power-card" class="rounded-box border border-base-300 bg-base-100 p-4">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="w-9 h-9 shrink-0 rounded-xl bg-base-200 text-base-content/70 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-5 h-5" aria-hidden="true"><path d="M12 3.5v8"/><path d="M7.2 6.6a7.5 7.5 0 109.6 0"/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm">Restart or shut down</div>
          <div class="text-xs text-base-content/60">Restart boots the current boot default (see Versioning to boot another generation). All services are down meanwhile.</div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" class="btn btn-sm btn-ghost" data-neo-lock="system"
                  hx-post="/system/reboot" hx-target="#power-status" hx-swap="innerHTML"
                  hx-confirm="Restart the server now? All services are down until it is back.">Restart</button>
          <button type="button" class="btn btn-sm btn-soft btn-error" data-neo-lock="system"
                  hx-post="/system/poweroff" hx-target="#power-status" hx-swap="innerHTML"
                  hx-confirm="Shut down the server now? It stays off until it is powered on again — this web UI cannot turn it back on.">Shut down</button>
        </div>
      </div>
      <div id="power-status" class="mt-3 empty:hidden"></div>
    </div>
  </div>
</div>
