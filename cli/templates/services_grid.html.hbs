{{!-- Services tab: search + status / category / source filters over category
     sections of service cards. Filter state lives in servicesGrid()
     (configuration.js); cards carry data-* for matching. --}}
<div id="services-grid" class="space-y-5 sm:space-y-6" x-data="servicesGrid()" @keydown.window="onKey($event)">
  {{> partials/resources_panel}}

  {{#if error}}
    <div role="alert" class="alert alert-error alert-soft text-sm items-start">
      <div class="min-w-0 flex-1">
        <div class="text-xs whitespace-pre-wrap break-words font-mono">{{error}}</div>
        <div class="mt-3 flex flex-wrap gap-2">
          {{#if can_store_repair}}
            <button type="button"
                    class="btn btn-sm btn-warning"
                    hx-post="/nix/repair" data-neo-lock="system"
                    hx-target="#changes-body"
                    hx-swap="innerHTML"
                    hx-confirm="Run sudo nix-store --verify --repair?"
                    hx-on::after-request="if(!event.detail.successful)return;var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Nix store repair';m.showModal();}">
              Repair Nix store
            </button>
          {{/if}}
          {{#if can_flake_update}}
            <button type="button"
                    class="btn btn-sm btn-info"
                    hx-post="/flake/update" data-neo-lock="system"
                    hx-target="#changes-body"
                    hx-swap="innerHTML"
                    hx-confirm="Run flake update + template refresh?"
                    hx-on::after-request="if(!event.detail.successful)return;var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Update';m.showModal();}">
              Update flake inputs
            </button>
          {{/if}}
          <button class="btn btn-sm btn-ghost" onclick="location.reload()">Reload</button>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if groups}}
  {{!-- Toolbar --}}
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
      <div class="min-w-0 flex-1">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">Services</h2>
        <p class="text-sm text-base-content/60 mt-0.5" x-cloak>
          <span x-text="counts.installed"></span> installed · <span x-text="counts.available"></span> available
        </p>
      </div>
      <label class="input input-sm sm:input-md w-full sm:w-80 neo-search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 opacity-50 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.45 4.39l3.08 3.08a.75.75 0 11-1.06 1.06l-3.08-3.08A7 7 0 012 9z" clip-rule="evenodd"/></svg>
        <input type="search"
               x-ref="search"
               x-model="q"
               @keydown.escape.prevent="q = ''; $el.blur()"
               class="grow"
               placeholder="Search services"
               aria-label="Search services"
               autocomplete="off">
        <kbd class="kbd kbd-sm neo-kbd-hint hidden sm:inline-flex" x-show="!q">/</kbd>
      </label>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div role="tablist" class="tabs tabs-box tabs-sm flex-nowrap" aria-label="Install status">
        <button type="button" role="tab" class="tab gap-1.5" :class="{ 'tab-active': status === 'all' }" @click="status = 'all'">
          All <span class="badge badge-ghost badge-xs tabular-nums" x-text="tabCount('all')"></span>
        </button>
        <button type="button" role="tab" class="tab gap-1.5" :class="{ 'tab-active': status === 'installed' }" @click="status = 'installed'">
          Installed <span class="badge badge-ghost badge-xs tabular-nums" x-text="tabCount('installed')"></span>
        </button>
        <button type="button" role="tab" class="tab gap-1.5" :class="{ 'tab-active': status === 'available' }" @click="status = 'available'">
          Available <span class="badge badge-ghost badge-xs tabular-nums" x-text="tabCount('available')"></span>
        </button>
      </div>
      {{#if plugin_filters}}
        <select class="select select-sm w-auto min-w-[9rem] sm:ml-auto"
                x-model="plugin"
                aria-label="Filter by source">
          <option value="all">All sources</option>
          <option value="core" x-show="pluginAvailable('core')" :disabled="!pluginAvailable('core')">Core</option>
          {{#each plugin_filters}}
          <option value="{{id}}" x-show="pluginAvailable($el.value)" :disabled="!pluginAvailable($el.value)">{{display}}</option>
          {{/each}}
        </select>
      {{/if}}
    </div>

    {{#if (gt (len categories) 1)}}
      <div class="flex gap-1.5 neo-scroll-x -mx-1 px-1 pb-0.5" aria-label="Filter by category">
        <button type="button"
                class="btn btn-xs sm:btn-sm rounded-full shrink-0 font-normal"
                :class="category === 'all' ? 'btn-neutral' : 'btn-ghost bg-base-100 border-base-300'"
                @click="category = 'all'">All categories</button>
        {{#each categories}}
          <button type="button"
                  class="btn btn-xs sm:btn-sm rounded-full shrink-0 font-normal"
                  data-cat="{{this}}"
                  x-show="categoryAvailable($el.dataset.cat)"
                  :class="category === $el.dataset.cat ? 'btn-neutral' : 'btn-ghost bg-base-100 border-base-300'"
                  @click="category = category === $el.dataset.cat ? 'all' : $el.dataset.cat">{{this}}</button>
        {{/each}}
      </div>
    {{/if}}
  </div>

  {{#each groups}}
  <section class="space-y-2.5" data-cat="{{name}}" x-show="sectionVisible($el)">
    <div class="flex items-center gap-2.5 px-0.5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/55">{{name}}</h3>
      <span class="text-xs text-base-content/40 tabular-nums" x-text="visibleCount($el.closest('section'))"></span>
      <div class="flex-1 h-px bg-base-content/10" aria-hidden="true"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2 sm:gap-3">
      {{#each services}}
      <button type="button"
              class="group relative flex items-start gap-3 rounded-box border border-base-300 bg-base-100 p-3 text-left cursor-pointer transition-[border-color,box-shadow,transform] hover:border-primary/50 hover:shadow-md active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-primary"
              data-svc
              data-enabled="{{#if enabled}}true{{else}}false{{/if}}"
              data-cat="{{category}}"
              data-plugin-ids="{{#each plugins}}{{id}}{{#unless @last}}|{{/unless}}{{/each}}"
              data-search="{{name}} {{category}}{{#each plugins}} {{display}}{{/each}} {{tagline}}{{#each replaces}} {{this}}{{/each}} {{description}}"
              x-show="cardVisible($el)"
              hx-get="/configuration/option/{{name}}"
              hx-target="#config-content"
              hx-swap="innerHTML"
              hx-push-url="true"
              title="Configure {{name}}">
        <span class="relative w-11 h-11 shrink-0 rounded-xl bg-base-200 p-2 flex items-center justify-center{{#unless enabled}} grayscale-[35%] opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition{{/unless}}">
          {{#if icon}}
            <img src="{{icon}}" class="max-w-full max-h-full object-contain" alt="" loading="lazy"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <span class="hidden text-xl leading-none opacity-50">⚙</span>
          {{else}}
            <span class="text-xl leading-none opacity-50">⚙</span>
          {{/if}}
          {{#if enabled}}
            {{!-- Runtime health; painted by service_status.js from one batched
                 POST /status/services for every dot on the page. --}}
            <span class="neo-unit-dot neo-unit-dot--lg absolute -bottom-0.5 -right-0.5 ring-2 ring-base-100"
                  data-service-status="{{name}}"
                  data-units="{{#each units}}{{this}}{{#unless @last}} {{/unless}}{{/each}}"
                  data-timers="{{#each timers}}{{this}}{{#unless @last}} {{/unless}}{{/each}}"
                  role="img"
                  aria-label="{{name}}: checking status"
                  title="{{name}}: checking status"></span>
          {{/if}}
        </span>
        <span class="min-w-0 flex-1">
          <span class="flex items-center gap-2 min-w-0">
            <span class="font-mono text-sm font-semibold truncate">{{name}}</span>
            {{#if enabled}}
              <span class="badge badge-soft badge-success badge-xs shrink-0 ml-auto">Installed</span>
            {{/if}}
          </span>
          {{#if tagline}}
            <span class="mt-0.5 text-xs leading-snug text-base-content/60 line-clamp-2">{{tagline}}</span>
          {{else}}
            <span class="block mt-0.5 text-xs text-base-content/40 italic">No description</span>
          {{/if}}
          {{#if deprecated}}
            <span class="badge badge-ghost badge-xs mt-1.5 mr-1 text-base-content/55" title="Neo no longer supports this app. Open it to see what to use instead.">Deprecated</span>
          {{/if}}
          {{#if license}}{{#unless license.openSource}}
            <span class="badge badge-soft badge-warning badge-xs mt-1.5" title="{{license.note}}">Not fully open source</span>
          {{/unless}}{{/if}}
          {{#if plugins}}
            <span class="flex flex-wrap gap-1 mt-1.5 min-w-0 overflow-hidden">
              {{#each plugins}}
                {{> partials/plugin_pill url=url display=display size="badge-xs"}}
              {{/each}}
            </span>
          {{/if}}
        </span>
      </button>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <div class="flex flex-col items-center text-center gap-2 py-14 rounded-box border border-dashed border-base-content/15"
       x-cloak
       x-show="!anyVisible()">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="w-9 h-9 text-base-content/30" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4M8.5 11h5"/></svg>
    <div class="font-semibold text-sm">No services match</div>
    <p class="text-xs text-base-content/60">Try a different search or clear the filters.</p>
    <button type="button" class="btn btn-sm btn-ghost mt-1" @click="resetFilters()">Clear filters</button>
  </div>
  {{else}}
  {{#unless error}}
    <div class="flex flex-col items-center text-center gap-2 py-14 rounded-box border border-dashed border-base-content/15">
      <div class="font-semibold text-sm">No services found</div>
      <p class="text-xs text-base-content/60">The flake evaluation returned no services.</p>
    </div>
  {{/unless}}
  {{/if}}
</div>
