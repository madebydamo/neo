<div id="services-grid"
     class="space-y-2.5 sm:space-y-4"
     x-data="{
       status: 'all',
       category: 'all',
       plugin: 'all',
       matches(enabled, cat, pluginUrls) {
         const urls = pluginUrls || [];
         const st = this.status === 'all'
           || (this.status === 'installed' && enabled)
           || (this.status === 'available' && !enabled);
         const catOk = this.category === 'all' || this.category === cat;
         const plugOk = this.plugin === 'all'
           || (this.plugin === 'core' && urls.length === 0)
           || urls.indexOf(this.plugin) !== -1;
         return st && catOk && plugOk;
       },
       sectionVisible(cat, hasEn, hasDis, packed) {
         if (this.category !== 'all' && this.category !== cat) return false;
         const tokens = (packed || '').split('|').filter(Boolean);
         if (this.plugin === 'core' && tokens.indexOf('core') === -1) return false;
         if (this.plugin !== 'all' && this.plugin !== 'core' && tokens.indexOf(this.plugin) === -1) return false;
         if (this.status === 'installed') return hasEn;
         if (this.status === 'available') return hasDis;
         return true;
       },
        anyVisible() {
          const els = this.$root.querySelectorAll('[data-plugin-urls]');
          return Array.from(els).some((el) => this.matches(
            el.dataset.enabled === 'true',
            el.dataset.cat,
            (el.dataset.pluginUrls || '').split('|').filter(Boolean)
          ));
        }
     }">
  {{#if error}}
    <div class="alert alert-error text-xs flex flex-col gap-2">
      <span class="whitespace-pre-wrap">{{error}}</span>
      <div class="flex flex-wrap gap-2">
        {{#if can_store_repair}}
          <button type="button"
                  class="btn btn-xs btn-warning"
                  hx-post="/nix/repair"
                  hx-target="#changes-body"
                  hx-swap="innerHTML"
                  hx-confirm="Run sudo nix-store --verify --repair?"
                  hx-on::after-request="var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Nix store repair';m.showModal();}">
            Repair Nix store
          </button>
        {{/if}}
        {{#if can_flake_update}}
          <button type="button"
                  class="btn btn-xs btn-info"
                  hx-post="/flake/update"
                  hx-target="#changes-body"
                  hx-swap="innerHTML"
                  hx-confirm="Run flake update + template refresh?"
                  hx-on::after-request="var m=document.getElementById('changes-modal');if(m){m.querySelector('h3').textContent='Update';m.showModal();}">
            Update flake inputs
          </button>
        {{/if}}
        <button class="btn btn-xs btn-ghost" onclick="location.reload()">Reload</button>
      </div>
    </div>
  {{/if}}

  {{#if groups}}
  {{!-- Filters: install status + category --}}
  <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 py-0.5 sm:py-1.5">
    <div class="join">
      <button type="button"
              class="btn btn-xs join-item"
              :class="status === 'all' ? 'btn-primary' : 'btn-ghost'"
              @click="status = 'all'">All</button>
      <button type="button"
              class="btn btn-xs join-item"
              :class="status === 'installed' ? 'btn-primary' : 'btn-ghost'"
              @click="status = 'installed'">Installed</button>
      <button type="button"
              class="btn btn-xs join-item"
              :class="status === 'available' ? 'btn-primary' : 'btn-ghost'"
              @click="status = 'available'">Available</button>
    </div>
    <select class="select select-xs min-w-[9rem]"
            x-model="category"
            aria-label="Filter by category">
      <option value="all">All categories</option>
      {{#each categories}}
      <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>
    {{#if plugin_filters}}
    <select class="select select-xs min-w-[9rem]"
            x-model="plugin"
            aria-label="Filter by plugin">
      <option value="all">All sources</option>
      <option value="core">Core</option>
      {{#each plugin_filters}}
      <option value="{{url}}">{{display}}</option>
      {{/each}}
    </select>
    {{/if}}
  </div>

  {{#each groups}}
  <section class="space-y-1 sm:space-y-1.5"
           data-cat="{{name}}"
           data-has-en="{{#if hasEnabled}}true{{else}}false{{/if}}"
           data-has-dis="{{#if hasDisabled}}true{{else}}false{{/if}}"
           data-plugin-tokens="{{#each services}}{{#if plugins}}{{#each plugins}}{{url}}|{{/each}}{{else}}core|{{/if}}{{/each}}"
           x-show="sectionVisible($el.dataset.cat, $el.dataset.hasEn === 'true', $el.dataset.hasDis === 'true', $el.dataset.pluginTokens)">
    <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 px-0.5">{{name}}</h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-1.5 sm:gap-2">
      {{#each services}}
      <div class="relative"
           data-enabled="{{#if enabled}}true{{else}}false{{/if}}"
           data-cat="{{category}}"
           data-plugin-urls="{{#each plugins}}{{url}}{{#unless @last}}|{{/unless}}{{/each}}"
           x-show="matches({{#if enabled}}true{{else}}false{{/if}}, '{{category}}', ($el.dataset.pluginUrls || '').split('|').filter(Boolean))">
        {{!-- Main card (navigates to options) --}}
        <div
          class="card bg-base-100 shadow-sm border border-base-300 hover:border-primary hover:shadow-md cursor-pointer transition-all active:scale-[0.985] h-full {{#unless enabled}}opacity-75{{/unless}}"
          hx-get="/configuration/option/{{name}}"
          hx-target="#config-content"
          hx-swap="innerHTML"
          hx-push-url="true"
          title="Configure {{name}}">
          <div class="card-body p-2 sm:p-3 gap-1.5 sm:gap-2 items-center text-center min-h-[6.25rem] sm:min-h-[7.5rem]">
            {{#if plugins}}
              <div class="absolute top-1 left-1 z-10 flex flex-wrap gap-0.5 max-w-[70%] pointer-events-none">
                {{#each plugins}}
                  <span class="badge badge-outline badge-xs font-mono" title="{{url}}">{{display}}</span>
                {{/each}}
              </div>
            {{/if}}
            <div class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0">
              {{#if icon}}
                <img src="{{icon}}" class="max-w-full max-h-full object-contain" alt=""
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <span class="hidden text-2xl sm:text-3xl leading-none opacity-50">⚙</span>
              {{else}}
                <span class="text-2xl sm:text-3xl leading-none opacity-50">⚙</span>
              {{/if}}
            </div>
            <div class="font-mono text-[11px] sm:text-xs font-medium truncate w-full leading-tight">{{name}}</div>
            {{#if enabled}}
              <span class="badge badge-success badge-sm">Installed</span>
            {{else}}
              <span class="badge badge-ghost badge-sm">Available</span>
            {{/if}}
          </div>
        </div>

        {{!-- Info popover (same pattern as option fields); stops click so card does not navigate --}}
        <div class="absolute top-1 right-1 z-10"
             @click.stop
             @mousedown.stop>
          <div class="dropdown dropdown-end dropdown-hover">
            <span tabindex="0" role="button"
                  class="btn btn-ghost btn-xs btn-circle min-h-0 h-6 w-6 text-base-content/40 hover:text-primary leading-none"
                  title="About {{name}}"
                  aria-label="About {{name}}">ⓘ</span>
            <div tabindex="0"
                 class="dropdown-content card card-sm bg-base-100 shadow-lg border border-base-300 z-30 w-72 text-left mt-1">
              <div class="card-body p-3 gap-1.5 text-xs">
                <div class="flex items-center gap-2 min-w-0">
                  {{#if icon}}
                    <img src="{{icon}}" class="w-5 h-5 object-contain flex-shrink-0" alt="" />
                  {{/if}}
                  <span class="font-mono font-semibold truncate">{{name}}</span>
                </div>
                <div class="text-[10px] opacity-60">{{category}} · {{#if enabled}}Installed{{else}}Available{{/if}}{{#each plugins}} · {{display}}{{/each}}</div>
                {{#if description}}
                  <div class="mt-0.5 leading-relaxed text-base-content/80 whitespace-pre-line max-h-48 overflow-y-auto">{{description}}</div>
                {{else}}
                  <div class="opacity-50 italic">No description available.</div>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <div class="text-xs opacity-60 p-4 border border-dashed rounded text-center"
       x-cloak
       x-show="!anyVisible()">
    No services match the current filters.
  </div>
  {{else}}
  {{#unless error}}
    <div class="text-xs opacity-60 p-4 border border-dashed rounded">No services found.</div>
  {{/unless}}
  {{/if}}
</div>
