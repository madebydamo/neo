# CrowdSec for SWAG (services.swag.crowdsec): the CrowdSec engine + local API
# container on the internal network reads SWAG's nginx logs; the swag-crowdsec
# mod (DOCKER_MODS in default.nix) asks it about every visitor.
{...}: {
  flake.modules.nixos.swag-crowdsec = {
    config,
    lib,
    pkgs,
    ...
  }:
    with lib; let
      swag = config.neo.services.swag;
      cfg = swag.crowdsec;
      # Engine state; the mod already uses /config/crowdsec for the bouncer conf.
      engineDir = "${swag.appdata}/crowdsec-engine";
      swagLogs = "${swag.appdata}/log/nginx";
      # The bouncer's API key. Generated on first start, never in Nix;
      # crowdsec-bouncer registers whatever key is there.
      keyFile = "${swag.appdata}/neo/crowdsec-bouncer.env";
    in {
      config = mkIf (swag.enabled && cfg.enabled) {
        systemd.services.docker-crowdsec.preStart = concatStringsSep "\n" [
          (lib.neo.mkEnsureDirs config [
            engineDir
            "${engineDir}/config"
            "${engineDir}/config/acquis.d"
            "${engineDir}/data"
            swagLogs
          ])
          (lib.neo.mkActivationScriptForFile config {
            filePath = "${engineDir}/config/acquis.d/neo-swag.yaml";
            content = ''
              # Generated by neo: SWAG's nginx logs (mounted read-only).
              filenames:
                - /var/log/swag/access.log
                - /var/log/swag/error.log
              labels:
                type: nginx
            '';
          })
        ];

        virtualisation.oci-containers.containers.crowdsec = {
          image = swag.containers.crowdsec;
          environment = {
            TZ = config.neo.core.timeZone;
            COLLECTIONS = concatStringsSep " " cfg.collections;
            DISABLE_ONLINE_API = boolToString (!cfg.community);
          };
          volumes = [
            "${engineDir}/config:/etc/crowdsec"
            "${engineDir}/data:/var/lib/crowdsec/data"
            "${swagLogs}:/var/log/swag:ro"
          ];
          networks = ["internal"];
        };

        virtualisation.oci-containers.containers.swag = {
          environment.CROWDSEC_LAPI_URL = "http://crowdsec:8080";
          # CROWDSEC_API_KEY
          environmentFiles = [keyFile];
        };
        systemd.services.docker-swag.preStart = mkAfter ''
          if [ ! -s ${keyFile} ]; then
            mkdir -p ${dirOf keyFile}
            chmod 0700 ${dirOf keyFile}
            (umask 077; printf 'CROWDSEC_API_KEY=%s\n' "$(${pkgs.openssl}/bin/openssl rand -hex 32)" > ${keyFile})
          fi
        '';

        # (Re)register SWAG's bouncer with the key SWAG runs with, then reload
        # nginx so the bouncer is active (on a first start nginx can come up
        # without it). Runs again whenever either container restarts (Requires=).
        systemd.services.crowdsec-bouncer = lib.neo.mkSetupService {
          inherit pkgs;
          name = "crowdsec-bouncer";
          description = "Register the SWAG bouncer with CrowdSec";
          containers = ["crowdsec" "swag"];
          path = [pkgs.docker pkgs.gnused];
          retryInterval = 10;
          script = ''
            key=$(sed -n 's/^CROWDSEC_API_KEY=//p' ${keyFile})
            [ -n "$key" ]
            docker exec crowdsec cscli bouncers delete swag >/dev/null 2>&1 || true
            # Key on stdin, not in the docker exec command line.
            printf '%s' "$key" | docker exec -i crowdsec sh -c 'cscli bouncers add swag -k "$(cat)" >/dev/null'
            echo "Registered the SWAG bouncer"
            # Fails until SWAG's nginx runs; the retry loop waits for it.
            docker exec swag sh -c 'pgrep -x nginx >/dev/null && nginx -c /config/nginx/nginx.conf -s reload'
            echo "Reloaded nginx"
          '';
        };
      };
    };
}
