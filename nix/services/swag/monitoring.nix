# CrowdSec metrics and dashboard (neo.monitoring.apps.swag,
# nix/modules/core/monitoring.nix), only with services.swag.crowdsec.
#
# The CrowdSec engine serves Prometheus on :6060. The image's config.yaml
# already listens on 0.0.0.0:6060 at level full; config.yaml.local pins that,
# so an old or edited config.yaml in appdata cannot turn the endpoint off. Port
# 6060 is only on SWAG's Docker network (no published port).
#
# Metric names checked against crowdsec v1.8.2 (pkg/metrics):
#   cs_active_decisions{reason, origin, action}  gauge, decisions in the local API
#   cs_alerts{reason, kind}                       gauge, stored alerts (no CAPI)
#   cs_bucket_overflowed_total{name}              scenario fired
#   cs_lapi_decisions_ok_total{bouncer}           bouncer check found a ban
#   cs_lapi_decisions_ko_total{bouncer}           bouncer check found nothing
#   cs_lapi_bouncer_requests_total{bouncer, route, method}
#   cs_filesource_hits_total{source}              log lines read per file
#   cs_parser_hits_{ok,ko}_total{source, type}    lines parsed / not parsed
#   cs_capi_last_pull_timestamp                   last community blocklist pull (0 = never)
#   cs_capi_errors_total{operation}
# cs_node_* (one series per parser node) are dropped: noise for a dashboard.
{...}: {
  flake.modules.nixos.swag-monitoring = {
    config,
    lib,
    ...
  }: let
    swag = config.neo.services.swag;
    sel = lib.neo.grafana.appSelector "swag";
    engineDir = "${swag.appdata}/crowdsec-engine";
    # Decisions that come from outside: the community blocklist (CAPI) and
    # subscribed blocklists (lists). Everything else this server decided.
    community = ''origin=~"CAPI|lists"'';
    local = ''origin!~"CAPI|lists"'';
  in {
    config = lib.mkIf (swag.enabled && swag.crowdsec.enabled) {
      # After crowdsec.nix's directory setup in the same preStart.
      systemd.services.docker-crowdsec.preStart = lib.mkAfter (lib.neo.mkActivationScriptForFile config {
        filePath = "${engineDir}/config/config.yaml.local";
        content = ''
          # Generated by neo: Prometheus metrics for the monitoring agent.
          prometheus:
            enabled: true
            level: full
            listen_addr: 0.0.0.0
            listen_port: 6060
        '';
      });

      neo.monitoring.apps.swag = {
        metrics.crowdsec = {
          container = "crowdsec";
          port = 6060;
          relabel = [
            {
              action = "drop";
              regex = "cs_node_.*";
            }
          ];
        };

        dashboards.crowdsec = {
          title = "CrowdSec";
          description = "Attackers CrowdSec banned, the attacks it detected in SWAG's logs, the community blocklist and how SWAG checks visitors.";
          time = "now-7d";
          panels = with lib.neo.grafana; [
            (row "Overview" null)
            (stat {
              title = "Running";
              w = 4;
              h = 4;
              description = "The CrowdSec engine answers.";
              targets = [(pq "min(up{${sel}, scrape=\"crowdsec\"})" "")];
              mappings = upDown;
              thresholds = {
                mode = "absolute";
                steps = [
                  {
                    color = "red";
                    value = null;
                  }
                  {
                    color = "green";
                    value = 1;
                  }
                ];
              };
            })
            (stat {
              title = "Banned by this server";
              w = 4;
              h = 4;
              description = "Addresses banned right now because they attacked this server (or were banned by hand).";
              targets = [(pq "sum(cs_active_decisions{${sel}, ${local}}) or vector(0)" "")];
              options.colorMode = "value";
              thresholds = thresholdsGreenRed [];
            })
            (stat {
              title = "Community blocklist";
              w = 4;
              h = 4;
              description = "Known attackers from the CrowdSec community that are blocked too. 0 while Community blocklist is off.";
              targets = [(pq "sum(cs_active_decisions{${sel}, ${community}}) or vector(0)" "")];
              options.colorMode = "value";
              thresholds = thresholdsGreenRed [];
            })
            (stat {
              title = "Attacks detected";
              w = 4;
              h = 4;
              description = "Times a detection rule fired in the selected time range.";
              targets = [(pq "round(sum(increase(cs_bucket_overflowed_total{${sel}}[$__range]))) or vector(0)" "")];
              options.colorMode = "value";
              thresholds = thresholdsGreenRed [];
            })
            (stat {
              title = "Visitors turned away";
              w = 4;
              h = 4;
              description = "Times SWAG asked CrowdSec about a visitor and the visitor was banned, in the selected time range.";
              targets = [(pq "round(sum(increase(cs_lapi_decisions_ok_total{${sel}}[$__range]))) or vector(0)" "")];
              options.colorMode = "value";
              thresholds = thresholdsGreenRed [];
            })
            (stat {
              title = "Blocklist last updated";
              w = 4;
              h = 4;
              description = "Time since the community blocklist was last fetched (normally every two hours). Empty while Community blocklist is off.";
              targets = [(pq "time() - max(cs_capi_last_pull_timestamp{${sel}} > 0)" "")];
              unit = "s";
              thresholds = thresholdsGreenRed [
                {
                  color = "orange";
                  value = 6 * 3600;
                }
                {
                  color = "red";
                  value = 24 * 3600;
                }
              ];
            })

            (row "Bans" null)
            (timeseries {
              title = "Active bans by origin";
              description = "crowdsec: seen attacking this server. cscli: added by hand. CAPI and lists: community blocklists.";
              targets = [(pq "sum by (origin) (cs_active_decisions{${sel}})" "{{origin}}")];
            })
            (bargauge {
              title = "Bans by this server, by reason";
              description = "Why the addresses this server banned itself are banned right now.";
              targets = [(pq "sort_desc(sum by (reason) (cs_active_decisions{${sel}, ${local}}))" "{{reason}}")];
              thresholds = thresholdsGreenRed [];
            })
            (bargauge {
              title = "Community blocklist by reason";
              description = "The 15 biggest groups of attackers on the community blocklist.";
              targets = [(pq "topk(15, sum by (reason) (cs_active_decisions{${sel}, ${community}}))" "{{reason}}")];
              thresholds = thresholdsGreenRed [];
            })
            (bargauge {
              title = "Alerts by reason";
              description = "Attacks on this server that CrowdSec still remembers (it keeps alerts for 7 days).";
              targets = [(pq "sort_desc(sum by (reason) (cs_alerts{${sel}}))" "{{reason}}")];
              thresholds = thresholdsGreenRed [];
            })

            (row "Detection" null)
            (bars {
              title = "Attacks detected per rule";
              description = "Each bar is a detection rule (scenario) that fired, for example a scan or password guessing.";
              targets = [(pq "sum by (name) (increase(cs_bucket_overflowed_total{${sel}}[$__interval]))" "{{name}}")];
            })
            (bargauge {
              title = "Rules fired most";
              description = "Detection rules that fired in the selected time range.";
              targets = [(pq "sort_desc(round(sum by (name) (increase(cs_bucket_overflowed_total{${sel}}[$__range])) > 0))" "{{name}}")];
              thresholds = thresholdsGreenRed [];
            })

            (row "SWAG and the community" null)
            (bars {
              title = "Visitor checks by SWAG";
              description = "SWAG asks CrowdSec about each new visitor address. Turned away: the address is banned.";
              targets = [
                (pq "sum(increase(cs_lapi_decisions_ko_total{${sel}}[$__interval]))" "allowed")
                (pq "sum(increase(cs_lapi_decisions_ok_total{${sel}}[$__interval]))" "turned away")
              ];
            })
            (bars {
              title = "Community blocklist errors";
              description = "Failed exchanges with the CrowdSec community service: pull (fetch the blocklist), push (share attackers), metrics.";
              targets = [(pq "sum by (operation) (increase(cs_capi_errors_total{${sel}}[$__interval]))" "{{operation}}")];
            })

            (row "Reading SWAG's logs" null)
            (timeseries {
              title = "Log lines read";
              description = "Lines CrowdSec reads from SWAG's web server logs.";
              targets = [(pq "sum by (source) (rate(cs_filesource_hits_total{${sel}}[$__rate_interval]))" "{{source}}")];
              unit = "short";
            })
            (timeseries {
              title = "Log lines understood";
              description = "Lines CrowdSec could read (understood) or could not make sense of (not understood). Many not understood lines in the error log are normal.";
              targets = [
                (pq "sum by (source) (rate(cs_parser_hits_ok_total{${sel}}[$__rate_interval]))" "{{source}} understood")
                (pq "sum by (source) (rate(cs_parser_hits_ko_total{${sel}}[$__rate_interval]))" "{{source}} not understood")
              ];
              unit = "short";
            })

            (row "Container" null)
            (timeseries {
              title = "Processor";
              targets = [(pq ''sum by (name) (rate(container_cpu_usage_seconds_total{host=~"$host", name="crowdsec"}[$__rate_interval]))'' "{{name}}")];
              unit = "percentunit";
            })
            (timeseries {
              title = "Memory";
              targets = [(pq ''sum by (name) (container_memory_working_set_bytes{host=~"$host", name="crowdsec"})'' "{{name}}")];
              unit = "bytes";
            })
            (logs {
              title = "Errors and warnings";
              w = 24;
              h = 10;
              targets = [(lq ''{job="journal", host=~"$host", unit=~"docker-crowdsec.service|crowdsec-bouncer.service"} |~ "(?i)(level=(error|warning|fatal)|error|fail)"'')];
            })
          ];
        };
      };
    };
  };
}
